#!/usr/bin/env bash
# tools/microcode-check/run [CHECK...] [-- LISPM-CHECK-ARGS...]: the microcode's
# checks (tools/microcode-check/README.md).  Each CHECK runs cases/CHECK.cases
# through tools/lispm-check, with lisp/CHECK.lisp loaded first when there is
# one; with no CHECK, every case file runs.  Arguments after -- go to every
# lispm-check run (--band, --ubin, --engine and so on).  Exit status 0 when
# every check passes, else the first failing run's status.  A case file whose
# first line is "; lisp: A.lisp,B.lisp" has those files of lisp/ loaded
# instead.  The checks of
# cases-2mw/ want a machine of 2 M words of main memory and run only when
# named (README.md).
here=$(cd "$(dirname "$0")" && pwd)
tool=$here/../lispm-check
checks=() args=()
while [ $# -gt 0 ]; do
    [ "$1" = -- ] && { shift; args=("$@"); break; }
    checks+=("$1"); shift
done
if [ ${#checks[@]} -eq 0 ]; then
    for f in "$here"/cases/*.cases; do checks+=("$(basename "$f" .cases)"); done
fi
status=0
for c in "${checks[@]}"; do
    cases=$here/cases/$c.cases
    [ -f "$cases" ] || cases=$here/cases-2mw/$c.cases
    [ -f "$cases" ] || { echo "microcode-check: no $here/cases/$c.cases" >&2; exit 2; }
    files=()
    [ -f "$here/lisp/$c.lisp" ] && files=(--files "$here/lisp/$c.lisp")
    # or the files its first line names, "; lisp: A.lisp,B.lisp", which
    # several checks share (as tools/system-check/run takes one)
    lisp=$(sed -n '1s/^; lisp: \(.*\)$/\1/p' "$cases")
    [ -n "$lisp" ] && files=(--files "$(echo "$lisp" | sed "s|\([^,]*\)|$here/lisp/\1|g")")
    echo "##### $c"
    python3 "$tool" "${files[@]}" "${args[@]}" "$cases"
    s=$?
    [ $s -ne 0 ] && [ $status -eq 0 ] && status=$s
done
exit $status
