#!/usr/bin/env bash
# tools/microcode-check/run [CHECK...] [-- LISPM-CHECK-ARGS...]: the microcode's
# checks (tools/microcode-check/README.md).  Each CHECK runs cases/CHECK.cases
# through tools/lispm-check, with lisp/CHECK.lisp loaded first when there is
# one; with no CHECK, every case file runs.  Arguments after -- go to every
# lispm-check run (--band, --ubin, --engine and so on).  Exit status 0 when
# every check passes, else the first failing run's status.  A case file whose
# first line is "; lisp: A.lisp,B.lisp" has those files of lisp/ loaded
# instead.  The checks of
# cases-2mw/ want a machine of 2 M words of main memory and run only when
# named (README.md).
# The checks of cases-16/ want revision 16, with ethernet-peer behind its
# Ethernet device, and also run only when named (README.md).
# The checks of cases-15/ wanted revision 15 and ran only when named, each
# skipped on another revision: network-stray, whose Chaosnet interface is gone
# from revision 16 (QUUX's Ethernet contract, section 8, step R4).  They left
# with revisions 13-15, and so did the probe of the machine's revision below;
# no machine raises word 100 <6>.
here=$(cd "$(dirname "$0")" && pwd)
tool=$here/../lispm-check
checks=() args=()
while [ $# -gt 0 ]; do
    [ "$1" = -- ] && { shift; args=("$@"); break; }
    checks+=("$1"); shift
done
if [ ${#checks[@]} -eq 0 ]; then
    for f in "$here"/cases/*.cases; do checks+=("$(basename "$f" .cases)"); done
fi
status=0
for c in "${checks[@]}"; do
    cases=$here/cases/$c.cases
    [ -f "$cases" ] || cases=$here/cases-2mw/$c.cases
    [ -f "$cases" ] || cases=$here/cases-16/$c.cases
    # [ -f "$cases" ] || cases=$here/cases-15/$c.cases
    [ -f "$cases" ] || { echo "microcode-check: no $here/cases/$c.cases" >&2; exit 2; }
    files=()
    [ -f "$here/lisp/$c.lisp" ] && files=(--files "$here/lisp/$c.lisp")
    # or the files its first line names, "; lisp: A.lisp,B.lisp", which
    # several checks share (as tools/system-check/run takes one)
    lisp=$(sed -n '1s/^; lisp: \(.*\)$/\1/p' "$cases")
    [ -n "$lisp" ] && files=(--files "$(echo "$lisp" | sed "s|\([^,]*\)|$here/lisp/\1|g")")
    echo "##### $c"
    # A check of cases-15/ on another revision was skipped, in one line: the
    # machine, --quux or lispm-check's default, was asked its revision as
    # lispm-check's machine_revision asks it, by its start's line.
    # if [ "$cases" = "$here/cases-15/$c.cases" ]; then
    #     exe=${LISPM_CHECK_QUUX:-$here/../../../muir-sim/target/release/quux}
    #     for ((i = 0; i + 1 < ${#args[@]}; i++)); do
    #         [ "${args[i]}" = --quux ] && exe=${args[i+1]}
    #     done
    #     rev=$("$exe" -c /dev/null --stop-after 1 --terminal 127.0.0.1:0 < /dev/null 2>&1 |
    #         sed -n 's/.*machine: quux, revision \([0-9]*\).*/\1/p; s/.*QUUX revision \([0-9]*\) has.*/\1/p' | head -n 1)
    #     if [ "$rev" != 15 ]; then
    #         echo "microcode-check: $c skipped: it wants revision 15, and $exe runs ${rev:+revision }${rev:-no revision it names}"
    #         continue
    #     fi
    # fi
    python3 "$tool" "${files[@]}" "${args[@]}" "$cases"
    s=$?
    [ $s -ne 0 ] && [ $status -eq 0 ] && status=$s
done
exit $status
