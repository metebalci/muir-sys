; A reference to an address with <31:28> set, past the 28-bit space (contract
; G2 section 2.6), signals ADDRESS-PAST-28-BITS (sys/eh/ehf.lisp), with the
; address, a locative, and the machine goes on; the microcode halted at
; ADDRESS-PAST-28-BITS (sys/ucadr/uc-page-fault.lisp).  A 32-bit pointer
; field can hold such an address.  Holding, storing or saving such a pointer is
; harmless: the garbage collector's tests take it as neither oldspace nor extra
; PDL (TRANS-OLD, EXTRA-PDL-TRAP-1, sys/ucadr/uc-transporter.lisp), so a process
; switch with it on the stack and a full GC with it in a variable pass.  Each
; case catches the error by its name; the first is a control, a reference
; inside the space.  A machine that halts answers none after it.
(let ((x (list 1 2))) (%p-contents-offset (%make-pointer dtp-locative (%pointer x)) 0)) => 1
(condition-case (e) (%p-contents-offset (%make-pointer dtp-locative -1) 0) (error (list (if (cli:member "ADDRESS-PAST-28-BITS" (mapcar #'string (send e :condition-names)) :test #'string=) :past (send e :condition-names)) (%pointer (cadr (memq ':address (send e :property-list))))))) => (:PAST -1)
(condition-case (e) (%p-store-contents (%make-pointer dtp-locative #o2000000000) 5) (error (if (cli:member "ADDRESS-PAST-28-BITS" (mapcar #'string (send e :condition-names)) :test #'string=) :past (send e :condition-names)))) => :PAST
(condition-case (e) (%p-ldb #o0020 (%make-pointer dtp-locative #o-20000000000)) (error (if (cli:member "ADDRESS-PAST-28-BITS" (mapcar #'string (send e :condition-names)) :test #'string=) :past (send e :condition-names)))) => :PAST
(condition-case (e) (format nil "~A" (%p-contents-offset (%make-pointer dtp-locative -1) 0)) (error (send e :report-string))) => "There was a reference to #<DTP-LOCATIVE -1>, which is past the 28-bit address space."
; the transporter's map-bits path: a word of all ones, followed as a locative
(let ((a (make-array 2))) (%p-store-tag-and-pointer (%make-pointer-offset dtp-locative a 1) #o377 -1) (condition-case (e) (%p-contents-as-locative (%make-pointer-offset dtp-locative a 1)) (error (if (cli:member "ADDRESS-PAST-28-BITS" (mapcar #'string (send e :condition-names)) :test #'string=) :past (send e :condition-names))))) => :PAST
; holding one across a process switch, and storing one and collecting
(let ((p (%make-pointer dtp-locative -1))) (process-sleep 60) (%pointer p)) => -1
(let ((p (%make-pointer dtp-list -1))) (process-sleep 60) (condition-case (e) (car p) (error (if (cli:member "ADDRESS-PAST-28-BITS" (mapcar #'string (send e :condition-names)) :test #'string=) :past (send e :condition-names))))) => :PAST
(progn (defvar *ap28-p* nil) (setq *ap28-p* (%make-pointer dtp-locative -1)) (%pointer *ap28-p*)) => -1
(progn (si:full-gc) (%pointer *ap28-p*)) => -1
(+ 1 2) => 3
