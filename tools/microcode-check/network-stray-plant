#!/usr/bin/env python3
"""tools/microcode-check/network-stray-plant UBIN OUT: a planted control for the
check network-stray (README.md): OUT, a Lisp file that, loaded, writes the
control store word at INTR-NETWORK-STRAY+3, its (jump intrx1), over
INTR-NETWORK-STRAY's first word in the running machine (COMPILER::MA-LOAD-C-MEM),
so that the stray dismisses the interrupt without writing the CSR: microcode
without the stray, made from UBIN's ucadr.mcr (revision 15's format) and
ucadr.sym, which must be the microcode the band runs.  Give OUT after
lisp/network-stray.lisp in --files; three cases then fail, the enables kept
and word 100 <6> up.  Not for any band in use."""
import importlib.machinery, importlib.util, os, sys
sys.dont_write_bytecode = True
if len(sys.argv) != 3:
    sys.exit(__doc__)
here = os.path.dirname(os.path.abspath(__file__))
loader = importlib.machinery.SourceFileLoader('assembler_check', os.path.join(here, '..', 'assembler-check', 'run'))
spec = importlib.util.spec_from_loader('assembler_check', loader)
m = importlib.util.module_from_spec(spec)
loader.exec_module(m)
ub, out = sys.argv[1:]
start, words = m.parse_15(open(os.path.join(ub, 'ucadr.mcr'), 'rb').read())[1]
a = m.sym_table(os.path.join(ub, 'ucadr.sym'))['INTR-NETWORK-STRAY'][1]
jump = words[a + 3 - start]
if m.ir(jump, 43, 2) != 1:
    sys.exit('network-stray-plant: INTR-NETWORK-STRAY+3 (%o) is no jump' % (a + 3))
with open(out, 'w') as f:
    f.write(';;; -*- Mode:LISP; Package:USER; Base:10 -*-\n'
            ';;; Written by tools/microcode-check/network-stray-plant: INTR-NETWORK-STRAY (%o)\n'
            ';;; made its +3, (jump intrx1), %o, in the running control store.  Not for any band in use.\n'
            '(compiler::ma-load-c-mem #o%o #o%o)\n' % (a, jump, a, jump))
print('INTR-NETWORK-STRAY %o made %o' % (a, jump))
