#!/usr/bin/env bash
# tools/system-check/run [CHECK...] [-- LISPM-CHECK-ARGS...]: the system's
# checks (tools/system-check/README.md).  Each CHECK runs cases/CHECK.cases
# through tools/lispm-check, with lisp/CHECK.lisp loaded first when there is
# one; with no CHECK, every case file runs.  Arguments after -- go to every
# lispm-check run (--band, --ubin, --engine and so on).  A case file whose
# first line is "; lisp: NAME.lisp" has lisp/NAME.lisp loaded instead, for a
# file several checks share.  Exit status 0 when every check passes, else the
# first failing run's status.  The checks of cases-2mw/ want a machine of 2 M
# words of main memory, and run only when named (README.md).
here=$(cd "$(dirname "$0")" && pwd)
tool=$here/../lispm-check
checks=() args=()
while [ $# -gt 0 ]; do
    [ "$1" = -- ] && { shift; args=("$@"); break; }
    checks+=("$1"); shift
done
if [ ${#checks[@]} -eq 0 ]; then
    for f in "$here"/cases/*.cases; do checks+=("$(basename "$f" .cases)"); done
fi
status=0
for c in "${checks[@]}"; do
    cases=$here/cases/$c.cases
    # a check of cases-2mw/ is found there when named
    [ -f "$cases" ] || cases=$here/cases-2mw/$c.cases
    [ -f "$cases" ] || { echo "system-check: no $here/cases/$c.cases" >&2; exit 2; }
    files=()
    [ -f "$here/lisp/$c.lisp" ] && files=(--files "$here/lisp/$c.lisp")
    # or the file its first line names, "; lisp: NAME.lisp", which several
    # checks share
    lisp=$(sed -n '1s/^; lisp: \(.*\)$/\1/p' "$cases")
    [ -n "$lisp" ] && files=(--files "$here/lisp/$lisp")
    echo "##### $c"
    python3 "$tool" "${files[@]}" "${args[@]}" "$cases"
    s=$?
    [ $s -ne 0 ] && [ $status -eq 0 ] && status=$s
done
exit $status
