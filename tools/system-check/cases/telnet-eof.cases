; The TELNET server closes its side when its client sends EOF
; (sys/network/chaos/chsaux.lisp, ECHOING-STREAM and TELNET-SERVER-EOF;
; lisp/telnet-eof.lisp).  The client is the band itself, over Chaos to its
; own address.  On a band built before the change, compile chsaux.lisp
; first.  Each group opens a connection, reads the banner, ends it one way
; and cleans up.  A result is (CLOSED OPCODES ERROR SERVER CONNECTION):
; the server's own close is EOF then CLS, the stream's normal close; no
; trap or error text after the EOF; the server's process gone; its side of
; the connection removed.  (te-report) only records the opcodes, the 60ths
; to the close and the length of the text after the EOF.

; EOF alone after the banner
(te-open) => T
(te-eof-and-wait 10) => (:CLOSED (:EOF :CLS) :NO-ERROR :SERVER-GONE NIL)
(te-closed-within 60) => T
(te-report)
(te-cleanup) => T

; EOF alone after typed forms, which are answered first
(te-open) => T
(progn (te-send "(+ 1 2)") (te-poll 120) (te-send "(list 'a (* 6 7))") (te-poll 120) (list (not (null (string-search "3" *te-text*))) (not (null (string-search "(A 42)" *te-text*))))) => (T T)
(te-eof-and-wait 10) => (:CLOSED (:EOF :CLS) :NO-ERROR :SERVER-GONE NIL)
(te-closed-within 60) => T
(te-report)
(te-cleanup) => T

; EOF alone while a form runs (5 s): the form ends and its value is sent,
; then the close, within a second of the value
(te-open) => T
(te-form-then-eof "(progn (process-sleep 300) :te-done)" 20 ":TE-DONE") => (:CLOSED (:EOF :CLS) :NO-ERROR :SERVER-GONE NIL)
(list (not (null *te-done-time*)) (te-closed-within 60)) => (T T)
(te-report)
(te-cleanup) => T

; EOF alone while the listener asks whether to enter the debugger, after an
; error in a typed form: the question's read takes the EOF
(te-open) => T
(progn (te-send "(car 1)") (te-poll 300) (not (null (string-search "debugger" *te-text*)))) => T
(te-eof-and-wait 10) => (:CLOSED (:EOF :CLS) :NO-ERROR :SERVER-GONE NIL)
(te-cleanup) => T

; EOF then CLS, as ozd closes when its TCP client closes: nothing is left
; behind, after the banner, after a form and while a form runs
(te-open) => T
(te-eof-then-cls 10) => (:SERVER-GONE NIL)
(te-cleanup) => T
(te-open) => T
(progn (te-send "(+ 1 2)") (te-poll 120) (te-eof-then-cls 10)) => (:SERVER-GONE NIL)
(te-cleanup) => T
(te-open) => T
(progn (te-send "(progn (process-sleep 300) :te-done)") (te-poll 30) (te-eof-then-cls 15)) => (:SERVER-GONE NIL)
(te-cleanup) => T

; and no connection to this band itself is left closed or lost
(loop for c in chaos:conn-list when (and (= (chaos:foreign-address c) chaos:my-address) (memq (chaos:state c) '(chaos:cls-received-state chaos:los-received-state))) collect (chaos:state c)) => NIL
