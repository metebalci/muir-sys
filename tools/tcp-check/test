#!/usr/bin/env python3
"""The wall judge's own check (QUUX's Ethernet contract, section 9, "How the
wall-clocked lanes (T2-T4) are judged"): judge_session on made-up relay
records, each case with the verdict the bound and the endings clause give.
No machine, no tap.  Exit status 0 when every case comes out as expected.

  tools/tcp-check/test [RUN]     RUN: the judge to check (default: ./run)

The cases:
  r2-band         the band's R2: its oldest segment sent seven times, each lost
                  or its ACK lost; the band closes silently, and the peer's
                  probe 137 s after the band's last transmission draws RST:
                  explained, though an ACK past the segment reached the band
                  after its R2
  abort-linux     Linux's abort: its data sent six times, each lost or its
                  ACK lost, and a late ACK from the band, past Linux's next
                  RTO, before Linux's socket gives up: explained
  acked-in-time   as r2-band, but the ACK of the last transmission arrives
                  within the band's next RTO: not explained
  floor-20        20% loss: 100 s within T0 + 120 s; 125 s over it
  floor-5         5% loss: the same 100 s over T0 + 60 s
  m-20, m-5       1 MiB: M 14 at 20% loss (300 s within, 330 s over), M 10
                  at 5% (240 s over)
"""

import os
import sys
import types
from importlib.machinery import SourceFileLoader

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.abspath(__file__))

LP, BP = 40000, 7               # Linux's port, the echo service's
L, B = 1000, 5000               # the ISNs
T0 = {'65536': 1.45, '1048576': 23.2}


def ev(t, way, status, flags, seq, ack, n=0):
    sp, dp = (LP, BP) if way == 'to_band' else (BP, LP)
    return (t, way, status, sp, dp, flags, seq, ack, n)


def sent(t, way, flags, seq, ack, n=0, lost=False):
    """One transmission: its arrival at the relay, and its delivery unless lost."""
    if lost:
        return [ev(t, way, 'LOST', flags, seq, ack, n)]
    return [ev(t, way, 'in', flags, seq, ack, n), ev(t + 0.0001, way, 'out', flags, seq, ack, n)]


def handshake():
    return (sent(0.0, 'to_band', 'S', L, 0) + sent(0.01, 'from_band', 'SA', B, L + 1) +
            sent(0.02, 'to_band', 'A', L + 1, B + 1))


def r2_band(ack_last_delivered=False):
    """Linux's 100 bytes taken; the band's echo of them sent at 0.05, then
    resent with its RTO doubling, every one lost or its ACK lost; the band's
    R2 is silent; Linux's probe at 200 s is answered by RST."""
    e = handshake() + sent(0.03, 'to_band', 'PA', L + 1, B + 1, 100)
    for t, lost in ((0.05, True), (1.05, True), (3.05, False), (7.05, True), (15.05, False), (31.05, True),
                    (63.05, False)):
        e += sent(t, 'from_band', 'PA', B + 1, L + 101, 100, lost)
        if not lost:
            last = ack_last_delivered and t == 63.05
            e += sent(t + 0.01, 'to_band', 'A', L + 101, B + 101, 0, lost=not last)
    e += sent(200.0, 'to_band', 'A', L + 100, B + 101)
    e += sent(200.01, 'from_band', 'R', B + 101, 0)
    return e, 200.02


def abort_linux():
    """Linux's 100 bytes sent six times, every one lost or the band's ACK of
    it lost; the band's ACK at 80 s, after Linux's next RTO; Linux's socket
    gives up at 90 s."""
    e = handshake()
    for t, lost in ((0.03, True), (1.03, True), (3.03, False), (7.03, True), (15.03, False), (31.03, True)):
        e += sent(t, 'to_band', 'PA', L + 1, B + 1, 100, lost)
        if not lost:
            e += sent(t + 0.01, 'from_band', 'A', B + 1, L + 101, 0, lost=True)
    e += sent(80.0, 'from_band', 'A', B + 1, L + 101)
    return e, 90.0


def clean(took):
    """A session with no loss that takes TOOK seconds."""
    e = handshake() + sent(0.03, 'to_band', 'PA', L + 1, B + 1, 100) + sent(0.04, 'from_band', 'A', B + 1, L + 101)
    return e, took


def judge(run, events, t1, loss, size=65536, error=None):
    opts = types.SimpleNamespace(faults='--seed 1 --loss %g --direction both' % loss, wall_m=10, wall_m_high=14)
    r = {'size': size, 'k': 1, 'port': LP, 't0': 0.0, 't1': t1, 'error': error, 'timed_out': False}
    return run.judge_session(r, events, opts, T0)


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else os.path.join(HERE, 'run')
    run = SourceFileLoader('tcp_check_run', path).load_module()
    reset = '[Errno 104] Connection reset by peer'
    cases = [
        ('r2-band', 'PASS', lambda: judge(run, *r2_band(), 20, error=reset)),
        ('abort-linux', 'PASS', lambda: judge(run, *abort_linux(), 20, error='[Errno 110] Connection timed out')),
        ('acked-in-time', 'FAIL', lambda: judge(run, *r2_band(ack_last_delivered=True), 20, error=reset)),
        ('floor-20 100 s', 'PASS', lambda: judge(run, *clean(100.0), 20)),
        ('floor-20 125 s', 'FAIL', lambda: judge(run, *clean(125.0), 20)),
        ('floor-5 100 s', 'FAIL', lambda: judge(run, *clean(100.0), 5)),
        ('m-20 1 MiB 300 s', 'PASS', lambda: judge(run, *clean(300.0), 20, size=1048576)),
        ('m-20 1 MiB 330 s', 'FAIL', lambda: judge(run, *clean(330.0), 20, size=1048576)),
        ('m-5 1 MiB 240 s', 'FAIL', lambda: judge(run, *clean(240.0), 5, size=1048576)),
    ]
    bad = 0
    for name, want, f in cases:
        got, line = f()
        ok = got == want
        bad += not ok
        print('%-18s %-4s %s (want %s): %s' % (name, 'ok' if ok else 'BAD', got, want, line))
    print('test: %d of %d cases as expected' % (len(cases) - bad, len(cases)))
    return 1 if bad else 0


if __name__ == '__main__':
    sys.exit(main())
