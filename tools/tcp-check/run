#!/usr/bin/env python3
"""T2 of QUUX's Ethernet contract (section 9): the build host's own TCP, its
sockets as clients, to the band through the fault relay and a pooled tap.

usage:
  tools/tcp-check/run [--parts telnet,echo,churn,limit,stall,table,totals,mloss] [--echo-sizes 1,1024,65536,1048576]
                      [--echo-times 10] [--connections 1000] [--stall 30,180]
                      [--faults 'RELAY-FLAGS'] [--transfer-timeout S] [--trace FILE]
                      [--wall-base FILE] [--wall-m 10] [--wall-m-high 14] [--wall-base-out FILE]
                      [--wall-log FILE] [--mloss-size N] [--ss-log FILE]
                      [-- LISPM-CHECK-ARGS...]

It takes a tap and resumes that index's checkpoint as tools/lispm-check does
(it is lispm-check's own code, loaded from beside it, so the flags after --
are lispm-check's: --band, --quux, --ubin, --tree, --engine, --file-server,
--network and the rest, LISPM_CHECK_TAPS and LISPM_CHECK_PORTS too).  The
machine must be revision 16 and the band one with the network.  It then
opens the control session, a TELNET session of its own over lispm-check's
--network (tcp by default here), and turns the test echo service on.  Each
part connects from sockets bound to the run's tap to QUUX's address behind
it, as Linux's own TCP:

  telnet   three TELNET sessions to port 23 one after another and two at
           once: each gets the banner, answers a form, and at the client's
           EOF closes its side, with FIN (section 7)
  echo     the test echo service, port 7, both ways at once: each size sent
           --echo-times times while its echo is read, the echo equal to what
           was sent by sha256 (1 B, 1 KiB, 64 KiB and 1 MiB, ten times each)
  churn    --connections connections to port 7 opened and closed in a row,
           each echoing one byte; after them the band holds no connection
           but the control session's, and 64 TIME-WAIT records or fewer
  limit    with the control session closed first (it is one of the 8): 8
           connections at once, each echoing one byte, and a ninth refused
           with RST; after them the band holds none but a new control
           session's
  table    T4, run when named: after the parts before it, no connection
           but the control session's, counted once a second for at most
           120 s, above R2's 100 s; the wait is reported
  totals   T4, run when named: since the faults started, the band's totals
           of 241 <15:9> and <7:4> risen by exactly the frames the relay
           corrupted and injected
  mloss    M-loss (section 15, amendment 4), run only when named: one echo
           of --mloss-size with Linux's state read by ss -tnio every 2 s;
           it ends as T4 allows, and at every sample after progress of an
           MSS Linux's backoff is 3 or less
  stall    M-tap's stall test (section 15, Q8), run only when named: the
           machine stopped for each of --stall's seconds (30 and 180) with a
           form in flight on a TELNET session over TCP; the session is kept
           and the form answered once the machine goes on

With --wall-base, T4's wall bound judges every echo session (the wall
line): max(M x T0, T0 + 60 s), M 10 and at 20% loss --wall-m-high, runs of
four or more failed transmissions of one segment not counted, and at 20%
loss an early ending explained by the relay's --trace passes; README.md,
"The wall bound".

and at the end the fault relay, which checks every Ethernet frame the band
sends with its own code, must have found none bad.  The test switch, each
part and the relay's finding each say PASS or
FAIL with the reason and its figures; the exit status is 0 when every part
passes, 1 when one fails, and 2 when the run itself failed (lispm-check's
statuses).  --keep keeps the run's files (the control session's TELNET log,
the machine's log, the relay's report) and says where.  The wall clock
bounds a transfer (--transfer-timeout, 900 s) and nothing else: T2 asserts
outcomes, not timers (section 9, "How the wall-clocked lanes are judged").
Python's standard library only.
"""

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import random
import select
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time

HERE = os.path.dirname(os.path.abspath(__file__))
TOOLS = os.path.dirname(HERE)


def load_lispm_check():
    path = os.path.join(TOOLS, 'lispm-check')
    loader = importlib.machinery.SourceFileLoader('lispm_check', path)
    spec = importlib.util.spec_from_loader('lispm_check', loader)
    m = importlib.util.module_from_spec(spec)
    loader.exec_module(m)
    return m


lc = load_lispm_check()
ECHO_PORT, TELNET_PORT = 7, 23
CONNECT_TIMEOUT = 10


class PartFailed(Exception):
    pass


class Band:
    """The band behind the run's tap, from the build host's side."""
    def __init__(self, link, transfer_timeout):
        self.tap, self.address, self.timeout = link.tap, link.quux, transfer_timeout
        self.current = None     # the session in progress, for M-loss's sampler

    def connect(self, port, timeout=CONNECT_TIMEOUT):
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.setsockopt(socket.SOL_SOCKET, lc.SO_BINDTODEVICE, self.tap.encode())
        s.settimeout(timeout)
        try:
            s.connect((self.address, port))
        except OSError:
            s.close()
            raise
        return s

    def read_to_eof(self, s, deadline):
        """What the band sends until its EOF, by DEADLINE (a monotonic time).
        The socket is left blocking and each read waits in select, since a
        sender thread may be in sendall on it: Python's socket timeout bounds
        a whole sendall (since 3.5), so a timeout set for the reads would cut
        a long send short."""
        got = []
        while True:
            left = deadline - time.monotonic()
            if left <= 0 or not select.select([s], [], [], left)[0]:
                raise PartFailed('no EOF from the band within the transfer timeout (%d bytes read)'
                                 % sum(len(x) for x in got))
            d = s.recv(65536)
            if not d:
                return b''.join(got)
            got.append(d)

    def echo(self, data):
        """DATA sent to the test echo service while its echo is read, then
        our EOF: the echo, read to the band's EOF."""
        r = self.echo_session(data)
        if r['error']:
            raise PartFailed(r['error'])
        return r['echo']

    def echo_session(self, data):
        """As echo, as one session of T4's wall bound: a dict of its local
        port, its start and end (monotonic), the echo read so far and the
        error that ended it, or None, so that a session that ends early can
        be judged by what it echoed before (section 9, T4)."""
        r = {'size': len(data), 'port': None, 't0': time.monotonic(), 't1': None, 'echo': b'', 'error': None,
             'timed_out': False}
        try:
            s = self.connect(ECHO_PORT)
        except OSError as e:
            r['t1'], r['error'] = time.monotonic(), 'connecting: %s' % e
            return r
        r['port'] = s.getsockname()[1]
        self.current = r
        s.settimeout(None)
        deadline = r['t0'] + self.timeout
        failed = []

        def send():
            try:
                s.sendall(data)
                s.shutdown(socket.SHUT_WR)
            except OSError as e:
                failed.append(e)
        t = threading.Thread(target=send, daemon=True)
        t.start()
        got = []
        try:
            while True:
                left = deadline - time.monotonic()
                if left <= 0 or not select.select([s], [], [], left)[0]:
                    r['error'] = ('no EOF from the band within the transfer timeout (%d bytes read)'
                                  % sum(len(x) for x in got))
                    r['timed_out'] = True
                    break
                d = s.recv(65536)
                if not d:
                    break
                got.append(d)
        except OSError as e:
            r['error'] = 'reading: %s (%d bytes read)' % (e, sum(len(x) for x in got))
        finally:
            r['t1'] = time.monotonic()
            t.join(max(0.1, deadline - time.monotonic()))
            s.close()
            self.current = None
        r['echo'] = b''.join(got)
        if failed and not r['error']:
            r['error'] = 'sending: %s' % failed[0]
        return r


def telnet_session(band, form, want, log):
    """One TELNET session over the build host's TCP: the banner, FORM's
    answer, then our EOF and the band's: its server closes at EOF."""
    s = band.connect(TELNET_PORT)
    s.settimeout(0.2)
    text, end = '', time.monotonic() + 120
    while 'Telnet server here' not in text:
        if time.monotonic() > end:
            raise PartFailed('no banner in 120 s')
        try:
            d = s.recv(4096)
        except socket.timeout:
            continue
        if not d:
            raise PartFailed('the band closed before its banner')
        text += d.decode('latin-1')
    log.write(text)
    sess = lc.Session(s, log, helper=True)
    r = sess.run(form, 120)
    if r[0] != 'value' or lc.normal(r[1]) != want:
        raise PartFailed('%s gave %s, wanted %s' % (form, r, want))
    s.settimeout(None)
    s.shutdown(socket.SHUT_WR)
    band.read_to_eof(s, time.monotonic() + 60)
    s.close()


class Control:
    """The control session: lispm-check's session over its --network, and
    the forms T2 needs of the band (section 9, T1, the way in)."""
    def __init__(self, a, server, machine, log):
        self.a, self.server, self.machine, self.log = a, server, machine, log
        self.sess = None
        self.sessions = []      # every echo session, for the wall bound

    def open(self):
        sock, _ = self.server.connect_listener(self.machine.alive, lc.now() + 120)
        sock.settimeout(0.2)
        self.sock = sock
        self.port = sock.getsockname()[1]
        self.sess = lc.Session(sock, self.log, helper=True)

    def close(self):
        self.server.close_session(self.sock, False)
        self.sess = None

    def value(self, form):
        r = self.sess.run(form, 120)
        if r[0] != 'value':
            raise PartFailed('%s: %s %s' % (lc.oneline(form), r[0], lc.normal(r[1])))
        return lc.normal(r[1])

    def others(self):
        """The band's connections other than this control session's: over TCP
        the control session is one of them, by its local port; over Chaos it
        is none of them."""
        if self.a.network == 'tcp':
            form = ('(let ((n 0)) (dolist (c ip::tcp-connections n)'
                    ' (unless (= (ip::tcb-rport c) %d) (setq n (1+ n)))))' % self.port)
        else:
            form = '(length ip::tcp-connections)'
        return int(self.value(form))

    def others_states(self):
        """The remote port and state of each connection others() counts, for
        a table part that fails."""
        mine = ('(unless (= (ip::tcb-rport c) %d) ' % self.port) if self.a.network == 'tcp' else '(progn '
        form = ('(let ((l nil)) (dolist (c ip::tcp-connections l) %s'
                '(push (list (ip::tcb-rport c) (ip::tcb-state c)) l))))' % mine)
        try:
            return self.value(form)
        except PartFailed as e:
            return 'their states not read: %s' % e

    def time_wait(self):
        return int(self.value('(let ((n 0)) (dotimes (i 64 n) (when (aref ip::tcp-tw-remote i) (setq n (1+ n)))))'))


def part_telnet(band, control, opts, log):
    for i in range(3):
        telnet_session(band, '(+ %d 2)' % i, str(i + 2), log)
    out = []
    ts = [threading.Thread(target=lambda k=k: out.append(_catch(telnet_session, band, '(* %d 3)' % k, str(3 * k), log)))
          for k in (5, 7)]
    for t in ts:
        t.start()
    for t in ts:
        t.join(300)
    bad = [x for x in out if x]
    if len(out) != 2 or bad:
        raise PartFailed('two sessions at once: %s' % (bad or 'one did not end'))
    return '3 sessions in a row and 2 at once, each closed by the band at EOF'


def _catch(f, *args):
    try:
        f(*args)
        return None
    except (OSError, PartFailed, lc.RunFailed) as e:
        return str(e)


def part_echo(band, control, opts, log):
    rng = random.Random(2)
    figures = []
    ended = []
    for size in opts.echo_sizes:
        t0 = time.monotonic()
        for k in range(opts.echo_times):
            data = rng.randbytes(size)
            r = band.echo_session(data)
            r['k'] = k + 1
            control.sessions.append(r)
            echo = r['echo']
            if r['error']:
                # Ended early: with the wall bound on, the endings clause
                # judges it after the part (wall_judge); else it fails here.
                if not opts.wall_base or echo != data[:len(echo)]:
                    raise PartFailed('%d bytes, time %d: %s%s' % (
                        size, k + 1, r['error'], '' if echo == data[:len(echo)] else
                        '; what was echoed differs from what was sent'))
                ended.append('%d B #%d' % (size, k + 1))
                continue
            if hashlib.sha256(echo).digest() != hashlib.sha256(data).digest():
                raise PartFailed('%d bytes, time %d: the echo\'s %d bytes differ by sha256' % (size, k + 1, len(echo)))
        figures.append('%d B x%d in %.1f s' % (size, opts.echo_times, time.monotonic() - t0))
    return 'byte for byte by sha256: ' + ', '.join(figures) + (
        '; ended early, exact so far, for the wall line to judge: %s' % ', '.join(ended) if ended else '')


def part_churn(band, control, opts, log):
    t0 = time.monotonic()
    for k in range(opts.connections):
        try:
            if band.echo(b'%c' % (k & 0xFF)) != b'%c' % (k & 0xFF):
                raise PartFailed('connection %d: the echo differs' % (k + 1))
        except OSError as e:
            raise PartFailed('connection %d: %s' % (k + 1, e))
    took = time.monotonic() - t0
    others, tw = control.others(), control.time_wait()
    if others != 0 or tw > 64:
        raise PartFailed('after %d connections: %d connections besides the control session, %d TIME-WAIT records'
                         % (opts.connections, others, tw))
    return '%d connections in %.1f s; then 0 connections besides the control session, %d TIME-WAIT records' % (
        opts.connections, took, tw)


def part_limit(band, control, opts, log):
    if control.a.network == 'tcp':
        control.close()        # the control session is one of the 8
    held = []
    try:
        for k in range(8):
            s = band.connect(ECHO_PORT)
            held.append(s)
            s.sendall(b'x')
            s.settimeout(30)
            if s.recv(1) != b'x':
                raise PartFailed('connection %d of 8: no echo' % (k + 1))
        try:
            ninth = band.connect(ECHO_PORT)
        except ConnectionRefusedError:
            ninth = None
        except OSError as e:
            raise PartFailed('the ninth: %s, not refused with RST' % e)
        if ninth is not None:
            ninth.close()
            raise PartFailed('a ninth connection was taken')
    finally:
        for s in held:
            try:
                s.settimeout(None)
                s.shutdown(socket.SHUT_WR)
                band.read_to_eof(s, time.monotonic() + 60)
            except (OSError, PartFailed):
                pass
            s.close()
    if control.sess is None:
        control.open()
    others = control.others()
    if others != 0:
        raise PartFailed('after the 8 closed: %d connections besides the control session' % others)
    return '8 at once, the ninth refused with RST; then none besides the control session'


def part_stall(band, control, opts, log):
    """M-tap's stall test (section 15, Q8): the machine stopped (SIGSTOP to
    its process group) with a form in flight on a TELNET session over the
    build host's TCP, for each of --stall's seconds, then let go: the
    session is kept, Linux's TCP resending until the band answers, and the
    form's answer comes."""
    figures = []
    for seconds in opts.stall:
        s = band.connect(TELNET_PORT)
        s.settimeout(0.2)
        text, end = '', time.monotonic() + 120
        while 'Telnet server here' not in text:
            if time.monotonic() > end:
                raise PartFailed('no banner in 120 s')
            try:
                d = s.recv(4096)
            except socket.timeout:
                continue
            if not d:
                raise PartFailed('the band closed before its banner')
            text += d.decode('latin-1')
        sess = lc.Session(s, log, helper=True)
        r = sess.run('(+ 40 2)', 120)
        if r[0] != 'value' or lc.normal(r[1]) != '42':
            raise PartFailed('before the stall: %s' % (r,))
        os.killpg(control.machine.proc.pid, signal.SIGSTOP)
        try:
            # the form goes out while the band cannot take it: data in flight
            s.sendall(b"(lispm-check-case 777001 '(* 6 7))\r\n")
            time.sleep(seconds)
        finally:
            os.killpg(control.machine.proc.pid, signal.SIGCONT)
        t0 = time.monotonic()
        buf, end = '', time.monotonic() + 300
        while '{777001{42}777001}' not in buf:
            if time.monotonic() > end:
                raise PartFailed('after a stall of %d s: no answer in 300 s' % seconds)
            try:
                d = s.recv(4096)
            except socket.timeout:
                continue
            if not d:
                raise PartFailed('after a stall of %d s: the session closed' % seconds)
            buf += d.decode('latin-1')
            log.write(d.decode('latin-1'))
        figures.append('%d s: answered %.1f s after' % (seconds, time.monotonic() - t0))
        s.settimeout(None)
        s.shutdown(socket.SHUT_WR)
        band.read_to_eof(s, time.monotonic() + 60)
        s.close()
    return 'the session kept through each stall: ' + ', '.join(figures)


# The table part counts the band's connections once a second until none is
# left but the control session's, for at most TABLE_WAIT seconds.  A single
# count right after the echo part failed T4's loss20-both row on seed 1: the
# last session's echo had ended at the band's FIN, Linux's ACK of that FIN was
# lost, and the band, rightly in LAST-ACK, closed 3.3 s later on its FIN's
# resend.  120 s is above R2's 100 s (section 5.5), so a connection still held
# then is one the band will not close by itself.
TABLE_WAIT = 120.0
TABLE_POLL = 1.0


def part_table(band, control, opts, log):
    """T4: the connection table empty after the other parts, but for the
    control session's, within TABLE_WAIT seconds of the first count, counted
    once a second."""
    # the wait runs from the first count's answer, so that a table empty at
    # once waits 0 s whatever a count takes on the control session
    t0 = None
    counts = 0
    while True:
        others = control.others()
        counts += 1
        if t0 is None:
            t0 = time.monotonic()
        waited = time.monotonic() - t0
        if others == 0:
            break
        if waited >= TABLE_WAIT:
            raise PartFailed('%d connections besides the control session after %.1f s (%d counts; the wait is '
                             'at most %d s, above R2\'s 100 s): %s' % (others, waited, counts, TABLE_WAIT,
                                                                     control.others_states()))
        time.sleep(max(0.0, t0 + counts * TABLE_POLL - time.monotonic()))
    tw = control.time_wait()
    return 'no connection besides the control session after a wait of %.1f s (%d counts); %d TIME-WAIT records' % (
        waited, counts, tw)


def relay_report(control):
    """The relay's report, written fresh on SIGUSR1."""
    path = control.link.report
    before = os.path.getmtime(path) if os.path.exists(path) else 0
    os.kill(control.link.proc.pid, signal.SIGUSR1)
    end = time.monotonic() + 10
    while time.monotonic() < end:
        if os.path.exists(path) and os.path.getmtime(path) != before:
            break
        time.sleep(0.1)
    with open(path) as f:
        return json.load(f)


def totals(control):
    return [int(x) for x in control.value('(list (ip:type-filter-total) (ip:ipv4-checks-total))').strip('()').split()]


def part_totals(band, control, opts, log):
    """T4: since the control session began, the band's total of 241 <15:9>,
    the IPv4 checks, risen by exactly the frames the relay corrupted toward
    it, and of <7:4>, the type filter, by exactly the frames it injected.  A
    corrupted frame still in flight is waited for, five times a second."""
    t0, c0 = control.start_totals
    for _ in range(5):
        t1, c1 = totals(control)
        r = relay_report(control)['faults']
        corrupted, injected = r['to_band']['corrupted'], r['injected']
        if (c1 - c0, t1 - t0) == (corrupted, injected):
            return '<15:9> up %d, the relay corrupted %d; <7:4> up %d, it injected %d' % (
                c1 - c0, corrupted, t1 - t0, injected)
        if c1 - c0 > corrupted or t1 - t0 > injected:
            break
        time.sleep(1)
    raise PartFailed('<15:9> up %d, the relay corrupted %d; <7:4> up %d, it injected %d' % (
        c1 - c0, corrupted, t1 - t0, injected))


# --------------------------------------------------------------------------
# T4's wall bound and M-loss (section 9, "How the wall-clocked lanes are
# judged"; section 15, M-loss; amendment 4), from the fault relay's trace
# (its --trace): every frame at its arrival, "in" or "LOST", and at its
# sending, "out", on the host's monotonic clock, which this program's
# time.monotonic() shares.

RUN_EXCUSED = 4         # a run of this many failed transmissions of one segment, or more, is not counted
ENDING_WINDOW = 100.0   # the endings clause looks at the relay's record's last 100 s
WALL_FLOOR = 60.0       # each session's bound is max(M x T0, T0 + 60 s)


def read_trace(path, ports, t_lo, t_hi):
    """{port: [(t, way, status, sport, dport, flags, seq, ack, n)]} of the
    trace's TCP lines between T_LO and T_HI for the local PORTS (Linux's
    side of each session; the band's port is the echo service's)."""
    out = {p: [] for p in ports}
    if not path or not os.path.exists(path):
        return out
    with open(path) as f:
        for line in f:
            w = line.split()
            # TIME WAY STATUS SP>DP FLAGS seq S ack A win W len N
            if len(w) != 13 or '>' not in w[3]:
                continue
            t = float(w[0])
            if t < t_lo or t > t_hi:
                continue
            sp, dp = (int(x) for x in w[3].split('>'))
            port = dp if w[1] == 'from_band' else sp
            if port not in out:
                continue
            out[port].append((t, w[1], w[2], sp, dp, w[4], int(w[6]), int(w[8]), int(w[12])))
    return out


def unwrap(base, x):
    d = (x - base) & 0xFFFFFFFF
    return d - (1 << 32) if d >= 1 << 31 else d


class Way:
    """One direction of one session in the trace: its transmissions and the
    other side's ACKs of them.  A segment is followed by the sequence number
    it starts at: its transmissions are every one holding that number, so
    that a resend of other bounds counts.  A transmission failed when the
    relay lost it, or when it arrived and an ACK covering it was lost by the
    relay, with none delivered before the next transmission (section 9, T4:
    "losses, by the fault relay, of one segment's transmissions or of the
    acknowledgments that would have covered them").  One that arrived and
    drew no ACK, as a segment beyond a hole that the band drops, is no
    relay's loss."""

    def __init__(self, events, way, end):
        import bisect
        self.bisect = bisect
        self.way, self.end = way, end
        other = 'from_band' if way == 'to_band' else 'to_band'
        mine = [e for e in events if e[1] == way and e[2] in ('in', 'LOST')]
        syn = next((e for e in mine if 'S' in e[5]), None)
        first = next((e for e in events if e[1] == way), None)
        self.base = (syn or first)[6] if (syn or first) else 0
        self.tx = []            # (t, start, end, lost), in time order
        for e in mine:
            n = e[8] + ('S' in e[5]) + ('F' in e[5])
            if n <= 0 or 'R' in e[5]:
                continue
            start = unwrap(self.base, e[6])
            self.tx.append((e[0], start, start + n, e[2] == 'LOST'))
        # the other side's ACKs of this way: delivered, a running maximum;
        # and those the relay lost
        self.ack_t, self.ack_max, self.lost_acks = [], [], []
        best = None
        for e in events:
            if e[1] == other and 'A' in e[5]:
                a = unwrap(self.base, e[7])
                if e[2] == 'out':
                    best = a if best is None or a > best else best
                    self.ack_t.append(e[0])
                    self.ack_max.append(best)
                elif e[2] == 'LOST':
                    self.lost_acks.append((e[0], a))

    def acked_by(self, t):
        """The furthest ACK of this way delivered by time T, or None."""
        i = self.bisect.bisect_right(self.ack_t, t)
        return self.ack_max[i - 1] if i else None

    def acked_at(self, s, t):
        """The first time after T an ACK past S was delivered, or None."""
        i = max(self.bisect.bisect_right(self.ack_t, t), self.bisect.bisect_right(self.ack_max, s))
        return self.ack_t[i] if i < len(self.ack_t) else None

    def holding(self, s):
        """The transmissions holding sequence number S, in time order."""
        return [x for x in self.tx if x[1] <= s < x[2]]

    def failed(self, s, row, i):
        t, _, _, lost = row[i]
        if lost:
            return True
        nxt = row[i + 1][0] if i + 1 < len(row) else self.end
        a = self.acked_by(nxt)
        if a is not None and a > s:
            return False
        return any(t < ta <= nxt and aa > s for ta, aa in self.lost_acks)

    def excused(self):
        """The intervals not counted: from the first failed transmission of
        a run of RUN_EXCUSED or more of one segment to its next transmission,
        or to its acknowledgment if that came first, when an earlier
        transmission had reached the receiver (the session's end if
        neither)."""
        out = []
        for s in sorted({x[1] for x in self.tx}):
            row = self.holding(s)
            f = [self.failed(s, row, i) for i in range(len(row))]
            i = 0
            while i < len(row):
                if not f[i]:
                    i += 1
                    continue
                j = i
                while j < len(row) and f[j]:
                    j += 1
                if j - i >= RUN_EXCUSED:
                    ends = [row[j][0]] if j < len(row) else [self.end]
                    acked = self.acked_at(s, row[j - 1][0])
                    if acked is not None:
                        ends.append(acked)
                    out.append((row[i][0], min(ends), s, j - i))
                i = j
        return out

    def ending_explained(self):
        """The endings clause: in the record's last ENDING_WINDOW seconds,
        every transmission of the oldest unacknowledged segment failed, and
        there was one.  Returns a description, or None."""
        a = self.acked_by(self.end)
        open_ = sorted(x[1] for x in self.tx if a is None or x[2] > a)
        if not open_:
            return None
        oldest = max(open_[0], a) if a is not None else open_[0]
        row = self.holding(oldest)
        f = [(row[i][0], self.failed(oldest, row, i)) for i in range(len(row))]
        f = [(t, x) for t, x in f if t >= self.end - ENDING_WINDOW]
        if f and all(x for _, x in f):
            return '%s: its oldest unacknowledged segment, +%d, sent %d times in the last %d s, each lost or ' \
                   'its ACK lost' % (self.way.replace('_', ' '), oldest, len(f), ENDING_WINDOW)
        return None


def merge(intervals, lo, hi):
    """The length of the union of INTERVALS clipped to [LO, HI]."""
    xs = sorted((max(a, lo), min(b, hi)) for a, b in intervals if min(b, hi) > max(a, lo))
    total, cur = 0.0, None
    for a, b in xs:
        if cur is None or a > cur[1]:
            if cur:
                total += cur[1] - cur[0]
            cur = [a, b]
        else:
            cur[1] = max(cur[1], b)
    if cur:
        total += cur[1] - cur[0]
    return total


def fault_loss(faults):
    """The --loss percentage in the relay's fault flags, or 0."""
    w = (faults or '').split()
    return float(w[w.index('--loss') + 1]) if '--loss' in w and w.index('--loss') + 1 < len(w) else 0.0


def wall_m(opts):
    """M of the bound: M at 20% loss and above, else 10 (section 9, T4)."""
    return opts.wall_m_high if fault_loss(opts.faults) >= 20 else opts.wall_m


def judge_session(r, events, opts, base):
    """One session against the bound: (verdict, line)."""
    t0 = base[str(r['size'])]
    m = wall_m(opts)
    bound = max(m * t0, t0 + WALL_FLOOR)
    end = r['t1']
    ways = [Way(events, w, end) for w in ('to_band', 'from_band')]
    runs = [x for w in ways for x in w.excused()]
    took = end - r['t0']
    counted = took - merge([(a, b) for a, b, _, _ in runs], r['t0'], end)
    what = '%d B #%d port %s: %.1f s, %.1f s counted (%d runs of %d+ excused), bound %.1f s' % (
        r['size'], r.get('k', 0), r['port'], took, counted, len(runs), RUN_EXCUSED, bound)
    if r['error']:
        # The endings clause, at 20% loss only: the band's R2 or Linux's
        # abort, explained by the relay's record.
        why = None
        if fault_loss(opts.faults) >= 20 and not r['timed_out']:
            # the band's R2 or Linux's abort ends a session with an error on
            # its socket; the transfer timeout is this program's, never one
            why = next((x for x in (w.ending_explained() for w in ways) if x), None)
        if why:
            return 'PASS', what + '; ended (%s), explained: %s' % (r['error'], why)
        return 'FAIL', what + '; ended (%s), not explained by the relay\'s record' % r['error']
    if counted > bound:
        return 'FAIL', what + ': over the bound'
    return 'PASS', what


def wall_judge(control, opts):
    """Every recorded session against max(M x T0, T0 + 60 s) (section 9, T4;
    amendment 4)."""
    base = json.load(open(opts.wall_base))
    rs = control.sessions
    if not rs:
        raise PartFailed('no session to judge')
    trace = read_trace(opts.trace, [r['port'] for r in rs if r['port']],
                       min(r['t0'] for r in rs) - 1, max(r['t1'] for r in rs) + 1)
    lines, bad = [], []
    for r in rs:
        ev = [e for e in trace.get(r['port'], []) if r['t0'] - 1 <= e[0] <= r['t1'] + 1]
        v, line = judge_session(r, ev, opts, base)
        # the session's start and end on the monotonic clock, so that it can
        # be judged again from the trace
        lines.append('%s %s [%.6f %.6f]' % (v, line, r['t0'], r['t1']))
        if v != 'PASS':
            bad.append(line)
    if opts.wall_log:
        with open(opts.wall_log, 'w') as f:
            f.write('\n'.join(lines) + '\n')
    m = wall_m(opts)
    worst = max(rs, key=lambda r: (r['t1'] - r['t0']) / base[str(r['size'])])
    summary = '%d sessions, M = %g; slowest %d B #%d at %.1f x T0' % (
        len(rs), m, worst['size'], worst.get('k', 0), (worst['t1'] - worst['t0']) / base[str(worst['size'])])
    if bad:
        raise PartFailed('%s; %d over: %s' % (summary, len(bad), '; '.join(bad[:3])))
    return summary


def write_wall_base(control, path):
    """T0 of each size: the median of this run's sessions, which must have
    had no faults and no failure (section 9, T4)."""
    by = {}
    for r in control.sessions:
        if r['error']:
            raise PartFailed('a session failed: no base written')
        by.setdefault(str(r['size']), []).append(r['t1'] - r['t0'])
    out = {k: sorted(v)[len(v) // 2] if len(v) % 2 else sum(sorted(v)[len(v) // 2 - 1:len(v) // 2 + 1]) / 2
           for k, v in by.items()}
    with open(path, 'w') as f:
        json.dump(out, f, indent=1, sort_keys=True)
    return 'T0 by size: ' + ', '.join('%s B %.3f s' % (k, v) for k, v in sorted(out.items(), key=lambda x: int(x[0])))


SS_FIELDS = ('rto', 'backoff', 'bytes_acked', 'mss', 'cwnd', 'rtt', 'bytes_retrans', 'lost')


def ss_sample(band, port):
    """Linux's state of the session from local PORT, from ss -tnio, as a dict."""
    try:
        out = subprocess.run(['ss', '-tnio', 'dst', band.address], capture_output=True, text=True,
                             timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    lines = out.splitlines()
    for i, line in enumerate(lines):
        w = line.split()
        if len(w) >= 4 and w[3].endswith(':%d' % port) and i + 1 < len(lines):
            d = {'line': lines[i + 1].strip()}
            for item in lines[i + 1].split():
                if ':' in item:
                    k, v = item.split(':', 1)
                    if k in SS_FIELDS:
                        d[k] = v
            return d
    return None


def part_mloss(band, control, opts, log):
    """M-loss (section 15, amendment 4): one echo of --mloss-size with
    Linux's state read by ss -tnio every 2 s.  It passes when the echo ends
    as T4 allows (byte-exact, or by the endings clause), and at every sample
    whose bytes_acked rose by at least one MSS since the one before, Linux's
    backoff is 3 or less."""
    rng = random.Random(7)
    data = rng.randbytes(opts.mloss_size)
    samples, stop = [], threading.Event()

    def sampler():
        while not stop.wait(2.0):
            r = band.current
            if r and r.get('port'):
                d = ss_sample(band, r['port'])
                if d is not None:
                    d['t'] = time.monotonic()
                    samples.append(d)
    th = threading.Thread(target=sampler, daemon=True)
    band.current = None
    th.start()
    try:
        r = band.echo_session(data)
    finally:
        stop.set()
        th.join(10)
    r['k'] = 1
    control.sessions.append(r)
    if opts.ss_log:
        with open(opts.ss_log, 'w') as f:
            for d in samples:
                f.write('%.6f %s\n' % (d['t'], d['line']))
    took = r['t1'] - r['t0']
    base = json.load(open(opts.wall_base)) if opts.wall_base else {}
    t0 = base.get(str(opts.mloss_size))
    backoff_max, at_progress, last_acked, bad = 0, 0, None, []
    for d in samples:
        b = int(d.get('backoff', 0))
        acked = int(d.get('bytes_acked', 0))
        mss = int(d.get('mss', 1448))
        backoff_max = max(backoff_max, b)
        if last_acked is not None and acked - last_acked >= mss:
            at_progress = max(at_progress, b)
            if b > 3:
                bad.append('backoff %d at +%.0f s after %d bytes acked' % (b, d['t'] - r['t0'], acked - last_acked))
        last_acked = acked
    figures = '%.1f s%s; Linux\'s backoff at most %d, %d at a sample after progress; %d samples' % (
        took, ' = %.2f x T0 (%.3f s)' % (took / t0, t0) if t0 else '', backoff_max, at_progress, len(samples))
    ending = 'byte-exact'
    if r['error'] or r['echo'] != data:
        if r['error'] and not r['timed_out'] and r['echo'] == data[:len(r['echo'])] and \
                fault_loss(opts.faults) >= 20:
            trace = read_trace(opts.trace, [r['port']], r['t0'] - 1, r['t1'] + 1)
            ways = [Way(trace[r['port']], w, r['t1']) for w in ('to_band', 'from_band')]
            why = next((x for x in (w.ending_explained() for w in ways) if x), None)
            if not why:
                raise PartFailed('%s; ended (%s), not explained by the relay\'s record' % (figures, r['error']))
            ending = 'ended (%s), explained: %s' % (r['error'], why)
        else:
            raise PartFailed('%s; the echo: %s' % (figures, r['error'] or 'differs from what was sent'))
    if bad:
        raise PartFailed('%s; %s; %d samples after progress with backoff over 3: %s' % (
            figures, ending, len(bad), '; '.join(bad[:4])))
    return '%s; %s' % (figures, ending)


# The parts run by default are T2's; stall is M-tap's, and table and totals
# T4's, each run when named.
PARTS = {'telnet': part_telnet, 'echo': part_echo, 'churn': part_churn, 'limit': part_limit,
         'stall': part_stall, 'table': part_table, 'totals': part_totals, 'mloss': part_mloss}
T2_PARTS = ('telnet', 'echo', 'churn', 'limit')


def main():
    argv = sys.argv[1:]
    rest = []
    if '--' in argv:
        i = argv.index('--')
        argv, rest = argv[:i], argv[i + 1:]
    p = argparse.ArgumentParser(description='T2: the build host\'s TCP to the band.')
    p.add_argument('--parts', default=','.join(T2_PARTS))
    p.add_argument('--stall', default='30,180', help="stall's seconds, comma-separated")
    p.add_argument('--echo-sizes', default='1,1024,65536,1048576')
    p.add_argument('--echo-times', type=int, default=10)
    p.add_argument('--connections', type=int, default=1000)
    p.add_argument('--transfer-timeout', type=float, default=900)
    p.add_argument('--faults', default=None,
                   help="T4: the fault relay's fault flags, as one string (LISPM_CHECK_RELAY_FLAGS)")
    p.add_argument('--trace', default=None,
                   help="the fault relay's trace of every frame (its --trace), for the wall bound and M-loss")
    p.add_argument('--wall-base', default=None,
                   help="T4's wall bound, on: a JSON file of T0, each size's median session time with no "
                        "faults (--wall-base-out of such a run); every echo session is then judged against "
                        "max(M x T0, T0 + 60 s), its runs of 4 or more failed transmissions not counted")
    p.add_argument('--wall-m', type=float, default=10, help="M below 20%% loss [default: 10]")
    # M at 20% loss: M-loss's worst seed took 6.9 x T0 (both ways, seed 2),
    # and T4's 20% rows at most 6.8 x counted (8.1 x in all); about twice it
    p.add_argument('--wall-m-high', type=float, default=14, help="M at 20%% loss [default: 14]")
    p.add_argument('--wall-base-out', default=None,
                   help="write each size's median session time here, as T0 for --wall-base")
    p.add_argument('--wall-log', default=None, help="each session's figures against the bound")
    p.add_argument('--mloss-size', type=int, default=1048576, help="M-loss's echo [default: 1 MiB]")
    p.add_argument('--ss-log', default=None, help="M-loss's ss -tnio samples")
    opts = p.parse_args(argv)
    if opts.faults is not None or opts.trace:
        # armed once the control session has read the band's totals, so
        # that the setup, the resume and the snapshot run without faults
        os.environ['LISPM_CHECK_RELAY_FLAGS'] = ' '.join(
            ([opts.faults, '--arm-on-signal'] if opts.faults is not None else []) +
            (['--trace', os.path.abspath(opts.trace)] if opts.trace else []))

    def on_signal(sig, frame):
        raise SystemExit(128 + sig)
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, on_signal)
    opts.echo_sizes = [int(x) for x in opts.echo_sizes.split(',') if x]
    opts.stall = [int(x) for x in opts.stall.split(',') if x]
    parts = [x for x in opts.parts.split(',') if x]
    for x in parts:
        if x not in PARTS:
            p.error('--parts: %s is not one of %s' % (x, ', '.join(PARTS)))
    if not any(x == '--network' or x.startswith('--network=') for x in rest):
        rest = ['--network', 'tcp'] + rest
    a = lc.options(rest + [os.devnull])
    link, results, kept = None, [], None
    try:
        link, chk, t_setup = lc.prepare(a)
        if link is None:
            raise lc.RunFailed('T2 wants revision 16, which takes a tap')
        if t_setup is not None:
            print('tcp-check: checkpoint made in %.1f s' % t_setup, flush=True)
        run_dir = lc.run_dir_new('t2')
        ports_lock, ports = lc.take_ports()
        log = open(os.path.join(run_dir, 'telnet.log'), 'w', buffering=1)
        server = lc.FILE_SERVERS[a.file_server](a.ozd, run_dir, ports, log, a.ozd_flags, a.network, link)
        machine = lc.Machine(a.exe, a.band, run_dir, ports[3], server, a.engine)
        ok_run = False
        try:
            server.lay_out(a.tree)
            server.start()
            machine.start(resume=chk)
            control = Control(a, server, machine, log)
            control.link = link
            control.open()
            band = Band(link, opts.transfer_timeout)
            # the test switch is a line of its own; the parts run whatever
            # it gave, so that on a band without the stack each fails for
            # its own reason
            try:
                control.value('(setq ip:*test-echo-service* t)')
                results.append('PASS')
                print('%-6s %-5s the test echo service on' % ('switch', 'PASS'), flush=True)
            except PartFailed as e:
                results.append('FAIL')
                print('%-6s %-5s %s' % ('switch', 'FAIL', e), flush=True)
            if 'totals' in parts:
                control.start_totals = totals(control)
            if opts.faults is not None:
                os.kill(link.proc.pid, signal.SIGUSR2)
                print('%-6s %-5s %s' % ('faults', 'on', opts.faults), flush=True)
            for name in parts:
                t0 = time.monotonic()
                try:
                    why = PARTS[name](band, control, opts, log)
                    verdict = 'PASS'
                except (OSError, PartFailed, lc.RunFailed) as e:
                    verdict, why = 'FAIL', str(e) or type(e).__name__
                    if control.sess is None:
                        try:
                            control.open()
                        except lc.RunFailed:
                            pass
                results.append(verdict)
                print('%-6s %-5s %s (%.1f s)' % (name, verdict, why, time.monotonic() - t0), flush=True)
            # T4's wall bound, on every echo session the parts made, and
            # T0's base from a run with no faults.
            for name, on, f in (('wall', opts.wall_base and 'echo' in parts, lambda: wall_judge(control, opts)),
                                ('base', opts.wall_base_out, lambda: write_wall_base(control, opts.wall_base_out))):
                if not on:
                    continue
                try:
                    why, verdict = f(), 'PASS'
                except (OSError, ValueError, KeyError, PartFailed) as e:
                    verdict, why = 'FAIL', str(e) or type(e).__name__
                results.append(verdict)
                print('%-6s %-5s %s' % (name, verdict, why), flush=True)
            if control.sess is not None:
                control.close()
            ok_run = True
        finally:
            machine.stop()
            server.stop()
            ports_lock.release()
            link.stop(run_dir)
            report = os.path.join(run_dir, 'relay.json')
            if os.path.exists(report):
                with open(report) as f:
                    r = json.load(f)
                verdict = 'PASS' if r['bad_from_band'] == 0 and r['from_band']['frames'] else 'FAIL'
                results.append(verdict)
                print('%-6s %-5s the fault relay: %d Ethernet frames from the band, %d bad; %d to it'
                      % ('relay', verdict, r['from_band']['frames'], r['bad_from_band'], r['to_band']['frames']))
            link = None
            if ok_run and not a.keep:
                shutil.rmtree(run_dir, ignore_errors=True)
            else:
                kept = run_dir
    except lc.RunHung as e:
        print('tcp-check: HANG: %s' % e, file=sys.stderr)
        return 3
    except lc.RunFailed as e:
        print('tcp-check: %s' % e, file=sys.stderr)
        return 2
    finally:
        if link:
            link.stop()
        if kept:
            print('tcp-check: run files kept in %s' % kept, file=sys.stderr)
    passed = results.count('PASS')
    print('tcp-check: %d of %d passed' % (passed, len(results)))
    return 0 if passed == len(results) else 1


if __name__ == '__main__':
    sys.exit(main())
