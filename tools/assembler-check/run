#!/usr/bin/env python3
"""tools/assembler-check/run: the micro-assembler's checks for revision 14
(tools/assembler-check/README.md).

Usage:
  tools/assembler-check/run --ref UBIN [--ucadr-ref SRC] [--out DIR] [--ports N]
                            [CHECK...] [-- LISPM-CHECK-ARGS...]

CHECK is one of the names in CHECKS below; none means all of them.  The checks
given run at once, each in its own lispm-check run with its own 16 ports from
N on (default 47300), on a copy of this tree's sys/ and site/, planted as the
check says.  Each assembles UCADR (or the bits fixture) on the band with
ua:*word-width* 40. and the check's ua:*hardware-revision*, and the runner
then reads what the assembler wrote.  UBIN holds the release's ucadr.mcr,
.sym, .tbl and .locs, the outputs microcode 2001 must assemble to.  Output in
DIR/CHECK/ (DIR is the tree's run/assembler-check/ unless --out):
lispm-check.out, cases.cases, the outputs, result.txt.  Exit status 0 when
every check given passes.

The microcode UBIN holds is the one rev13 and rev14 assemble: with --ucadr-ref
SRC, a directory laid out as the tree, holding that microcode's sources,
sys/ucadr/'s uc-*.lisp and ucode.lisp, and the files the micro-assembler reads
for the microcode's constants, sys/cold/qcom.lisp and sys/cold/defmic.lisp
(REF_FILES), all of them release-2001's for the release's UBIN, which replace
the tree's in those two checks' copies; without it, the tree's own.  Make it
with `git archive release-2001 sys/ucadr sys/cold | tar -x -C SRC`.  The check
tree assembles the tree's own microcode at revision 14, whatever --ucadr-ref
says.

lispm-check's band, ubin/, quux and ozd are this tree's defaults
(run/check/band.img beside run/check/ubin/, ../muir-sim and ../ozd), since the
copies are not where those defaults are found; LISPM_CHECK_BAND and the
others, or arguments after --, choose others.
"""
import os
import re
import shutil
import struct
import subprocess
import sys
import threading

HERE = os.path.dirname(os.path.abspath(__file__))
TREE = os.path.dirname(os.path.dirname(HERE))
TOOL = os.path.join(TREE, 'tools', 'lispm-check')
OUTPUTS = ('ucadr.mcr', 'ucadr.sym', 'ucadr.tbl', 'ucadr.locs')
# besides sys/ucadr/, the files of --ucadr-ref's tree that the reference
# assembly takes: the micro-assembler reads QCOM and DEFMIC for the
# microcode's constants (sys/sys/sysdcl.lisp, CADR-MICRO-ASSEMBLER), so the
# release's microcode is assembled with the release's, like with like
REF_FILES = (os.path.join('sys', 'cold', 'qcom.lisp'), os.path.join('sys', 'cold', 'defmic.lisp'))

# The checks: the revision assembled, the plant, what the assembly must do
# (None: succeed; a string: be refused with a message containing it), and the
# analysis of what it wrote.
CHECKS = {
    'rev13': dict(rev=13, plant=None, refused=None),
    'rev14': dict(rev=14, plant=None, refused=None),
    'tree': dict(rev=14, plant=None, refused=None),
    'bits': dict(rev=14, plant=None, refused=None),
    'pinned': dict(rev=14, plant='pinned', refused='A-PDL-BUFFER-VIRTUAL-ADDRESS'),
    'map-table': dict(rev=14, plant='map-table', refused='FIX'),
    'map-set': dict(rev=14, plant='map-set', refused='NULL'),
    'lc-shift': dict(rev=14, plant='lc-shift', refused='right shift'),
    'lc-mm': dict(rev=14, plant='lc-mm', refused='arithmetic function'),
    'map-constant': dict(rev=14, plant='map-constant', refused='POINTER-TYPE-REGISTER-0-31'),
    'fiddle': dict(rev=14, plant='fiddle', refused='fiddle'),
    # revision 15 (contract G3 revision 15, 7; appendix A15b.7, A15b.15): the
    # tree's microcode and PROM written in the self-describing .mcr, with the
    # OA select check reporting the words that need a select; the same
    # microcode refused by the check; and the check's rules on a fixture
    'rev15': dict(rev=15, plant=None, refused=None),
    'oa-refused': dict(rev=15, plant=None, refused='OA select check refuses'),
    'oa-select': dict(rev=15, plant=None, refused=None),
}

# The OA select fixture's variants (lisp/oasel.lisp) and the rules of the
# breaches the check must find in each, in address order: control none, each
# other variant its own.
OA_VARIANTS = [('dropped', [1]), ('no-write', [2, 2]), ('return-point', [2]),
               ('misc-entry', [2]), ('n-jump', [2]), ('n-call', [2]), ('n-dispatch', [2]),
               ('return-slot', [1]), ('two-selects', [2, 3]), ('dispatch-select', [3]),
               ('dispatch-write-popj', [3]), ('control', [])]

# Appendix A14.5's 19 types, the pointer-type register's set in microcode 2001
# (contract G3 revision 14, 5.3): the bits words 222 and 223 must hold.
POINTER_TYPES = ['DTP-NULL', 'DTP-SYMBOL', 'DTP-SYMBOL-HEADER', 'DTP-EXTENDED-NUMBER',
                 'DTP-EXTERNAL-VALUE-CELL-POINTER', 'DTP-ONE-Q-FORWARD', 'DTP-HEADER-FORWARD',
                 'DTP-LOCATIVE', 'DTP-LIST', 'DTP-FEF-POINTER', 'DTP-ARRAY-POINTER',
                 'DTP-STACK-GROUP', 'DTP-CLOSURE', 'DTP-SELECT-METHOD', 'DTP-INSTANCE',
                 'DTP-INSTANCE-HEADER', 'DTP-ENTITY', 'DTP-STACK-CLOSURE', 'DTP-SELF-REF-POINTER']


def pointer_type_words():
    """Words 222 and 223 for POINTER_TYPES, numbered by the tree's
    Q-DATA-TYPES (sys/cold/qcom.lisp)."""
    text = open(os.path.join(TREE, 'sys', 'cold', 'qcom.lisp'), 'rb').read().decode('latin-1')
    names = re.search(r'\(DEFCONST Q-DATA-TYPES \'\((.*?)\)\)', text, re.S).group(1).split()
    bits = sum(1 << names.index(t) for t in POINTER_TYPES)
    return bits & 0xffffffff, bits >> 32

UC_FILES = ['UC-PARAMETERS', 'UC-CADR', 'UC-MACROCODE', 'UC-CALL-RETURN',
            'UC-STORAGE-ALLOCATION', 'UC-FCTNS', 'UC-ARRAY', 'UC-LOGICAL', 'UC-ARITH',
            'UC-STRING', 'UC-TRANSPORTER', 'UC-STACK-CLOSURE', 'UC-METER', 'UC-HACKS',
            'UC-TV', 'UC-TRACK-MOUSE', 'UC-PAGE-FAULT', 'UC-DISK', 'UC-INTERRUPT',
            'UC-CHAOS', 'UC-STACK-GROUPS', 'UC-COLD-DISK', 'UC-MC']


def uc_files():
    """The files of sys/ucadr/ucode.lisp's :MICRO-ASSEMBLE, in order; checked
    against UC_FILES, the list the assembly case names."""
    text = open(os.path.join(TREE, 'sys', 'ucadr', 'ucode.lisp'), 'rb').read().decode('latin-1')
    m = re.search(r':MICRO-ASSEMBLE \((.*?)\)\)', text, re.S)
    names = re.findall(r'"([^"]+)"', re.sub(r';[^\r\n]*', '', m.group(1)))
    if names != UC_FILES:
        sys.exit('assembler-check: ucode.lisp lists %s, not UC_FILES' % names)
    return names


# ---------------------------------------------------------------- the plants
# Read and write bytes, as the tree's files may hold bare CRs.

def replace_once(path, old, new, after=None):
    data = open(path, 'rb').read()
    start = data.index(after) if after else 0
    at = data.index(old, start)
    open(path, 'wb').write(data[:at] + new + data[at + len(old):])


def plant(kind, copy):
    uc = os.path.join(copy, 'sys', 'ucadr')
    if kind == 'pinned':
        # a variable inserted before A 430, which moves A-PDL-BUFFER-VIRTUAL-ADDRESS
        # to 431 and A-PDL-BUFFER-HEAD to 432
        replace_once(os.path.join(uc, 'uc-parameters.lisp'), b'A-PDL-BUFFER-VIRTUAL-ADDRESS\t(0)',
                     b'a-planted-y1\t(0)\nA-PDL-BUFFER-VIRTUAL-ADDRESS\t(0)')
    elif kind == 'map-table':
        # D-TRANSPORT's entry for FIX (type 5, not a pointer type) with map bit 1
        # made unlike its entry with map bit 0
        replace_once(os.path.join(uc, 'uc-parameters.lisp'), b'(R-BIT)\t\t\t\t\t;1 FIX',
                     b'(INHIBIT-XCT-NEXT-BIT TRANS-OLD)\t;1 FIX', after=b'\nD-TRANSPORT\n')
    elif kind in ('lc-shift', 'lc-mm'):
        word = {'lc-shift': b'((location-counter) output-selector-rightshift-1 add m-a a-b)',
                'lc-mm': b'((location-counter) m+m m-a)'}[kind]
        path = os.path.join(uc, 'uc-mc.lisp')
        data = open(path, 'rb').read()
        at = data.rindex(b'))')
        open(path, 'wb').write(data[:at] + b'planted-y1\t' + word + b'\n' + data[at:])
    elif kind == 'fiddle':
        # a map-bit dispatch inside force-wr-rdonly's fiddle, between its direct
        # write and its store, where a port-b fill could evict it
        replace_once(os.path.join(uc, 'uc-page-fault.lisp'),
                     b'\t((VMA) A-PGF-VMA)\t\t;Restore original VMA\n\t((MD-START-WRITE) A-PGF-WMD)',
                     b'\t(dispatch transport md)\t;planted-y2\n\t((VMA) A-PGF-VMA)\t\t;Restore original VMA\n\t((MD-START-WRITE) A-PGF-WMD)',
                     after=b'\nFORCE-WR-RDONLY\n\t(CALL PGF-SAVE)\n\t((m-tem) map-entry')
    elif kind in ('map-set', 'map-constant'):
        pass                                # planted in the cases, not in the tree


def copy_tree(dest):
    shutil.rmtree(dest, ignore_errors=True)
    for top in ('sys', 'site'):
        shutil.copytree(os.path.join(TREE, top), os.path.join(dest, top),
                        ignore=shutil.ignore_patterns('ubin'))
    # the assembler writes UCADR's outputs into SYS: UBIN;, which the tree
    # does not carry
    os.makedirs(os.path.join(dest, 'sys', 'ubin'))
    os.makedirs(os.path.join(dest, 'sys', 'assembler-check'))
    shutil.copy2(os.path.join(HERE, 'lisp', 'y1bits.lisp'),
                 os.path.join(dest, 'sys', 'assembler-check', 'y1bits.lisp'))
    for name, text in oasel_files().items():
        with open(os.path.join(dest, 'sys', 'assembler-check', name + '.lisp'), 'w') as f:
            f.write(text)


def oasel_files():
    """lisp/oasel.lisp's variants, each a file oa-VARIANT.lisp for the
    micro-assembler's fast reader: (setq oa-VARIANT '(common variant))."""
    text = open(os.path.join(HERE, 'lisp', 'oasel.lisp')).read()
    parts = re.split(r'^;;; (common|variant \S+)\n', text, flags=re.M)
    head, sections = parts[0], dict(zip(parts[1::2], parts[2::2]))
    files = {}
    for key, body in sections.items():
        if key.startswith('variant '):
            name = 'oa-' + key.split()[1]
            files[name] = '%s(setq %s \'(\n\n%s\n%s))\n' % (head, name, sections['common'], body)
    return files


# ---------------------------------------------------------------- the cases

def assemble_form(version):
    files = ' '.join('"SYS: UCADR; %s LISP"' % f for f in uc_files())
    return ('(let* ((files (mapcar #\'(lambda (name) (send (fs:parse-pathname name) :truename)) '
            "'(%s))) (ua:file-truenames-listified (mapcar #'ua:listify-pathname files)) "
            "(old (symbol-function 'y-or-n-p))) (unwind-protect (progn (fset 'y-or-n-p "
            "#'(lambda (&rest ignore) t)) (ua:assemble-system (send (fs:parse-pathname "
            '"SYS: UBIN; UCADR") :new-version %d.) files nil nil t) t) (fset \'y-or-n-p old)))'
            % (files, version))


def bits_form():
    return ('(let ((*standard-input* (make-string-input-stream "1.")) (old (symbol-function '
            "'y-or-n-p))) (unwind-protect (progn (fset 'y-or-n-p #'(lambda (&rest ignore) t)) "
            '(ua:assemble "SYS: ASSEMBLER-CHECK; Y1BITS LISP") t) (fset \'y-or-n-p old)))')


def prom_form(version):
    return ('(let ((*standard-input* (make-string-input-stream "T %d.")) (old'
            " (symbol-function 'y-or-n-p))) (unwind-protect (progn (fset 'y-or-n-p"
            " #'(lambda (&rest ignore) t)) (ua:assemble \"SYS: UCADR; PROMH TEXT\") t)"
            " (fset 'y-or-n-p old)))" % version)


def oasel_form(variant):
    return ('(let ((*standard-input* '
            '(make-string-input-stream "1.")) (old (symbol-function \'y-or-n-p))) '
            "(unwind-protect (progn (fset 'y-or-n-p #'(lambda (&rest ignore) t)) "
            '(ua:assemble "SYS: ASSEMBLER-CHECK; OA-%s LISP") t) (fset \'y-or-n-p old)))'
            % variant.upper())


# the breaches the OA select check kept, by rule, and the words that rule 1
# refuses (each a word that writes an OA register), octal
BREACHES_FORM = ('(let ((rules (list 0 0 0)) (words nil)) (dolist (b ua:*oa-select-breaches*)'
                 ' (incf (nth (1- (cadr b)) rules)) (when (= (cadr b) 1) (pushnew (car b) words)))'
                 ' (format nil "oa-breaches ~{~D~^ ~}; rule-1 words ~D: ~{~O~^ ~}" rules'
                 " (length words) (sort words #'<)))")


def plant_bit_form(label, bit):
    """The rules of the check's breaches with bit BIT added to the control
    fixture's word at LABEL, the word restored after."""
    return ("(let* ((loc (ua:i-mem-symbol-location 'ua:%s)) (old (aref ua:i-mem loc)))"
            " (setf (aref ua:i-mem loc) (+ old (expt 2 %d.))) (prog1 (mapcar #'cadr"
            " (ua:oa-select-breaches)) (setf (aref ua:i-mem loc) old)))" % (label, bit))


def oa_select_cases():
    lines = ["(progn (make-system 'cadr-micro-assembler :compile :noconfirm :nowarn) t) => T",
             '(setq ua:*word-width* 40.) => 40',
             # the selects are revision 15's names: refused at 14
             '(setq ua:*hardware-revision* 14.) => 14',
             oasel_form('control') + ' =>! revision 15',
             # revision 14's halves, <47:24> and <23:0>, are the loader's as before
             "(let ((w #o7654321012345670)) (equal (multiple-value-list"
             " (ua:control-store-word-halves w)) (list (%logdpb (ldb #o4020 w) #o1020"
             " (ldb #o3010 w)) (%logdpb (ldb #o1020 w) #o1020 (ldb #o0010 w))))) => T",
             '(setq ua:*hardware-revision* 15.) => 15',
             # a breach refuses the assembly
             oasel_form('dropped') + ' =>! OA select check refuses',
             '(setq ua:*oa-select-check-refuses* nil) => NIL']
    for variant, rules in OA_VARIANTS:
        lines.append('(progn %s (mapcar #\'cadr ua:*oa-select-breaches*)) => %s'
                     % (oasel_form(variant), '(%s)' % ' '.join(map(str, rules)) if rules else 'NIL'))
    # the extension's other fields, planted in the control's image (no source
    # names them; the profile pass will set them): a hint with
    # oa-high-select passes, a hint with oa-low-select and the PDL address
    # field with a select are refused
    lines += [plant_bit_form('oa-xh', 48) + ' => NIL',
              plant_bit_form('oa-xl', 48) + ' => (3)',
              plant_bit_form('oa-c1', 48) + ' => (3)',
              # the control's breaches with nothing planted: none
              "(mapcar #'cadr (ua:oa-select-breaches)) => NIL",
              # the loader's reader (sys/sys2/usymld.lisp, read-mcr-sections)
              # reads the control's .mcr back into an image equal to what was
              # assembled, memory by memory: the words that differ
              READ_BACK_FORM + ' => (0 0 0 0)',
              # the loader's control store halves (control-store-word-halves):
              # revision 15's <63:32> and <31:0>, a fixnum each where the
              # world's fixnum holds 32 bits, refused where it does not
              HALVES_FORM + ' => T']
    return '\n'.join(lines) + '\n'


READ_BACK_FORM = (
    "(let ((image (ua:make-ucode-image)) (differ (list 0 0 0 0)))"
    " (with-open-file (s \"SYS: ASSEMBLER-CHECK; OA-CONTROL MCR\" :direction :input :characters nil"
    " :byte-size 16.) (ua:read-mcr-sections s image))"
    " (dotimes (i (array-length ua:i-mem)) (unless (eql (or (aref ua:i-mem i) 0)"
    " (or (aref (ua:ucode-image-control-memory-array image) i) 0)) (incf (first differ))))"
    " (dotimes (i (array-length ua:d-mem)) (unless (eql (or (aref ua:d-mem i) 0)"
    " (or (aref (ua:ucode-image-dispatch-memory-array image) i) 0)) (incf (second differ))))"
    " (dotimes (i (array-length ua:a-mem)) (unless (eql (or (aref ua:a-mem i) 0)"
    " (or (aref (ua:ucode-image-a-memory-array image) i) 0)) (incf (third differ))))"
    " (dotimes (i (array-length ua:micro-code-symbol-image)) (unless (eql"
    " (or (aref ua:micro-code-symbol-image i) 0)"
    " (or (aref (ua:ucode-image-entry-points-array image) i) 0)) (incf (fourth differ))))"
    " differ)")

HALVES_FORM = (
    "(let ((w (+ (expt 2 63.) (expt 2 48.) 5)))"
    " (if (< (haulong most-positive-fixnum) 31.)"
    " (condition-case () (progn (ua:control-store-word-halves w) nil) (error t))"
    " (equal (multiple-value-list (ua:control-store-word-halves w))"
    " (list (%logdpb 1 #o3701 #o200000) 5))))")


def cases(check):
    c = CHECKS[check]
    if check == 'oa-select':
        return oa_select_cases()
    lines = ['; tools/assembler-check: %s' % check,
             "(progn (make-system 'cadr-micro-assembler :compile :noconfirm :nowarn) t) => T",
             '(setq ua:*word-width* 40.) => 40']
    if check == 'bits':
        # revision 13 refuses the names and condition 12; revision 14 assembles them
        lines += ['(setq ua:*hardware-revision* 13.) => 13',
                  bits_form() + ' =>! revision 14',
                  '(setq ua:*hardware-revision* 14.) => 14',
                  bits_form() + ' => T']
        return '\n'.join(lines) + '\n'
    lines.append('(setq ua:*hardware-revision* %d.) => %d' % (c['rev'], c['rev']))
    if check == 'map-constant':
        # word 222's constant made unlike the set, as a stale or hand-written one would be
        lines.append("(progn (putprop 'ua:pointer-type-register-0-31 1 'ua:cons-lap-sym) t) => T")
    if check == 'map-set':
        lines.append("(length (setq ua:*pointer-types* (remove 'dtp-null ua:*pointer-types*))) => 18")
    if check == 'rev15':
        # the breaches are reported and the files written: the tree's
        # microcode has no selects yet
        lines.append('(setq ua:*oa-select-check-refuses* nil) => NIL')
    version = 2002 if c['rev'] == 15 else 2001
    lines.append('(setq ua:version-number %d.) => %d' % (version, version))
    lines.append(assemble_form(version) + (' => T' if c['refused'] is None
                                           else ' =>! %s' % c['refused']))
    if check == 'rev15':
        lines += [BREACHES_FORM, prom_form(version) + ' => T', BREACHES_FORM]
    return '\n'.join(lines) + '\n'


# ---------------------------------------------------------------- the .mcr

def mcr_sections(path):
    """The sections of a .mcr in partition order: a list of (code, start,
    count, data), data the section's words (I-MEM: 48-bit words; A memory at
    40 bits: 40-bit words; a main-memory section: its three header words
    after the code, as start, count and data); and the byte offset where the
    sections end, the A memory section being the last."""
    b = open(path, 'rb').read()
    w = struct.unpack('<%dI' % (len(b) // 4), b[:len(b) // 4 * 4])
    i, out = 0, []
    while i < len(w):
        code, start, count = w[i:i + 3]
        if code == 1:
            out.append((1, start, count, [w[i + 3 + 2 * k] << 32 | w[i + 4 + 2 * k]
                                          for k in range(count)]))
            i += 3 + 2 * count
        elif code == 2:
            out.append((2, start, count, list(w[i + 3:i + 3 + count])))
            i += 3 + count
        elif code == 3:
            out.append((3, start, count, [w[i + 3]]))
            i += 4
        elif code == 5:
            d = w[i + 3:i + 3 + 2 * count]
            out.append((5, start, count, [d[2 * k] | (d[2 * k + 1] & 0o377) << 32
                                          for k in range(count)]))
            return out, 4 * (i + 3 + 2 * count)
        elif code == 6:
            out.append((6, start, count, list(w[i + 3:i + 3 + count])))
            i += 3 + count
        else:
            raise ValueError('section code %o at word %d' % (code, i))
    raise ValueError('no A memory section')


def mcr_symbol_area(path):
    """The main-memory section's words as the file holds them: from its
    relative disk block (1024 bytes a block) to the end of the file."""
    secs, _ = mcr_sections(path)
    block = [s for s in secs if s[0] == 3][0][2]
    return open(path, 'rb').read()[1024 * block:]


def sym_table(path):
    """NAME -> (memory, location) from a .sym file's symbols."""
    syms = {}
    t = open(path, 'rb').read().decode('latin-1').split()
    for k in range(len(t) - 2):
        if t[k + 1] in ('I-MEM', 'A-MEM', 'M-MEM', 'D-MEM') and re.match(r'[0-7]+$', t[k + 2]):
            syms[t[k]] = (t[k + 1], int(t[k + 2], 8))
    return syms


def ir(word, lo, n):
    return word >> lo & ((1 << n) - 1)


def same_sym(a, b):
    """Whether two .sym files hold the same assembler state and the same
    symbols.  The symbols are dumped in the order of the package's hash table
    (docs/building.md, "Assembling the microcode"), which any symbol interned
    in UA moves, so they are compared as a set."""
    def parts(path):
        text = open(path, 'rb').read().decode('latin-1')
        head, _, body = text.partition('\n-2 ')
        return head, sorted(re.findall(r'(\S+) ([IAMD]-MEM) ([0-7]+)', body))
    return parts(a) == parts(b)


def compare_outputs(out, ref, files):
    lines, ok = [], True
    for f in files:
        same = open(os.path.join(out, f), 'rb').read() == open(os.path.join(ref, f), 'rb').read()
        if same:
            lines.append('%s equals the release byte for byte' % f)
        elif f.endswith('.sym') and same_sym(os.path.join(out, f), os.path.join(ref, f)):
            lines.append('%s holds the release\'s state and symbols, in another order' % f)
        else:
            lines.append('%s DIFFERS FROM the release' % f)
            ok = False
    return ok, lines


# The 32-bit world's fixnum tag, DTP-FIX (5) in <29:25>, which release
# 2001's microcode symbol area carries in every word: it was assembled on
# System 2000's 32-bit band, and the .mcr writer then added that world's tag.
# The writer now puts out the value alone for a 40-bit target (main df77f1e,
# sys/sys/qwmcr.lisp), so the symbol area is compared with the release's by
# value, the tag stripped; every other part of the file byte for byte.
TAG_32 = 5 << 25


def symbol_area_values(data):
    """The symbol area's words, little-endian 32-bit, each with the 32-bit
    world's fixnum tag stripped where it carries it."""
    words = struct.unpack('<%dI' % (len(data) // 4), data[:len(data) // 4 * 4])
    return [w - TAG_32 if w & (0o37 << 25) == TAG_32 else w for w in words]


def same_symbol_area(mine, theirs):
    """Whether two .mcr files' symbol areas hold the same values: the tag
    stripped, as many words and each equal; and the words that differ."""
    a, b = symbol_area_values(mine), symbol_area_values(theirs)
    differ = [k for k in range(min(len(a), len(b))) if a[k] != b[k]]
    return len(a) == len(b) and not differ, differ


def symbol_area_control(path, ref_tail):
    """The comparison's planted control: one of PATH's symbol area values
    (the first non-zero word, its value, not its tag) changed by one must
    make the symbol areas differ.  Returns (caught, line)."""
    tail = bytearray(mcr_symbol_area(path))
    words = struct.unpack('<%dI' % (len(tail) // 4), bytes(tail[:len(tail) // 4 * 4]))
    k = next(i for i, w in enumerate(words) if w)
    struct.pack_into('<I', tail, 4 * k, words[k] ^ 1)
    same, _ = same_symbol_area(bytes(tail), ref_tail)
    return not same, ('the control, word %o of the symbol area planted from %o to %o: %s' % (
        k, words[k], words[k] ^ 1, 'caught' if not same else 'NOT CAUGHT'))


def check_rev13(out, ref):
#    return compare_outputs(out, ref, OUTPUTS)
    # ucadr.mcr: up to its symbol area byte for byte, the symbol area by value
    lines = []
    path, rpath = os.path.join(out, 'ucadr.mcr'), os.path.join(ref, 'ucadr.mcr')
    mine, theirs = open(path, 'rb').read(), open(rpath, 'rb').read()
    tail, rtail = mcr_symbol_area(path), mcr_symbol_area(rpath)
    head_same = mine[:len(mine) - len(tail)] == theirs[:len(theirs) - len(rtail)]
    lines.append('ucadr.mcr up to its symbol area %s the release byte for byte' % (
        'equals' if head_same else 'DIFFERS FROM'))
    area_same, differ = same_symbol_area(tail, rtail)
    lines.append('the symbol area %s the release\'s by value, the tag stripped (%d words differ)' % (
        'equals' if area_same else 'DIFFERS FROM', len(differ)))
    caught, line = symbol_area_control(path, rtail)
    lines.append(line)
    good, more = compare_outputs(out, ref, OUTPUTS[1:])
    return head_same and area_same and caught and good, lines + more


def check_rev14(out, ref):
    lines, ok = [], True
    secs, end = mcr_sections(os.path.join(out, 'ucadr.mcr'))
    first = secs[0]
    s6 = first[0] == 6 and first[1] == 0 and first[2] == 1 and first[3] == [14]
    lines.append('first section %s: code %o start %o count %o %s' % (
        'is section 6 = 14' if s6 else 'is NOT section 6 = 14', first[0], first[1], first[2],
        ['%o' % x for x in first[3][:4]]))
    ok &= s6
    sixes = [s for s in secs if s[0] == 6]
    if len(sixes) != 1:
        lines.append('%d sections 6' % len(sixes))
        ok = False
    mine = [s for s in secs if s[0] != 6]
    theirs, _ = mcr_sections(os.path.join(ref, 'ucadr.mcr'))
    for a, b in zip(mine, theirs):
        if a[0] == 3:
            # the main-memory section's relative disk block may move with the
            # four words section 6 adds; its block count and address may not
            same = a[1] == b[1] and a[3] == b[3]
        else:
            same = a == b
        lines.append('section %o %s the release\'s' % (a[0], 'equals' if same else 'DIFFERS FROM'))
        ok &= same
    if [s[0] for s in mine] != [s[0] for s in theirs]:
        lines.append('sections %s, the release %s' % ([s[0] for s in mine], [s[0] for s in theirs]))
        ok = False
    mcr = open(os.path.join(out, 'ucadr.mcr'), 'rb').read()
    tail = mcr_symbol_area(os.path.join(out, 'ucadr.mcr'))
    pad = mcr[end:len(mcr) - len(tail)]
#    same = tail == mcr_symbol_area(os.path.join(ref, 'ucadr.mcr')) and not pad.strip(b'\0')
    # by value, the tag stripped (TAG_32), with its planted control
    rtail = mcr_symbol_area(os.path.join(ref, 'ucadr.mcr'))
    area_same, differ = same_symbol_area(tail, rtail)
    same = area_same and not pad.strip(b'\0')
    lines.append('the symbol area %s the release\'s by value, the tag stripped (%d words differ), the padding before it %d zero bytes' % (
        'equals' if same else 'DIFFERS FROM', len(differ), len(pad)))
    ok &= same
    caught, line = symbol_area_control(os.path.join(out, 'ucadr.mcr'), rtail)
    lines.append(line)
    ok &= caught
    good, more = compare_outputs(out, ref, OUTPUTS[1:])
    return ok and good, lines + more


def check_bits(out):
    """Each word against appendix A14 as muir-sim's revision 14 decodes it:
    a jump's IR<44:43> 1, IR<5> condition mode, IR<4:0> the condition, IR<6>
    inverted, IR<7> N (no xct-next), IR<8> P (call), IR<9> R (popj); the
    write-map operation VMA<33:32> 0 none, 1 direct write, 2 invalidate, 3
    empty, a direct write's entry VMA<29:0>."""
    lines, ok = [], True
    secs = {s[0]: s for s in mcr_sections(os.path.join(out, 'y1bits.mcr'))[0]}
    imem, amem = secs[1][3], secs[5][3]
    syms = sym_table(os.path.join(out, 'y1bits.sym'))
    s6 = 6 in secs and secs[6][3] == [14]
    lines.append('section 6 = 14 %s' % ('present' if s6 else 'MISSING'))
    ok &= s6
    ma, ab = syms['M-A'][1], syms['A-B'][1]
    le = syms['Y1-LE'][1]
    want = {  # name: (inverted, n, p, r)
        'Y1-LE': (0, 1, 0, 0), 'Y1-LE-X': (0, 0, 0, 0), 'Y1-LE-CALL': (0, 1, 1, 0),
        'Y1-LE-POPJ': (0, 1, 0, 1), 'Y1-GT': (1, 1, 0, 0), 'Y1-GT-X': (1, 0, 0, 0),
        'Y1-GT-CALL': (1, 1, 1, 0), 'Y1-GT-POPJ': (1, 1, 0, 1)}
    for name, (inv, n, p, r) in want.items():
        w = imem[syms[name][1]]
        got = (ir(w, 43, 2), ir(w, 5, 1), ir(w, 0, 5), ir(w, 6, 1), ir(w, 7, 1), ir(w, 8, 1),
               ir(w, 9, 1), ir(w, 26, 6), ir(w, 32, 10))
        exp = (1, 1, 0o12, inv, n, p, r, ma, ab)
        good = got == exp and (r or ir(w, 12, 14) == le)
        lines.append('%-11s %016o %s' % (name, w, 'ok' if good else 'WRONG: %s, want %s' % (got, exp)))
        ok &= good
    for name, op in (('Y1-NONE', 0), ('Y1-WRITE', 1), ('Y1-INVAL', 2), ('Y1-EMPTY', 3), ('Y1-BV', 2)):
        w = imem[syms[name][1]]
        v = amem[ir(w, 32, 10)]
        good = v == op << 32
        lines.append('%-11s A %o = %o: operation %d %s' % (name, ir(w, 32, 10), v, v >> 32 & 3,
                                                           'ok' if good else 'WRONG, want %d' % op))
        ok &= good
    for name, want in zip(('Y1-PTR-LO', 'Y1-PTR-HI'), pointer_type_words()):
        w = imem[syms[name][1]]
        v = amem[ir(w, 32, 10)]
        good = v == want
        lines.append('%-11s A %o = %o: %s' % (name, ir(w, 32, 10), v,
                                              'ok' if good else 'WRONG, want %o' % want))
        ok &= good
    for name, length, pos, dest in (('Y1-OP-DPB', 2, 32, 0o23), ('Y1-ENT-DPB', 30, 0, 0o20)):
        w = imem[syms[name][1]]
        got = (ir(w, 43, 2), ir(w, 12, 2), ir(w, 6, 6) + 1, ir(w, 0, 6), ir(w, 19, 5))
        exp = (3, 3, length, pos, dest)
        good = got == exp
        lines.append('%-11s %016o %s' % (name, w, 'ok' if good else 'WRONG: %s, want %s' % (got, exp)))
        ok &= good
    return ok, lines


# ---------------------------------------------------------------- revision 15

# Appendix A15b.7: the format word, MACHINE-ID's signature over format 1; the
# sections in their order, each with the machine's actual width; the
# memories' sizes.
FORMAT_WORD = 0x51550001
SECTIONS_15 = [(6, 32), (1, 64), (2, 18), (3, 40), (4, 40)]
PROM_BASE, PROM_WORDS, DMEM_WORDS, AMEM_WORDS = 0o36000, 0o2000, 0o10000, 0o2000


def parse_15(b, prom=False):
    """The sections of a revision-15 .mcr (appendix A15b.7), {type: (start,
    items)}, or ValueError naming the first thing a loader refuses: a length
    not a whole number of blocks, a format word other than FORMAT_WORD, a
    first section not type 6 or its item not 15, an unknown type, a type twice
    or out of order, an actual width not the machine's, a storage width not a
    multiple of 32 at least the actual width, a non-zero unused header word or
    padding bit, a section past its memory (the microcode's control store at
    or past the PROM, the PROM's own not from its base within its words), a
    section past the file's end, or a non-zero word after the last section."""
    if not b or len(b) % 1024:
        raise ValueError('%d bytes, not a whole number of 1024-byte blocks' % len(b))
    w = struct.unpack('<%dI' % (len(b) // 4), b)
    if w[0] != FORMAT_WORD:
        raise ValueError('format word %08x' % w[0])
    at, rank, out = 2, -1, {}
    for k in range(w[1]):
        if at + 8 > len(w):
            raise ValueError("section %d's header runs past the file's end" % k)
        kind, items, actual, storage, start = w[at:at + 5]
        types = [t for t, _ in SECTIONS_15]
        if kind not in types:
            raise ValueError('section %d: unknown type %d' % (k, kind))
        if k == 0 and kind != 6:
            raise ValueError('the first section is type %d, not 6' % kind)
        r = types.index(kind)
        if r <= rank:
            raise ValueError('type %d twice or out of order' % kind)
        rank = r
        if actual != SECTIONS_15[r][1]:
            raise ValueError('type %d: actual width %d, not %d' % (kind, actual, SECTIONS_15[r][1]))
        if storage == 0 or storage % 32 or storage < actual:
            raise ValueError('type %d: storage width %d' % (kind, storage))
        if any(w[at + 5:at + 8]):
            raise ValueError('type %d: a non-zero unused header word' % kind)
        end = start + items
        if kind == 6 and (start != 0 or items != 1):
            raise ValueError('type 6 at %o for %o items' % (start, items))
        if kind == 1 and not prom and end > PROM_BASE:
            raise ValueError('the control store runs past the PROM, to %o' % end)
        if kind == 1 and prom and (start != PROM_BASE or end > PROM_BASE + PROM_WORDS):
            raise ValueError("the PROM's control store from %o to %o" % (start, end))
        if (kind, end > DMEM_WORDS) == (2, True) or (kind, end > AMEM_WORDS) == (4, True):
            raise ValueError('type %d runs past its memory, to %o' % (kind, end))
        at += 8
        per = storage // 32
        if at + per * items > len(w):
            raise ValueError("type %d's items run past the file's end" % kind)
        vals = []
        for n in range(items):
            v = sum(x << 32 * i for i, x in enumerate(w[at:at + per]))
            at += per
            if v >> actual:
                raise ValueError("type %d's item %o: a padding bit set" % (kind, n))
            vals.append(v)
        out[kind] = (start, vals)
    if any(w[at:]):
        raise ValueError('a non-zero word after the last section')
    if 6 not in out or out[6][1] != [15]:
        raise ValueError('hardware revision %s, not 15' % (out.get(6, (0, None))[1],))
    return out


def malformed_15(b):
    """Planted variants of the good revision-15 .mcr B, one for each refusal
    of appendix A15b.7: (name, bytes)."""
    w = list(struct.unpack('<%dI' % (len(b) // 4), b))
    heads, at = [], 2
    for _ in range(w[1]):
        heads.append(at)
        at += 8 + (w[at + 3] // 32) * w[at + 1]
    h = dict((w[x], x) for x in heads)
    out = []

    def variant(name, edit):
        v = list(w)
        edit(v)
        out.append((name, struct.pack('<%dI' % len(v), *v)))

    variant('format-word', lambda v: v.__setitem__(0, 0x51550002))
    variant('first-not-6', lambda v: v.__setitem__(h[6], 1))
    variant('revision-14', lambda v: v.__setitem__(h[6] + 8, 14))
    variant('unknown-type-5', lambda v: v.__setitem__(h[2], 5))
    variant('unknown-type-7', lambda v: v.__setitem__(h[2], 7))
    variant('type-twice', lambda v: v.__setitem__(h[2], 1))
    variant('order-broken', lambda v: v.__setitem__(h[3], 2))
    variant('actual-width', lambda v: v.__setitem__(h[1] + 2, 48))
    variant('storage-not-32s', lambda v: v.__setitem__(h[2] + 3, 48))
    variant('storage-below-actual', lambda v: v.__setitem__(h[1] + 3, 32))
    variant('padding-bit', lambda v: v.__setitem__(h[4] + 8 + 1, 1 << 8))
    variant('unused-header-word', lambda v: v.__setitem__(h[1] + 6, 1))
    variant('past-memory', lambda v: v.__setitem__(h[2] + 4, 1))
    variant('control-store-into-prom', lambda v: v.__setitem__(h[1] + 4, PROM_BASE - 1))
    variant('word-after-sections', lambda v: v.__setitem__(len(v) - 1, 1))
    out.append(('not-whole-blocks', b[:-4]))
    return out


def check_rev15(out):
    """The tree's microcode and PROM at revision 15: each .mcr parses, every
    malformed variant of it is refused, the extension is zero (no selects
    yet), and the words rule 1 of the OA select check reported are exactly
    the words that write OA-REG-LOW or OA-REG-HIGH (functional destinations
    16 and 17), decoded here from the file."""
    lines, ok = [], True
    text = open(os.path.join(out, 'lispm-check.out')).read()
    reports = re.findall(r'oa-breaches (\d+) (\d+) (\d+); rule-1 words (\d+): ([0-7 ]*)', text)
    for name, prom, report in (('ucadr.mcr', False, reports[0] if reports else None),
                               ('promh.mcr', True, reports[1] if len(reports) > 1 else None)):
        b = open(os.path.join(out, name), 'rb').read()
        try:
            secs = parse_15(b, prom)
        except ValueError as e:
            lines.append('%s REFUSED: %s' % (name, e))
            ok = False
            continue
        start, words = secs[1]
        lines.append('%s parses: sections %s, control store %o-%o, %d bytes' % (
            name, sorted(secs), start, start + len(words), len(b)))
        for vname, vb in malformed_15(b):
            try:
                parse_15(vb, prom)
                lines.append('  planted %s NOT refused' % vname)
                ok = False
            except ValueError as e:
                lines.append('  planted %s refused: %s' % (vname, e))
        ext = [start + i for i, x in enumerate(words) if x >> 48]
        lines.append('  words with an extension: %d' % len(ext))
        ok &= not ext
        writers = sorted(start + i for i, x in enumerate(words)
                         if ir(x, 43, 2) in (0, 3) and ir(x, 25, 1) == 0 and ir(x, 19, 5) in (0o16, 0o17))
        if report is None:
            lines.append('  no OA select report')
            ok = False
            continue
        rules = [int(x) for x in report[:3]]
        reported = sorted(int(x, 8) for x in report[4].split())
        same = reported == writers and rules[1] == rules[2] == 0
        lines.append('  OA select check: breaches by rule %s; rule 1 refuses %d words, the file has '
                     '%d words writing OA-REG-LOW or -HIGH: %s' % (rules, len(reported), len(writers),
                                                                  'the same' if same else 'DIFFERENT'))
        ok &= same
    return ok, lines


def check_oa_select(out):
    """The control fixture's .mcr: it parses, and its selects are the
    extension's <60> and <61> on the words that name them, every other
    extension bit zero."""
    lines, ok = [], True
    try:
        secs = parse_15(open(os.path.join(out, 'oa-control.mcr'), 'rb').read())
    except ValueError as e:
        return False, ['oa-control.mcr REFUSED: %s' % e]
    start, words = secs[1]
    syms = sym_table(os.path.join(out, 'oa-control.sym'))
    want = {'OA-XL': 1 << 60, 'OA-XH': 1 << 61, 'OA-C1': 1 << 61, 'OA-DT-0': 1 << 60,
            'OA-SUB-2': 1 << 60}
    for name, bits in sorted(want.items()):
        x = words[syms[name][1] - start] >> 48 << 48
        good = x == bits
        lines.append('%-9s extension %022o %s' % (name, x, 'ok' if good else 'WRONG, want %o' % bits))
        ok &= good
    sel = sum(1 for x in words if x >> 48)
    lines.append('words with an extension: %d (the control has 8 selects)' % sel)
    ok &= sel == 8
    return ok, lines


# ---------------------------------------------------------------- running

def environment():
    env = dict(os.environ)
    if 'LISPM_CHECK_BAND' not in env:
        env['LISPM_CHECK_BAND'] = os.path.join(TREE, 'run', 'check', 'band.img')
        env.setdefault('LISPM_CHECK_UBIN', os.path.join(TREE, 'run', 'check', 'ubin'))
    env.setdefault('LISPM_CHECK_QUUX', os.path.join(TREE, '..', 'muir-sim', 'target', 'release', 'quux'))
    env.setdefault('LISPM_CHECK_OZD', os.path.join(TREE, '..', 'ozd', 'target', 'release', 'ozd'))
    return env


def check_tree(out, ref):
    """The tree's own microcode at revision 14: it assembled, and its .mcr's
    first section is section 6 = 14, the only one."""
    lines, ok = [], True
    secs, end = mcr_sections(os.path.join(out, 'ucadr.mcr'))
    first = secs[0]
    s6 = first[0] == 6 and first[1] == 0 and first[2] == 1 and first[3] == [14]
    lines.append('first section %s' % ('is section 6 = 14' if s6 else 'is NOT section 6 = 14'))
    sixes = [s for s in secs if s[0] == 6]
    if len(sixes) != 1:
        lines.append('%d sections 6' % len(sixes))
        s6 = False
    return s6, lines


def run_check(check, outdir, ref, port, extra, results, ucadr_ref=None):
    out = os.path.join(outdir, check)
    shutil.rmtree(out, ignore_errors=True)
    os.makedirs(out)
    copy = os.path.join(out, 'tree')
    copy_tree(copy)
    if ucadr_ref and check in ('rev13', 'rev14'):
        # the microcode UBIN was assembled from, in place of the tree's
        ucadr = os.path.join(ucadr_ref, 'sys', 'ucadr')
        for f in os.listdir(ucadr):
            if f.endswith('.lisp'):
                shutil.copy2(os.path.join(ucadr, f), os.path.join(copy, 'sys', 'ucadr', f))
        # and the files the micro-assembler reads for its constants (the
        # CADR-MICRO-ASSEMBLER system, sys/sys/sysdcl.lisp), the release's
        # too: revision 14's qcom.lisp no longer defines the page hash
        # table's names, so release-2001's microcode read with the tree's
        # stopped at an unbound %PHT-MAP-STATUS-META-BITS-ONLY, and a qcom
        # whose area numbers differ changes an A-memory constant
        for f in REF_FILES:
            shutil.copy2(os.path.join(ucadr_ref, f), os.path.join(copy, f))
    plant(CHECKS[check]['plant'], copy)
    cf = os.path.join(out, 'cases.cases')
    open(cf, 'w').write(cases(check))
    env = environment()
    env['LISPM_CHECK_PORTS'] = '%d-%d' % (port, port + 15)
    env['XDG_CACHE_HOME'] = os.path.join(out, 'xdg')
    cmd = [sys.executable, TOOL, '--tree', copy, '--timeout', '3000', '--keep'] + extra + [cf]
    with open(os.path.join(out, 'lispm-check.out'), 'w') as f:
        rc = subprocess.run(cmd, stdout=f, stderr=subprocess.STDOUT, env=env).returncode
    text = open(os.path.join(out, 'lispm-check.out')).read()
    lines = ['lispm-check exit %d' % rc]
    lines += [l for l in text.splitlines() if l.startswith(('PASS', 'FAIL', 'ERROR'))]
    ok = rc == 0
    m = re.search(r'run files kept in (\S+)', text)
    served = os.path.join(m.group(1), 'served', 'sys') if m else None
    try:
        if ok and check in ('rev13', 'rev14', 'tree'):
            for f in OUTPUTS:
                shutil.copy2(os.path.join(served, 'ubin', f), os.path.join(out, f))
            good, more = {'rev13': check_rev13, 'rev14': check_rev14,
                          'tree': check_tree}[check](out, ref)
            ok &= good
            lines += more
        elif ok and check == 'rev15':
            for f in ('ucadr.mcr', 'ucadr.sym'):
                shutil.copy2(os.path.join(served, 'ubin', f), os.path.join(out, f))
            for f in ('promh.mcr', 'promh.sym'):
                shutil.copy2(os.path.join(served, 'ucadr', f), os.path.join(out, f))
            good, more = check_rev15(out)
            ok &= good
            lines += more
        elif ok and check == 'oa-select':
            for f in ('oa-control.mcr', 'oa-control.sym'):
                shutil.copy2(os.path.join(served, 'assembler-check', f), os.path.join(out, f))
            good, more = check_oa_select(out)
            ok &= good
            lines += more
        elif ok and check == 'bits':
            for f in ('y1bits.mcr', 'y1bits.sym'):
                shutil.copy2(os.path.join(served, 'assembler-check', f), os.path.join(out, f))
            good, more = check_bits(out)
            ok &= good
            lines += more
    except (OSError, ValueError, KeyError, IndexError) as e:
        lines.append('analysis failed: %r' % (e,))
        ok = False
    lines.append('%s %s' % (check.upper(), 'PASS' if ok else 'FAIL'))
    open(os.path.join(out, 'result.txt'), 'w').write('\n'.join(lines) + '\n')
    results[check] = ok


def main(argv):
    extra = []
    if '--' in argv:
        extra = argv[argv.index('--') + 1:]
        argv = argv[:argv.index('--')]
    outdir, ref, port, checks = os.path.join(TREE, 'run', 'assembler-check'), None, 47300, []
    ucadr_ref = None
    while argv:
        a = argv.pop(0)
        if a == '--out':
            outdir = os.path.abspath(argv.pop(0))
        elif a == '--ref':
            ref = os.path.abspath(argv.pop(0))
        elif a == '--ucadr-ref':
            ucadr_ref = os.path.abspath(argv.pop(0))
            # a tree's layout, sys/ucadr/ and REF_FILES; a bare directory of
            # uc-*.lisp files, the earlier form, is refused rather than taken
            # with the tree's constants
            missing = [f for f in [os.path.join('sys', 'ucadr', 'ucode.lisp')] + list(REF_FILES)
                       if not os.path.isfile(os.path.join(ucadr_ref, f))]
            if missing:
                sys.exit('assembler-check: --ucadr-ref %s lacks %s\n' % (ucadr_ref, ', '.join(missing))
                         + __doc__)
        elif a == '--ports':
            port = int(argv.pop(0))
        elif a in CHECKS:
            checks.append(a)
        else:
            sys.exit(__doc__)
    if ref is None:
        sys.exit('assembler-check: --ref UBIN, the release\'s ucadr outputs, is needed\n' + __doc__)
    uc_files()
    checks = checks or list(CHECKS)
    results, threads = {}, []
    for k, check in enumerate(checks):
        t = threading.Thread(target=run_check,
                             args=(check, outdir, ref, port + 16 * k, extra, results, ucadr_ref))
        t.start()
        threads.append(t)
    for t in threads:
        t.join()
    for check in checks:
        print('%-10s %s' % (check, 'PASS' if results.get(check) else 'FAIL'))
        sys.stdout.write(open(os.path.join(outdir, check, 'result.txt')).read())
    return 0 if all(results.get(c) for c in checks) else 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
