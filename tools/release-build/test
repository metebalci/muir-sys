class Fixtures(Scratch):
    """The date check's fixtures carry their meaning in their mtimes alone."""

    def test_written_with_mtimes(self):
        d = self.path('q12d')
        rb.write_date_fixtures(d)
        self.assertEqual(rb.check_date_fixtures(d), [])
        self.assertEqual(len(os.listdir(d)), len(rb.DATE_FIXTURES))

    def test_planted_copy_without_mtimes(self):
        d, e = self.path('q12d'), self.path('copy')
        rb.write_date_fixtures(d)
        shutil.copytree(d, e, copy_function=shutil.copy)   # as cp -r copies
        problems = rb.check_date_fixtures(e)
        # y2099's mtime is in the future and today's is not 0, so every one differs
        self.assertEqual(len(problems), len(rb.DATE_FIXTURES), problems)

    def test_planted_one_touched(self):
        d = self.path('q12d')
        rb.write_date_fixtures(d)
        os.utime(os.path.join(d, 'jul.text'))
        problems = rb.check_date_fixtures(d)
        self.assertEqual(len(problems), 1)
        self.assertIn('jul', problems[0])

    def test_planted_one_missing(self):
        d = self.path('q12d')
        rb.write_date_fixtures(d)
        os.remove(os.path.join(d, 'oct25b.text'))
        problems = rb.check_date_fixtures(d)
        self.assertEqual(len(problems), 1)
        self.assertIn('oct25b', problems[0])

    def test_cases_from_table(self):
        for site in ('berlin', 'm1'):
            text = rb.dates_cases(site)
            for name, t in rb.DATE_FIXTURES:
                self.assertIn('(- (q12-listed-date "%s") %d) => 0' % (name, t + rb.UT), text)
                self.assertIn('(q12-set-date "%s" %d)' % (name, t + rb.UT), text)


class Assembly(Scratch):
    def files(self, d, flip=None):
        os.makedirs(d)
        for i, n in enumerate(rb.UCADR_FILES):
            b = bytearray(bytes([i]) * 64)
            if n == flip:
                b[17] ^= 1
            open(os.path.join(d, n), 'wb').write(b)

    def test_same_twice(self):
        self.files(self.path('a'))
        self.files(self.path('b'))
        self.assertEqual(rb.compare_files(self.path('a'), self.path('b'), rb.UCADR_FILES), [])

    def test_planted_second_differs(self):
        self.files(self.path('a'))
        self.files(self.path('b'), flip='ucadr.mcr')
        self.assertEqual(rb.compare_files(self.path('a'), self.path('b'), rb.UCADR_FILES), ['ucadr.mcr'])

    def test_planted_missing(self):
        self.files(self.path('a'))
        self.files(self.path('b'))
        os.remove(self.path('b', 'ucadr.tbl'))
        self.assertEqual(rb.compare_files(self.path('a'), self.path('b'), rb.UCADR_FILES), ['ucadr.tbl'])

    def test_notes_digests(self):
        # the last digests the notes give are the release's (docs/release-1003.md)
        d = rb.notes_digests(os.path.join(REPO, 'docs', 'release-1003.md'))
        self.assertEqual(d['ucadr.mcr'], '180d8cd8435b48bacfbd7c32e94613ccbbd7959df051127be0aa0ff0c7ab957d')
        self.assertEqual(d['ucadr.tbl'], 'd870bd9e798c695b8613bd74d00c688f7c6e1e1b81ffeb6a13445873f0df680e')
        self.assertEqual(d['ucadr.locs'], '418d687365d0587f46c7d0c143faedaad41a7cea3644cd511f148c7deb9f43d0')

    def test_planted_notes_without_digest(self):
        p = self.path('notes.md')
        open(p, 'w').write('- `ucadr.mcr` `%s`\n- `ucadr.tbl` `%s`\n' % ('a' * 64, 'b' * 64))
        with self.assertRaises(rb.Fault) as c:
            rb.notes_digests(p)
        self.assertIn('ucadr.locs', str(c.exception))

    def test_planted_digest_differs(self):
        self.files(self.path('a'))
        want = {n: rb.sha256_file(self.path('a', n)) for n in ('ucadr.mcr', 'ucadr.tbl', 'ucadr.locs')}
        self.assertEqual(rb.digest_mismatches(self.path('a'), want), [])
        want['ucadr.tbl'] = 'c' * 64
        self.assertEqual([m[0] for m in rb.digest_mismatches(self.path('a'), want)], ['ucadr.tbl'])


class Sources(Scratch):
    def ubin(self, n=None):
        u = self.path('ubin')
        os.makedirs(u)
        for name in rb.UBIN_FILES[:n]:
            open(os.path.join(u, name), 'wb').write(name.encode() * 3)
        return u

    def test_tarball(self):
        out = self.path('release-1003-sys.tar.gz')
        rb.make_sources(REPO, 'HEAD', self.ubin(), out, 'release-1003')
        self.assertEqual(rb.check_sources(out, 'release-1003'), [])
        raw = open(out, 'rb').read(10)
        self.assertEqual(raw[3], 0)                          # no name, no flags
        self.assertEqual(raw[4:8], bytes(4))                 # no date

    def test_reproducible(self):
        u = self.ubin()
        a, b = self.path('a.tar.gz'), self.path('b.tar.gz')
        rb.make_sources(REPO, 'HEAD', u, a, 'release-1003')
        time.sleep(1.1)
        rb.make_sources(REPO, 'HEAD', u, b, 'release-1003')
        self.assertEqual(rb.sha256_file(a), rb.sha256_file(b))

    def planted(self, add):
        out = self.path('bad.tar.gz')
        tar = self.path('bad.tar')
        a = subprocess.run(['git', '-C', REPO, 'archive', '--format=tar', '--prefix=release-1003/', 'HEAD'],
                           check=True, capture_output=True).stdout
        open(tar, 'wb').write(a)
        with tarfile.open(tar, 'a') as t:
            add(t)
        rb.gzip_file(tar, out)
        return rb.check_sources(out, 'release-1003')

    def test_planted_owner(self):
        u = self.ubin()
        p = self.planted(lambda t: t.add(u, arcname='release-1003/sys/ubin'))   # no root filter
        if os.getuid() == 0:
            self.skipTest('run as root: the files are root\'s')
        self.assertTrue(any('owner' in x for x in p), p)

    def test_planted_coldrun(self):
        u = self.ubin()
        c = self.path('coldrun.lisp')
        open(c, 'w').write('(si:qld)\n')
        def add(t):
            t.add(u, arcname='release-1003/sys/ubin', filter=rb.root_owned)
            t.add(c, arcname='release-1003/site/coldrun.lisp', filter=rb.root_owned)
        p = self.planted(add)
        self.assertTrue(any('coldrun' in x for x in p), p)

    def test_planted_ubin_short(self):
        u = self.ubin(9)
        p = self.planted(lambda t: t.add(u, arcname='release-1003/sys/ubin', filter=rb.root_owned))
        self.assertTrue(any('sys/ubin' in x for x in p), p)

    def test_planted_top(self):
        u = self.ubin()
        out = self.path('x.tar.gz')
        rb.make_sources(REPO, 'HEAD', u, out, 'release-1004')
        self.assertTrue(rb.check_sources(out, 'release-1003'))


def diskpack_bin():
    p = os.environ.get('RELEASE_BUILD_DISKPACK') or shutil.which('diskpack')
    return p if p and os.access(p, os.X_OK) else None


@unittest.skipUnless(diskpack_bin(), 'no diskpack: set RELEASE_BUILD_DISKPACK to muir-sim\'s')
class ReleasePack(Scratch):
    def setUp(self):
        super().setUp()
        self.dp = diskpack_bin()
        self.build = self.path('build.img')
        dp = lambda *a: subprocess.run([self.dp, self.build, *a], check=True, capture_output=True)
        dp('initialize')
        band = self.path('band.bin')
        open(band, 'wb').write(bytes(range(256)) * 4 * 300)        # 300 blocks of a pretend band
        dp('load', 'LOD4', band)
        # a microcode file diskpack takes: two control-store words and one
        # A-memory word (muir-sim src/mcr.rs, parse)
        w = lambda x: struct.pack('<HH', x >> 16, x & 0xffff)
        self.mcr = self.path('ucadr.mcr')
        open(self.mcr, 'wb').write(w(1) + w(0) + w(2) + struct.pack('<4H', 0, 1, 2, 3)
                                   + struct.pack('<4H', 0, 4, 5, 6) + w(4) + w(0) + w(1) + w(7))

    def test_pack(self):
        out = self.path('release-1003-pack.img')
        rb.write_release_pack(self.dp, self.build, 'LOD4', self.mcr, out, 1003, 1001)
        self.assertEqual(rb.check_release_pack(self.dp, out, self.build, 'LOD4', self.mcr), [])
        label = subprocess.run([self.dp, out, 'show'], check=True, capture_output=True, text=True).stdout
        self.assertIn('"UCADR 1001"', label)
        self.assertIn('"Exp 1003"', label)
        # the partitions are where read_region reads them: diskpack's own dump agrees
        parts = rb.partitions(self.dp, out)
        dump = self.path('lod1.bin')
        subprocess.run([self.dp, out, 'dump', 'LOD1', dump], check=True, capture_output=True)
        self.assertEqual(open(dump, 'rb').read(), rb.read_region(out, *parts['LOD1'][:2]))

    def test_planted_mcr_differs(self):
        out = self.path('release-1003-pack.img')
        rb.write_release_pack(self.dp, self.build, 'LOD4', self.mcr, out, 1003, 1001)
        parts = rb.partitions(self.dp, out)
        os.chmod(out, 0o644)
        with open(out, 'r+b') as f:
            f.seek(parts['MCR1'][0] * rb.BLOCK + 2)
            f.write(b'\x55')
        p = rb.check_release_pack(self.dp, out, self.build, 'LOD4', self.mcr)
        self.assertTrue(any('MCR1' in x for x in p), p)

    def test_planted_byte_outside(self):
        out = self.path('release-1003-pack.img')
        rb.write_release_pack(self.dp, self.build, 'LOD4', self.mcr, out, 1003, 1001)
        parts = rb.partitions(self.dp, out)
        os.chmod(out, 0o644)
        with open(out, 'r+b') as f:
            f.seek(parts['LOD2'][0] * rb.BLOCK + 5000)
            f.write(b'\x01')
        p = rb.check_release_pack(self.dp, out, self.build, 'LOD4', self.mcr)
        self.assertTrue(any('LOD2' in x for x in p), p)

    def test_planted_band_differs(self):
        out = self.path('release-1003-pack.img')
        rb.write_release_pack(self.dp, self.build, 'LOD4', self.mcr, out, 1003, 1001)
        parts = rb.partitions(self.dp, out)
        os.chmod(out, 0o644)
        with open(out, 'r+b') as f:
            f.seek(parts['LOD1'][0] * rb.BLOCK + 3)
            f.write(b'\xff')
        p = rb.check_release_pack(self.dp, out, self.build, 'LOD4', self.mcr)
        self.assertTrue(any('LOD1' in x for x in p), p)


SYSDCL = '''(DEFCONST COLD-LOAD-FILE-LIST
  '("SYS: SYS; QRAND QFASL >"
;   "SYS: SYS; GONE QFASL >"
    "SYS: SYS2; STRING QFASL >"))
'''


class GatesLog(Scratch):
    def log(self, after):
        before = ['2026-10-03T20:34:26Z 177201 (LISPM-1) read /sys/sys/qrand.qfasl']
        text = '\n'.join(before) + '\n'
        off = len(text)
        return (text + '\n'.join(after) + '\n').encode(), off

    OK = ['2026-10-03T23:52:56Z MINI from 177201 (LISPM-1) read /sys/sys/qrand.qfasl',
          '2026-10-03T23:52:56Z MINI from 177201 (LISPM-1) report: qld-complete',
          '2026-10-03T23:52:56Z MINI from 177201 (LISPM-1) report: script-ends']

    def test_pass(self):
        log, off = self.log([l for l in self.OK if ' read ' not in l])
        g = rb.gates_from_log(log, off, SYSDCL)
        self.assertEqual([v[1] for v in g], [True, True], g)

    def test_planted_read_again(self):
        log, off = self.log(['2026-10-04T00:00:00Z 177201 (LISPM-1) read /sys/sys2/string.qfasl'] + self.OK[1:])
        g = dict((v[0], v) for v in rb.gates_from_log(log, off, SYSDCL))
        self.assertFalse(g['G1'][1])
        self.assertIn('string.qfasl', g['G1'][2])

    def test_planted_readtable_again(self):
        log, off = self.log(['2026-10-04T00:00:00Z 177201 (LISPM-1) read /sys/io/crdtbl.qfasl'] + self.OK[1:])
        self.assertFalse(dict((v[0], v) for v in rb.gates_from_log(log, off, SYSDCL))['G1'][1])

    def test_commented_file_not_watched(self):
        log, off = self.log(['2026-10-04T00:00:00Z 177201 (LISPM-1) read /sys/sys/gone.qfasl'] + self.OK[1:])
        self.assertTrue(dict((v[0], v) for v in rb.gates_from_log(log, off, SYSDCL))['G1'][1])

    def test_planted_no_script_end(self):
        log, off = self.log(self.OK[1:2])
        self.assertFalse(dict((v[0], v) for v in rb.gates_from_log(log, off, SYSDCL))['G2'][1])


