class Arithmetic(unittest.TestCase):
    DIV = 'TRUNCATE 7 -2 -3 1\nFLOOR 7 -2 -4 -1\nCEILING 7 -2 -3 1\nDIV 6 -4 -3 2\nTRUNCATE 1 0 ERR\nDIV 0 0 0 1\ndone\n'
    ARITH = ('* 3 -7 => (-21)\nTRUNCATE 7 -2 => (-3 1)\nREM 7 -2 => (1)\n'
             'GCD 1237940039285380274899124224 -2147483648 => (2147483648)\n'
             'REM 1 0 => (ERROR "called with only 2 arguments")\ndone\n')

    def test_div(self):
        ok, why = rb.verify_div(self.DIV)
        self.assertTrue(ok, why)
        self.assertIn('DIV 0 0', why)             # the listed fault, (%div 0 0) is 0

    def test_planted_div_wrong(self):
        ok, why = rb.verify_div(self.DIV.replace('FLOOR 7 -2 -4 -1', 'FLOOR 7 -2 -3 1'))
        self.assertFalse(ok, why)

    def test_planted_div_zero_divisor(self):
        # only (%div 0 0) is the listed fault; any other answer to a zero divisor fails
        ok, why = rb.verify_div(self.DIV.replace('TRUNCATE 1 0 ERR', 'TRUNCATE 1 0 0 1'))
        self.assertFalse(ok, why)

    def test_planted_div_no_done(self):
        ok, why = rb.verify_div(self.DIV.replace('done\n', ''))
        self.assertFalse(ok, why)

    def test_arith(self):
        ok, why = rb.verify_arith(self.ARITH)
        self.assertTrue(ok, why)

    def test_planted_gcd_negative(self):
        ok, why = rb.verify_arith(self.ARITH.replace('=> (2147483648)', '=> (-2147483648)'))
        self.assertFalse(ok, why)


class MachineStart(Scratch):
    """A machine whose ozd finds its port taken is started again."""

    def bins(self, ozd_body):
        b = {}
        for name, body in (('ozd', ozd_body), ('cadr', 'while read l; do [ "$l" = quit ] && exit 0; done'), ('diskpack', 'exit 0')):
            p = self.path(name)
            open(p, 'w').write('#!/bin/sh\n' + body + '\n')
            os.chmod(p, 0o755)
            b[name] = p
        return b

    def test_retry_on_address_in_use(self):
        # the first start finds the port taken, the second does not
        flag = self.path('once')
        b = self.bins('if [ ! -e %s ]; then touch %s; echo "ozd: --tcp 127.0.0.1:1: Address already in use '
                      '(os error 98)"; exit 1; fi; exec sleep 30' % (flag, flag))
        m = rb.Machine(self.path('m'), b, (52990, 52993), self.d)
        try:
            m.start(tries=3, settle=0.5)
            self.assertIsNone(m.ozd.poll())
        finally:
            m.stop()
        self.assertEqual(open(self.path('m', 'ozd.log')).read().count('Address already in use'), 1)

    def test_other_failure_not_retried(self):
        b = self.bins('echo "ozd: no such root"; exit 1')
        m = rb.Machine(self.path('m'), b, (52990, 52993), self.d)
        with self.assertRaises(rb.Fault) as c:
            m.start(tries=3, settle=0.5)
        self.assertIn('no such root', str(c.exception))

    def test_port_stays_taken(self):
        b = self.bins('echo "Address already in use"; exit 1')
        m = rb.Machine(self.path('m'), b, (52990, 52993), self.d)
        with self.assertRaises(rb.Fault) as c:
            m.start(tries=2, settle=0.5)
        self.assertIn('stayed in use', str(c.exception))


