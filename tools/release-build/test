#!/usr/bin/env python3
"""The tests of tools/release-build/run: its parts, each on a fault planted.

Usage:
  tools/release-build/test [-v] [NAME...]

Each test runs one part of the builder on a small input and checks that it
passes when the input is right and fails, naming the fault, when one fault
is planted: a tree with no sys/ubin/, a date fixture that lost its mtime, a
second assembly of the microcode that differs from the first, a sources
tarball member that is not root's, a release pack with a byte outside its
two partitions, a cold-load file read again after the cold boot, a loaded id
an hour off, a wrong quotient.  They take seconds and boot no machine; the
release pack's test needs muir-sim's diskpack (RELEASE_BUILD_DISKPACK, or
diskpack on PATH) and is skipped, saying so, without it.  The sources test
exports this repository's HEAD.  Exit status 0 when every test passes.
"""
import gzip, importlib.machinery, importlib.util, io, os, shutil, socket
import struct, subprocess, sys, tarfile, tempfile, time, unittest

# no __pycache__ beside the tool: it would carry local paths into the tree
sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(os.path.dirname(HERE))


def load_builder():
    loader = importlib.machinery.SourceFileLoader('release_build', os.path.join(HERE, 'run'))
    spec = importlib.util.spec_from_loader('release_build', loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


rb = load_builder()


class Scratch(unittest.TestCase):
    def setUp(self):
        self.d = tempfile.mkdtemp(prefix='release-build-test-')

    def tearDown(self):
        shutil.rmtree(self.d, ignore_errors=True)

    def path(self, *p):
        return os.path.join(self.d, *p)


