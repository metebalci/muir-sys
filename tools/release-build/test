class Ports(Scratch):
    def test_plan_disjoint(self):
        plan = rb.port_plan(51000, 51999)
        seen = set()
        for name, (lo, hi) in plan.items():
            r = set(range(lo, hi + 1))
            self.assertFalse(r & seen, name)
            seen |= r
            self.assertTrue(51000 <= lo <= hi <= 51999, name)

    def test_plan_too_small(self):
        with self.assertRaises(rb.Fault):
            rb.port_plan(51000, 51100)

    def test_busy_port_found(self):
        s = socket.socket()
        s.bind(('127.0.0.1', 0))
        s.listen(1)
        port = s.getsockname()[1]
        try:
            self.assertIn(port, rb.busy_ports(port - 2, port + 2))
        finally:
            s.close()


