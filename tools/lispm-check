#!/usr/bin/env python3
"""lispm-check: check a Lisp change on a band in seconds.

Usage:
  tools/lispm-check [--band PACK] [--quux PATH | --cadr PATH] [--ozd PATH]
                    [--ubin DIR] [--tree DIR] [--files a.lisp,b.lisp]
                    [--compile] [--file-server auto|device|ozd]
                    [--engine micro|rtl] [--timeout S] [--setup-limit S] [--keep]
                    [--ozd-file-dates mit|utc] [--ozd-timezone N]
                    [--network chaos|tcp] CASES

The band runs on the simulator's executable for this line's system, MACHINE
below: quux on main, QUUX's system (--quux), and cadr on the cadr branch, the
CADR's (--cadr; --quux is taken there too, as the same flag, so that one
command line serves both lines).  MACHINE is the one line of this file that
differs between the two lines; "the machine" below is that executable.

It resumes a checkpoint of the band booted to its TELNET prompt, lays the
changed files over a private copy of the tree, loads them (or compiles them
with qc-file and loads the QFASLs, with --compile), runs every case of CASES in
one session and prints one line per case.  The first run for a band and a
build of the machine boots the band cold and writes the checkpoint (about
15 s); later runs resume it: about 0.6 s with no files, 0.13 s a case, about
0.8 s to load a small file and 1.7 s to compile and load it, and as long as
qc-file takes for a large one (half a minute for sys/io1/time.lisp), the same
with either file server.

CASES holds one case per form; a form may run over several lines.  Blank lines
and lines starting with ; are skipped.  After the form, on its last line:
  FORM                    passes unless it signals an error
  FORM => TEXT            passes if the value, printed with prin1, is TEXT
  FORM =>!                passes only if it signals an error
  FORM =>! TEXT           ... an error whose message contains TEXT
Forms are read by the listener: base 10, traditional syntax, where / escapes,
so a slash inside a string is written twice.  A value is compared with its
whitespace runs collapsed to one space.  Each form runs inside a
condition-case, so an error is reported by its message and the listener goes
on with the next case; a form must not read from the terminal.  One that asks
a question through FQUERY (Y-OR-N-P, YES-OR-NO-P and FQUERY itself) fails at
once, naming the question, and the form ends there.  Failing that, a bare
"(Y or N)" or "(Yes or No)" at the end of what the case printed fails it too,
and is answered No; the next case waits for that form to end.

Output, one line per case, then a summary:
  PASS  FORM  -> VALUE
  FAIL  FORM  -> VALUE, expected TEXT
  FAIL  FORM  -> asked QUESTION, the form ended there
  FAIL  FORM  -> asked QUESTION, answered No
  ERROR  FORM  -> the error's message
Before them, a FILE line for each file, and a WARN line for each line the
compiler or the loader printed about it.
Exit status: 0 if every case passes, 1 if any fails or errors, 2 if the run
itself failed (bad arguments, a boot, a file that would not load or compile,
where a compiler heading "<< Error ..." counts as not compiling, or a case
that did not answer within --timeout), 3 if the machine hung in the setup's
cold boot (or the probe's): stopped, with no CPU time for 60 s, or running
without answering until --setup-limit (1800 s), the hard limit on the setup's
wall clock, within which it waits as long as the machine runs, however loaded
the host.  A failed run keeps its run directory (TELNET, the machine's and
ozd's logs) under the cache and says where; --keep keeps it always.

--files takes paths, comma separated.  A file inside the tree's sys/ is served
at its own place and loaded by its logical name (sys/io1/time.lisp as
"SYS: IO1; TIME LISP"), so the world sees the same source file; any other file
is served in the login's home directory (OZ: /lispm/, or /home/lispm/ on the
file device's pathname host, HOST: or FILES: as the band names it).
The tree itself is never written:
the machine is served a copy under the cache, so QFASLs land there.  Some sys
files do not load as source, since they use functions only the compiler opens
(sys/io1/time.lisp: "The function %PUSH is undefined"); check those with
--compile.

Defaults, each overridden by its flag or an environment variable:
  --band  LISPM_CHECK_BAND  run/check/band.img in the tree: a band of this
                            line's system (docs/lispm-check.md says which)
  --ubin  LISPM_CHECK_UBIN  ubin/ beside the band: the sys/ubin/ the band's
                            microcode was assembled into; the cold boot reads
                            its ucadr.tbl
  --quux  LISPM_CHECK_QUUX  on main: ../muir-sim/target/release/quux beside
                            the tree
  --cadr  LISPM_CHECK_CADR  on cadr: ../muir-sim/target/release/cadr beside
                            the tree
  --ozd   LISPM_CHECK_OZD   ../ozd/target/release/ozd beside the tree
  --tree  LISPM_CHECK_TREE  the tree this tool is in
  --file-server  LISPM_CHECK_FILE_SERVER  auto: see below
  --engine  LISPM_CHECK_ENGINE  micro: the machine's engine, passed to it as
                            --micro or --rtl; any other value is refused
  --ozd-file-dates  LISPM_CHECK_OZD_FILE_DATES  none given: ozd's own default
  --ozd-timezone    LISPM_CHECK_OZD_TIMEZONE    none given: ozd's own default
  --network LISPM_CHECK_NETWORK  tcp on revision 16, chaos on revisions 13-15
                            and the CADR: what carries the TELNET session,
                            below
  LISPM_CHECK_PORTS         the port range it picks from, 44000-44999
  LISPM_CHECK_TAPS          the tap indexes it picks from, as N, LO-HI or a
                            comma-separated list of them: the pool's host-only
                            taps, those with a /30 of their own
  LISPM_CHECK_RELAY_FLAGS   the fault relay's fault flags (--loss and the
                            rest, tools/fault-relay/README.md): none
  cache                     $XDG_CACHE_HOME/muir-sys-check (~/.cache/...)
The band is opened read-only (,ro) and never written: a boot's writes live in
the checkpoint, so any number of checks, also at once, resume one checkpoint
on one band.  A checkpoint is keyed by the band's and the machine's sha256,
the file server and the engine, and made again when one changes: the machine
resumes a checkpoint only on the engine that wrote it.  Every run takes four
free ports of its own (ozd's UDP, the machine's UDP, TELNET and the machine's
RFB) under a lock, so parallel runs never meet, and it stops everything it
started before it exits.

The copy is served the way the band reads its SYS: files.  With
--file-server ozd, by ozd (the class OzdFileServer), for a band whose SYS: is
on OZ; the setup logs in to OZ.  With --file-server device, by quux's own file
device (DeviceFileServer), for a band whose SYS: is on the file device's
pathname host, which a band names HOST (Systems 2000 and 2001, and the bands
of 2002 built before the name changed) or FILES (after it): quux mounts the
copy as that host's / (--file-root), ozd serves no file and is only the
TELNET gateway, and the setup logs in to the host the band named.  The file
device serves either name alike, its paths carrying no host.  The file device
is QUUX's: cadr has none, so on the cadr line the files are always served by
ozd.  A band boots to
its prompt only with its SYS: host served.  auto, the default, takes the host
the band's SYS: is on from a checkpoint of this band and machine (its setup
asked the band), else from the answers remembered under the cache, else from a
probe (a cold boot with the copy served both ways, about 15 s, once for each
band and machine); a machine without a file device means ozd.  Every run says
which it chose and why.  A setup checks that the band's SYS: is on a host the
chosen server serves, and keeps the band's answer in the checkpoint, from
which every check takes the host it names files on.  Everything that knows
how the tree is served is in these classes.

--ozd-file-dates mit|utc and --ozd-timezone N are passed to ozd as its
--file-dates and --timezone: how FILE writes and reads its dates.  ozd's
default is utc, plain UTC, as Systems 1002 and 2000 read them; a band of
Systems 100 to 1001 reads them at its site's zone, so it wants
--ozd-file-dates mit --ozd-timezone <that zone> (-1 for System 1001's
release band, 5 for System 100's site), or every file date it reads is off by
the zone's offset.  ozd refuses a zone under utc, and so does this tool.  The
flags change only what ozd serves, not the checkpoint, whose setup reads no
file.

The network (QUUX's Ethernet contract, sections 3, 7 and 8 R1).  On QUUX's
revision 16, which has the Ethernet device, every run takes a tap of the
pool (muir-sim's tools/quux-taps) through the fault relay
(tools/fault-relay/relay) and gives the machine its addresses, so that the
band always has its link: --ethernet-socket, --ip-address and --ip-gateway,
at the setup and at every resume.  The taps tried are those of
LISPM_CHECK_TAPS whose index already has a checkpoint for this key, lowest
first, then the rest, lowest first; a tap held by another run is passed for
the next, and when all are held it waits for one, up to --setup-limit.  The
tap is the lock: a band uses index N's address only while its run holds tap
N.  A checkpoint is made for each tap index on its first use, and its key
names QUUX's address behind that tap, since muir refuses a resume under other
addresses.  Revision 15 and the CADR take no tap, and their keys are as
before.  The revision is asked of the machine once for each build (and
MUIR_QUUX_REVISION), and remembered under the cache.
  --network chaos   ozd's TCP gateway carries the session to the band's
                    Chaos TELNET server, the band's cable being --chaos-udp
                    to ozd: the default on revisions 13-15 and the CADR
  --network tcp     the session is the build host's own TCP, from a socket
                    bound to the tap, to the band's TELNET server on port 23
                    at QUUX's address; the machine is given no Chaos peer at
                    all, and ozd is not started.  It needs revision 16, and a
                    band whose SYS: is on the file device's host, HOST or
                    FILES (--file-server device; auto then means device).
                    At the end of a setup it half-closes the session and
                    reads to the band's EOF, which the band's server sends
                    at the client's EOF, then waits 0.5 s for the last ACK,
                    so that the checkpoint holds no connection; a setup
                    whose band does not close is a failed run.  The default
                    on revision 16 (the contract, section 8 R2), so a run
                    there starts no ozd unless it asks for chaos; a band
                    without the network wants --network chaos
The tools that build their own sessions from these classes
(tools/system-check/warm-boot, tools/cross-build/run's sessions) take the
network and the tap through harness_network, below, with the same default.
Each network has its own checkpoint on revision 16: since step R3 of the
contract's section 8 the band has no NCP, so tcp gives the machine no
--chaos-address, and chaos does, and the checkpoint holds the Chaosnet
interface's switches (until R3 --chaos-address was given in both, and one
checkpoint served both networks).

The self-test is tools/lispm-check-test/run.sh, which takes this tool's flags.
docs/lispm-check.md has the same usage.
"""

import argparse, fcntl, glob, hashlib, json, os, random, re, shutil, signal, socket
import subprocess, sys, time

TOOL_DIR = os.path.dirname(os.path.abspath(__file__))
# The simulator's executable this line's system runs on, which also names
# its flag and variable (--quux, LISPM_CHECK_QUUX): quux on main, QUUX's
# system, and cadr on the cadr branch, the CADR's.  The one line in which the
# two lines' copies of this tool differ.
MACHINE = 'quux'
CHAOS_HOST, CHAOS_LISPM = '177200', '177201'   # ozd's and the band's addresses
TV_SIZE = '1280x1024'   # QUUX's video controller (--video-size); cadr has none
# The host SYS: translates to in the band: the file device's pathname host,
# HOST or FILES, when the band reads its sources through quux's file device,
# OZ when through ozd.  Asked before the login, since a translation opens no
# file.
SYS_HOST = ('(send (send (send (fs:parse-pathname "SYS: SYS; SYSDCL LISP")'
            ' :translated-pathname) :host) :name)')
# The login to the host SYS: is on, whatever the band names it, as QLD's own
# (sys/sys/ltop.lisp): for a session that has not asked SYS_HOST.
LOGIN_SYS_HOST = '(login "LISPM" (send (fs:get-pathname-host "SYS") :physical-host) t)'


def now():
    return time.monotonic()


class RunFailed(Exception):
    """The run itself failed: exit status 2."""


class RunHung(RunFailed):
    """The machine hung in the setup or the probe, its cold boot: exit status
    3, distinct from a failure.  Said when the machine got no CPU time at all
    for SETUP_STALL s (stopped), or when the setup's hard limit passed with
    the machine running but not answering (Progress).  STOPPED: the former,
    for which the hints about the band and its files do not apply."""
    def __init__(self, message, stopped=False):
        RunFailed.__init__(self, message)
        self.stopped = stopped


# The setup's and the probe's waits are on the machine's progress, not on a
# fixed wall-clock limit for each step: on a loaded host the cold boot and
# each setup form took longer than the old limits (300 s to the banner, 120 s
# a form) while the machine still ran and later answered, so a loaded machine
# reported false failures.  Twelve setups of System 2000's band at once under
# 24 busy processes: 58 to 311 s a form, 680 to 914 s a setup, each finished;
# unloaded the setup takes 16 s, 0.8 to 1.5 s a form.  No budget of the
# machine's CPU time is safe either: with its clock on the host's (quux's
# "timing: sync"), the machine at about 0.2x hardware executed 14 to 19
# times the microcycles for the same setup (3.3 to 4.5 G against 0.24 G
# unloaded, at 0.6x).  So a wait goes on while the machine gets CPU time,
# ends as a hang at once when it gets none for SETUP_STALL s (a stopped
# machine), and as a hang at --setup-limit, the hard limit on the setup's
# wall clock, which still ends a machine that runs but never answers (a band
# that never reaches its TELNET listener).
SETUP_STALL = 60           # wall seconds with no CPU time at all: stopped
SETUP_LIMIT = 1800         # --setup-limit's default: the hard limit, wall


def session_cpu(sid):
    """CPU seconds used so far by the processes of session SID (the machine
    is started in a session of its own, so a wrapper script that runs it
    without exec is counted with it), or None when there is none."""
    total, found = 0, False
    for pid in os.listdir('/proc'):
        if not pid.isdigit():
            continue
        try:
            with open('/proc/%s/stat' % pid) as f:
                st = f.read()
        except OSError:
            continue
        # the fields after the command's ")": state is the first, session
        # the fourth, utime, stime, cutime and cstime the 12th to 15th
        fields = st[st.rfind(')') + 2:].split()
        if int(fields[3]) == sid:
            found = True
            total += sum(int(x) for x in fields[11:15])
    return total / os.sysconf('SC_CLK_TCK') if found else None


class Progress:
    """A wait in the setup or the probe on the machine's answer to WHAT, by
    the machine's progress: check() raises RunHung once the machine got no
    CPU time at all for SETUP_STALL s (stopped), or at END, the setup's hard
    limit (a now() value)."""
    def __init__(self, machine, what, end):
        self.pid, self.what, self.end = machine.proc.pid, what, end
        self.t0 = self.t_cpu = self.t_sample = now()
        self.cpu0 = self.cpu = session_cpu(self.pid) or 0.0

    def used(self):
        """(wall seconds, the machine's CPU seconds) since the wait began."""
        return now() - self.t0, self.cpu - self.cpu0

    def check(self):
        t = now()
        if t - self.t_sample >= 1:
            self.t_sample = t
            c = session_cpu(self.pid)
            if c is not None and c > self.cpu:
                self.cpu, self.t_cpu = c, t
        if t - self.t_cpu > SETUP_STALL:
            raise RunHung('no answer to %s, and the machine got no CPU time for %.0f s'
                          ' (stopped?)' % (self.what, t - self.t_cpu), stopped=True)
        if t > self.end:
            wall, cpu = self.used()
            raise RunHung('no answer to %s within the setup\'s hard limit, --setup-limit:'
                          ' %.0f s on it, the machine running (%.0f s of its CPU time)'
                          % (self.what, wall, cpu))


# --------------------------------------------------------------------------
# Paths, hashes and the cache.

def cache_dir():
    base = os.environ.get('XDG_CACHE_HOME') or os.path.expanduser('~/.cache')
    d = os.path.join(base, 'muir-sys-check')
    os.makedirs(d, exist_ok=True)
    return d


def sha256_cached(path):
    """sha256 of a file, remembered by (device, inode, size, mtime) so that a
    270 MB band is not hashed again on every check."""
    st = os.stat(path)
    key = '%d:%d:%d:%d' % (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)
    db = os.path.join(cache_dir(), 'sha256.json')
    try:
        with open(db) as f:
            known = json.load(f)
    except (OSError, ValueError):
        known = {}
    if known.get(os.path.realpath(path), {}).get('key') == key:
        return known[os.path.realpath(path)]['sha256']
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for block in iter(lambda: f.read(1 << 20), b''):
            h.update(block)
    known[os.path.realpath(path)] = {'key': key, 'sha256': h.hexdigest()}
    tmp = '%s.%d' % (db, os.getpid())
    with open(tmp, 'w') as f:
        json.dump(known, f, indent=1)
    os.replace(tmp, db)
    return h.hexdigest()


class Lock:
    """An flock on a file under the cache, held until release()."""
    def __init__(self, name, block=True):
        d = os.path.join(cache_dir(), 'locks')
        os.makedirs(d, exist_ok=True)
        self.f = open(os.path.join(d, name), 'w')
        try:
            fcntl.flock(self.f, fcntl.LOCK_EX | (0 if block else fcntl.LOCK_NB))
        except BlockingIOError:
            self.f.close()
            raise

    def release(self):
        self.f.close()


# --------------------------------------------------------------------------
# Ports: four free ones for each run, locked so that parallel runs differ.

def port_free(port, kind):
    s = socket.socket(socket.AF_INET, kind)
    try:
        s.bind(('127.0.0.1', port))
        return True
    except OSError:
        return False
    finally:
        s.close()


def take_ports():
    """Four ports in a block of four within LISPM_CHECK_PORTS, every one free
    and the block locked: (ozd UDP, the machine's UDP, TELNET TCP, RFB TCP)."""
    lo, hi = (int(x) for x in os.environ.get('LISPM_CHECK_PORTS', '44000-44999').split('-'))
    bases = list(range(lo - lo % 4 + (4 if lo % 4 else 0), hi - 2, 4))
    random.shuffle(bases)
    for base in bases:
        try:
            lock = Lock('port-%d' % base, block=False)
        except BlockingIOError:
            continue
        kinds = (socket.SOCK_DGRAM, socket.SOCK_DGRAM, socket.SOCK_STREAM, socket.SOCK_STREAM)
        if all(port_free(base + i, k) for i, k in enumerate(kinds)):
            return lock, tuple(base + i for i in range(4))
        lock.release()
    raise RunFailed('no free block of four ports in %d-%d' % (lo, hi))


def listener_owned_by(port, pid):
    """True if the TCP socket listening on port belongs to process pid: the
    check that a connection reaches this run's machine and no other."""
    inodes = set()
    for table in ('/proc/net/tcp', '/proc/net/tcp6'):
        try:
            with open(table) as f:
                for line in f.readlines()[1:]:
                    p = line.split()
                    if int(p[1].split(':')[1], 16) == port and p[3] == '0A':
                        inodes.add(p[9])
        except OSError:
            pass
    try:
        for fd in os.listdir('/proc/%d/fd' % pid):
            try:
                link = os.readlink('/proc/%d/fd/%s' % (pid, fd))
            except OSError:
                continue
            m = re.match(r'socket:\[(\d+)\]', link)
            if m and m.group(1) in inodes:
                return True
    except OSError:
        pass
    return False


# --------------------------------------------------------------------------
# Taps: revision 16's link, a tap of the pool held through the fault relay
# (QUUX's Ethernet contract, section 3).  The tap is the lock: the kernel
# lets one holder open it, so two runs never hold one tap, and the band uses
# index N's address only while its run holds tap N.

RELAY = os.path.join(TOOL_DIR, 'fault-relay', 'relay')
TAP_POOL, TAP_POOL_MAX = 'quux', 64     # quux-taps makes quux0 to quux<N-1>
RELAY_TAKEN = 75                        # the relay's status: every tap tried was held
SIOCGIFADDR, SIOCGIFNETMASK = 0x8915, 0x891B
SO_BINDTODEVICE = getattr(socket, 'SO_BINDTODEVICE', 25)


def tap_addresses(name):
    """(host side, QUUX's address) of a host-only tap, dotted, read from the
    kernel, or None when NAME is no tap or not host-only: a host-only tap has
    a /30 of its own, and QUUX's address is the /30's other host address."""
    if not os.path.exists('/sys/class/net/%s/tun_flags' % name):
        return None
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        got = []
        for request in (SIOCGIFADDR, SIOCGIFNETMASK):
            r = fcntl.ioctl(s.fileno(), request, struct_ifreq(name))
            got.append(int.from_bytes(r[20:24], 'big'))
    except OSError:
        return None
    finally:
        s.close()
    host, mask = got
    net = host & mask
    if mask != 0xFFFFFFFC or host not in (net + 1, net + 2):
        return None
    quux = net + 2 if host == net + 1 else net + 1
    return tuple(socket.inet_ntoa(x.to_bytes(4, 'big')) for x in (host, quux))


def struct_ifreq(name):
    return name.encode().ljust(16, b'\0') + b'\0' * 24


def tap_range():
    """The taps a run may take, as (index, name, QUUX's address), lowest index
    first: LISPM_CHECK_TAPS's indexes (N, LO-HI, or a comma-separated list of
    them), by default the whole pool; of them the host-only taps alone, since
    a LAN tap's address is a real one (the contract, amendment 3)."""
    spec = os.environ.get('LISPM_CHECK_TAPS')
    if spec:
        indexes = set()
        for part in spec.split(','):
            m = re.fullmatch(r'\s*(\d+)\s*(?:-\s*(\d+)\s*)?', part)
            if not m:
                raise RunFailed('LISPM_CHECK_TAPS: %r is not N, LO-HI or a list of them' % spec)
            lo = int(m.group(1))
            hi = int(m.group(2)) if m.group(2) is not None else lo
            if hi < lo or hi >= TAP_POOL_MAX:
                raise RunFailed('LISPM_CHECK_TAPS: %r: indexes run from 0 to %d' % (spec, TAP_POOL_MAX - 1))
            indexes.update(range(lo, hi + 1))
    else:
        indexes = set(range(TAP_POOL_MAX))
    taps = []
    for i in sorted(indexes):
        name = '%s%d' % (TAP_POOL, i)
        if not os.path.exists('/sys/class/net/' + name):
            if spec:
                print('lispm-check: %s, of LISPM_CHECK_TAPS, does not exist: not taken' % name)
            continue
        addresses = tap_addresses(name)
        if addresses is None:
            print('lispm-check: %s is not a host-only tap (no /30 of its own): not taken' % name)
            continue
        taps.append((i, name, addresses[1]))
    if not taps:
        raise RunFailed('no host-only tap of the pool in %s (muir-sim\'s tools/quux-taps installs the pool)'
                        % ('LISPM_CHECK_TAPS=' + spec if spec else 'quux0-quux%d' % (TAP_POOL_MAX - 1)))
    return taps


def socket_dir():
    """A directory of its own for the relay's UNIX socket, whose path must
    stay under the kernel's 108 bytes: under the cache when that is short
    enough, else under the system's temporary directory."""
    d = os.path.join(cache_dir(), 'sockets')
    os.makedirs(d, exist_ok=True)
    if len(d) > 70:
        d = None
    import tempfile
    return tempfile.mkdtemp(prefix='lc-', dir=d)


class TapLink:
    """Revision 16's link for one run of this tool: the fault relay holding a
    tap, its socket for the machine's --ethernet-socket, and the addresses
    the relay's line names.  One relay serves the setup's machine and then
    the check's, one after the other, so a run holds one tap throughout."""
    def __init__(self, taps, end):
        self.sock_dir = socket_dir()
        self.path = os.path.join(self.sock_dir, 'relay.sock')
        self.report = os.path.join(self.sock_dir, 'relay.json')
        self.proc = None
        names = ','.join(name for _, name, _ in taps)
        waited = False
        while True:
            # the relay's log, one handle at a time while it waits for a tap
            if getattr(self, 'err', None):
                self.err.close()
            self.err = open(os.path.join(self.sock_dir, 'relay.err'), 'w+')
            # LISPM_CHECK_RELAY_FLAGS: the relay's faults, for T4 (section 9);
            # none by default, so that the relay only moves and counts
            faults = os.environ.get('LISPM_CHECK_RELAY_FLAGS', '').split()
            self.proc = subprocess.Popen([sys.executable, RELAY, '--tap', names, '--report', self.report]
                                         + faults + [self.path], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                         stderr=self.err, start_new_session=True, text=True)
            line = self.proc.stdout.readline().strip()
            if line:
                break
            rc = self.proc.wait()
            self.err.seek(0)
            why = self.err.read().strip()
            if rc != RELAY_TAKEN:
                raise RunFailed('the fault relay took no tap (exit %d): %s' % (rc, why))
            if now() > end:
                raise RunFailed('no free tap in --setup-limit: %s' % why)
            if not waited:
                print('lispm-check: every tap of %s is held; waiting for one' % names, flush=True)
                waited = True
            time.sleep(1)
        # the line: TAP --ip-address A.B.C.D/30 --ip-gateway A.B.C.D
        m = re.fullmatch(r'(\S+) --ip-address (\S+)/(\d+) --ip-gateway (\S+)', line)
        if not m:
            self.stop()
            raise RunFailed('the fault relay\'s line is not one this tool reads: %r' % line)
        self.tap, self.quux, self.prefix, self.gateway = m.group(1), m.group(2), m.group(3), m.group(4)
        self.index = int(self.tap[len(TAP_POOL):])

    def machine_flags(self):
        return ['--ethernet-socket', self.path, '--ip-address', '%s/%s' % (self.quux, self.prefix),
                '--ip-gateway', self.gateway]

    def stop(self, keep_in=None):
        """Stop the relay, the machine having stopped first; with KEEP_IN, a
        run directory kept, its report and its log go there."""
        stop_process(self.proc)
        if keep_in:
            for f in ('relay.json', 'relay.err'):
                if os.path.exists(os.path.join(self.sock_dir, f)):
                    shutil.copyfile(os.path.join(self.sock_dir, f), os.path.join(keep_in, f))
        shutil.rmtree(self.sock_dir, ignore_errors=True)


def machine_revision(a, exe_sha):
    """QUUX's revision the machine runs, asked of it once for each build and
    MUIR_QUUX_REVISION (a wrapper may set it), and remembered under the cache:
    its start names it ("machine: quux, revision 16"), or its refusal to run
    without a boot PROM does.  None for the CADR.  The machine is asked with
    no engine named, so that a wrapper's flags for one engine are taken: it
    was asked with --micro, which quux refuses for rtl's flags
    (--memory-timing, --cache, as the soak's rtl lanes give them), so every
    run through such a wrapper failed here, and since the default network
    follows the revision (QUUX's Ethernet contract, section 8 R2), none
    could take it.  quux's own engine is rtl, and only rtl has flags of its
    own; the asking takes about 4 ms on either engine."""
    if MACHINE != 'quux':
        return None
    pair = '%s-%s' % (exe_sha[:16], os.environ.get('MUIR_QUUX_REVISION', ''))
    db = os.path.join(cache_dir(), 'revisions.json')
    try:
        with open(db) as f:
            known = json.load(f)
    except (OSError, ValueError):
        known = {}
    if pair in known:
        return known[pair]
    ports_lock, ports = take_ports()
    try:
        # before, the engine forced:
        #   [a.exe, '-c', '/dev/null', '--micro', '--stop-after', '1', ...]
        p = subprocess.run([a.exe, '-c', '/dev/null', '--stop-after', '1',
                            '--terminal', '127.0.0.1:%d' % ports[3]],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
    finally:
        ports_lock.release()
    m = re.search(r'machine: quux, revision (\d+)|QUUX revision (\d+) has', p.stdout + p.stderr)
    if not m:
        raise RunFailed('%s did not say which revision it runs (%s -c /dev/null --stop-after 1): %s'
                        % (MACHINE, a.exe, ' '.join((p.stdout + p.stderr).split())[-300:]))
    known[pair] = int(m.group(1) or m.group(2))
    tmp = '%s.%d' % (db, os.getpid())
    with open(tmp, 'w') as f:
        json.dump(known, f, indent=1)
    os.replace(tmp, db)
    return known[pair]


# The default network (QUUX's Ethernet contract, section 8 R2, the switch):
# a run that names none, by --network or LISPM_CHECK_NETWORK, is carried over
# TCP on revision 16, whose band has the network, and over Chaos on revisions
# 13-15 and on the CADR, which keep their Chaos as released.  Before the
# switch every run's default was chaos, so a run on revision 16 started ozd.

def default_network(revision):
    """The network of a run on REVISION (None: the CADR) that names none."""
    return 'tcp' if revision is not None and revision >= 16 else 'chaos'


def resolve_network(network, revision):
    """The network a run takes: NETWORK as named, or the default for REVISION
    when NETWORK is None; RunFailed for tcp below revision 16."""
    chosen = network or default_network(revision)
    if chosen == 'tcp' and (revision is None or revision < 16):
        raise RunFailed('--network tcp: %s runs %s, which has no Ethernet device; revision 16 has'
                        % (MACHINE, 'revision %d' % revision if revision else 'the CADR'))
    return chosen


def harness_network(exe, setup_limit=SETUP_LIMIT):
    """The network and the link for the tools that build their own sessions
    from this tool's classes (tools/system-check/warm-boot, and
    tools/cross-build/run's sessions, which tools/microcode-check/
    generational-save takes): they take a tap through this helper (QUUX's
    Ethernet contract, section 3, "Who takes a tap").  EXE's revision is
    asked as a run asks it; the network is LISPM_CHECK_NETWORK's, or the
    default for that revision; on revision 16 a tap of LISPM_CHECK_TAPS is
    taken through the fault relay, waiting up to SETUP_LIMIT s for a free
    one.  Returns
    (network, link): LINK a TapLink, which the caller stops after its
    machine, or None.  Before the switch these tools gave their file server
    no network and no link, so every session went over Chaos through ozd."""
    class Exe:
        pass
    a = Exe()
    a.exe = os.path.abspath(exe)
    revision = machine_revision(a, sha256_cached(a.exe))
    named = os.environ.get('LISPM_CHECK_NETWORK') or None
    if named is not None and named not in NETWORKS:
        raise RunFailed('LISPM_CHECK_NETWORK: %r is not one of %s' % (named, ', '.join(NETWORKS)))
    network = resolve_network(named, revision)
    link = None
    if revision is not None and revision >= 16:
        link = TapLink(tap_range(), now() + setup_limit)
        print('%s: tap %s, QUUX at %s, TELNET over %s%s'
              % (os.path.basename(sys.argv[0]), link.tap, link.quux, network,
                 '' if named else ' (the default on revision 16)'), flush=True)
    return network, link


def stop_process(p, stdin_command=None, wait=10):
    """Stop a process started in its own session, and all of its group."""
    if p is None or p.poll() is not None:
        return
    if stdin_command is not None:
        try:
            p.stdin.write(stdin_command)
            p.stdin.flush()
        except (BrokenPipeError, OSError, ValueError):
            pass
        try:
            p.wait(wait)
            return
        except subprocess.TimeoutExpired:
            pass
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(p.pid, sig)
        except ProcessLookupError:
            return
        try:
            p.wait(5)
            return
        except subprocess.TimeoutExpired:
            continue


# --------------------------------------------------------------------------
# The file servers.  Everything that knows how the tree is served is here:
# ozd's flags, the copy of the tree and its layout, the pathnames the band uses
# for served files, the TELNET listener ozd carries to the band in either
# mode, and the machine's flags that plug the band into them.  OzdFileServer serves
# the copy by ozd, DeviceFileServer by quux's file device; a third way is a
# class with the same methods, named in FILE_SERVERS.  The TELNET session is
# carried by the network, --network (NETWORKS): over Chaos through ozd, or
# over the build host's TCP to the band behind its tap, with no ozd at all
# when the device serves the files.  LINK is revision 16's tap (TapLink), or
# None, and its flags are the machine's in either network.

# The networks that carry the TELNET session (--network), each with whether
# it needs ozd as the gateway.  A third, files (a transport through the file
# device's pathname host, the session through quux's file device, for a band
# without its network), is to come, as another entry here and another branch
# in connect_listener, network_flags and close_session.
NETWORKS = {'chaos': {'ozd': True}, 'tcp': {'ozd': False}}
TELNET_PORT = 23
# The clean close's wait for the band's FIN after ours, and then for the last
# ACK (the contract, section 7): wall seconds.
CLOSE_WAIT, LAST_ACK_WAIT = 60, 0.5


class OzdFileServer:
    # the --file-server name, the host the setup logs in to, and the hosts a
    # band's SYS: may be on for this server: the band's files and the login's
    # home are on OZ
    mode, login_host, hosts = 'ozd', 'OZ', ('OZ',)

    def __init__(self, ozd, run_dir, ports, log, ozd_flags=(), network='chaos', link=None, host=None):
        # HOST: the band's answer to SYS_HOST, when known (a checkpoint keeps
        # it); OzdFileServer has one host, and takes it only to check it
        if host is not None:
            self.learn_host(host)
        self.ozd, self.run_dir, self.log = ozd, run_dir, log
        # --file-dates and --timezone for ozd, as --ozd-file-dates and
        # --ozd-timezone give them; none, ozd's defaults
        self.ozd_flags = list(ozd_flags)
        self.udp, self.machine_udp, self.telnet = ports[0], ports[1], ports[2]
        self.root = os.path.join(run_dir, 'served')
        self.proc = None
        self.network, self.link = network, link
        if network == 'tcp' and link is None:
            raise RunFailed('--network tcp needs a tap, and so revision 16')

    def login(self):
        return '(login "LISPM" "%s" t)' % self.login_host

    def learn_host(self, host):
        """Take HOST, the band's answer to SYS_HOST, as the host the login
        and the served files are on; refused unless this server serves it."""
        if host not in self.hosts:
            raise RunFailed("the band's SYS: is on %s, but --file-server %s serves %s"
                            % (host, self.mode, ' or '.join(self.hosts)))
        self.login_host = host

    def lay_out(self, tree, ubin=None):
        """Copy the tree's sys/ and site/ to be served (the tree is never
        served itself, so a compile writes its QFASLs into the copy), with
        ubin/ as sys/ubin/ when given, and an empty home for the login."""
        for d in ('sys', 'site'):
            shutil.copytree(os.path.join(tree, d), os.path.join(self.root, d), symlinks=True)
        if ubin:
            dest = os.path.join(self.root, 'sys', 'ubin')
            shutil.rmtree(dest, ignore_errors=True)
            shutil.copytree(ubin, dest)
        os.makedirs(os.path.join(self.root, 'lispm'))

    def place(self, path, tree):
        """Serve the file at path and return the pathname the band loads it
        by, without its type, and whether that is a logical SYS: name."""
        rel = os.path.relpath(os.path.realpath(path), os.path.realpath(tree))
        if rel.startswith('sys' + os.sep):
            dest = os.path.join(self.root, rel)
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            if os.path.lexists(dest):
                os.unlink(dest)
            shutil.copyfile(path, dest)
            parts = rel.split(os.sep)[1:]
            name = os.path.splitext(parts[-1])[0]
            return 'SYS: ' + ''.join(d.upper() + '; ' for d in parts[:-1]) + name.upper(), True
        name = os.path.basename(path)
        shutil.copyfile(path, os.path.join(self.root, 'lispm', name))
        return 'OZ: //lispm//' + os.path.splitext(name)[0], False

    def ozd_roots(self):
        return ['--root', 'sys=%s/sys' % self.root, '--root', 'site=%s/site' % self.root,
                '--root', 'lispm=%s/lispm' % self.root]

    def start(self):
        """Start ozd, when the network needs it as the TELNET gateway or the
        server serves the files by it; else nothing (--network tcp with the
        files on the device: the machine is given no Chaos peer at all)."""
        if not NETWORKS[self.network]['ozd'] and self.mode == 'device':
            return None
        self.logfile = open(os.path.join(self.run_dir, 'ozd.log'), 'wb')
        cmd = [self.ozd, '-c', '/dev/null', '--address', CHAOS_HOST, '--name', 'OZ,system=UNIX',
               '--listen', '127.0.0.1:%d' % self.udp] + self.ozd_roots() + [
               '--host', '%s,LISPM-1,system=LISPM' % CHAOS_LISPM,
               '--peer', '%s@127.0.0.1:%d' % (CHAOS_LISPM, self.machine_udp),
               '--tcp', '127.0.0.1:%d,TELNET@%s' % (self.telnet, CHAOS_LISPM),
               '--log-file', '--log-simple'] + self.ozd_flags
        self.proc = subprocess.Popen(cmd, cwd=self.run_dir, stdin=subprocess.DEVNULL,
                                     stdout=self.logfile, stderr=self.logfile,
                                     start_new_session=True)
        return self.proc.pid

    def machine_flags(self):
        """The network's flags, and revision 16's link's.  Over TCP the
        machine has no Chaos cable and, since the NCP left the band (the
        contract's section 8, R3), no Chaos address: until R3 --chaos-address
        was given in both networks, so that one checkpoint served both, and
        the band behind the pool was LISPM-1.  Over Chaos it has both, and a
        checkpoint of its own (the key's -chaos, prepare below)."""
        if self.network == 'tcp':
            # until R3: flags = ['--chaos-address', CHAOS_LISPM]
            flags = []
        else:
            flags = ['--chaos-address', CHAOS_LISPM, '--chaos-udp', '127.0.0.1:%d' % self.machine_udp,
                     '--chaos-udp-peer', '%s@127.0.0.1:%d' % (CHAOS_HOST, self.udp),
                     '--chaos-udp-default-peer', '127.0.0.1:%d' % self.udp]
        return flags + (self.link.machine_flags() if self.link else [])

    def _open(self, machine_alive):
        """One attempt at the band's TELNET listener: a socket, or None to try
        again.  Over Chaos, a TCP connection to ozd's gateway once ozd itself
        holds the listening port (so that it reaches this run's ozd and no
        other); over TCP, a connection from a socket bound to this run's tap
        to QUUX's address, port 23, which reaches this run's band alone, the
        run holding the tap."""
        if self.network == 'tcp':
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            try:
                s.setsockopt(socket.SOL_SOCKET, SO_BINDTODEVICE, self.link.tap.encode())
                s.settimeout(5)
                s.connect((self.link.quux, TELNET_PORT))
                return s
            except OSError:
                # before the band's network is up: no ARP answer (EHOSTUNREACH
                # after Linux's 3 s), or an RST from a band not yet listening
                s.close()
                time.sleep(0.5)
                return None
        if self.proc.poll() is not None:
            raise RunFailed('ozd exited (see %s/ozd.log)' % self.run_dir)
        if not listener_owned_by(self.telnet, self.proc.pid):
            time.sleep(0.05)
            return None
        try:
            return socket.create_connection(('127.0.0.1', self.telnet), timeout=5)
        except OSError:
            time.sleep(0.1)
            return None

    def connect_listener(self, machine_alive, deadline, progress=None):
        """Connect to the band's TELNET listener, through the network, and
        return the socket and the text read up to its banner.  With PROGRESS
        (the setup's cold boot), its check() ends the wait, not DEADLINE."""
        if progress:
            deadline = progress.end
        while now() < deadline:
            if progress:
                progress.check()
            if not machine_alive():
                raise RunFailed('%s exited before the TELNET banner' % MACHINE)
            s = self._open(machine_alive)
            if s is None:
                continue
            s.settimeout(0.2)
            # A connection that stays silent is given up after 30 s and made
            # again; in the setup it is kept until ozd closes it (refused, or
            # the band not heard for 180 s), so that a slow banner is not cut
            text, until = '', deadline if progress else min(deadline, now() + 30)
            while now() < until:
                if progress:
                    progress.check()
                try:
                    d = s.recv(4096)
                except socket.timeout:
                    continue
                except OSError:
                    break
                if not d:
                    break
                text += d.decode('latin-1')
                self.log.write(d.decode('latin-1'))
                if 'Telnet server here' in text:
                    return s, text
            s.close()
            time.sleep(0.1)
        if progress:
            raise RunHung('no TELNET banner within the setup\'s limit, --setup-limit')
        raise RunFailed('no TELNET banner in time')

    def close_session(self, sock, strict, progress=None):
        """End the TELNET session.  Over TCP, cleanly (the contract, section
        7): half-close, read to the band's EOF, which its server sends at the
        client's EOF, then wait LAST_ACK_WAIT s for the band's last ACK, so
        that a checkpoint written after it holds no open connection and, in
        the normal case, no TIME-WAIT.  STRICT (the setup): a band that sends
        no EOF within CLOSE_WAIT s, or resets the connection, fails the run.
        Over Chaos the socket to ozd is closed, as before."""
        if self.network != 'tcp':
            sock.close()
            return
        why = None
        try:
            sock.shutdown(socket.SHUT_WR)
            end = now() + CLOSE_WAIT
            while True:
                if progress:
                    progress.check()
                if now() > end:
                    why = 'no EOF from the band within %d s of ours' % CLOSE_WAIT
                    break
                try:
                    d = sock.recv(4096)
                except socket.timeout:
                    continue
                if not d:
                    break
                self.log.write(d.decode('latin-1'))
        except OSError as e:
            why = 'the session ended with %s, not the band\'s EOF' % (e.strerror or e)
        self.log.write('\n=== %.2f the session closed: %s\n' % (now(), why or 'the band\'s EOF after ours'))
        time.sleep(LAST_ACK_WAIT)
        sock.close()
        if why and strict:
            raise RunFailed('the clean close: %s (section 7: the server closes its side at EOF)' % why)

    def stop(self):
        stop_process(self.proc)


class DeviceFileServer(OzdFileServer):
    """The tree served by quux's own file device, for a band whose SYS: is on
    the file device's pathname host.  Against such a band OzdFileServer never
    reaches the prompt: the boot reads SYS: through the device, which with
    nothing mounted serves an empty /, and ozd saw only "No server for this
    contact name" from the band's TELNET contact for minutes.  Here quux
    mounts the private copy as the host's / (sys/, site/ and home/lispm/,
    --file-root), and ozd stays only as the TELNET gateway: its one root is
    an empty read-only folder, since ozd wants one, so it serves no file.
    The copy is laid out and written as OzdFileServer's is; only the folders
    and the pathnames differ.

    The host's name is the band's: HOST in Systems 2000 and 2001 and the
    bands of 2002 built before the name changed, FILES after it; the device
    serves either alike.  The setup asks the band (SYS_HOST) and learns it,
    a check is given it from the checkpoint (host=), and until it is known
    the login is the band's own SYS: host, as QLD's (sys/sys/ltop.lisp), and
    place() refuses, having no host to name a file on.  The class named
    one host, HOST, as a constant, and refused a band whose SYS: is on FILES
    at the setup:
        mode, login_host = 'device', 'HOST'"""
    mode, login_host, hosts = 'device', None, ('HOST', 'FILES')

    def login(self):
        if self.login_host is None:
            return LOGIN_SYS_HOST
        return super().login()

    def lay_out(self, tree, ubin=None):
        """The copy as the host's /: sys/ and site/ of the tree (ubin/ as
        sys/ubin/ when given) and an empty home/lispm/ for the login."""
        super().lay_out(tree, ubin)
        os.rmdir(os.path.join(self.root, 'lispm'))
        os.makedirs(os.path.join(self.root, 'home', 'lispm'))
        os.makedirs(os.path.join(self.run_dir, 'no-files'))

    def place(self, path, tree):
        """A sys/ file as OzdFileServer places it (SYS: translates to the
        file device's host in the band); any other in the login's home,
        /home/lispm/ on the host the band named (HOST: or FILES:)."""
        rel = os.path.relpath(os.path.realpath(path), os.path.realpath(tree))
        if rel.startswith('sys' + os.sep):
            return super().place(path, tree)
        if self.login_host is None:
            raise RunFailed('%s: not known which host the band names its home on (host=)' % path)
        name = os.path.basename(path)
        shutil.copyfile(path, os.path.join(self.root, 'home', 'lispm', name))
        # the home on the band's host, which was HOST alone:
        #   return 'HOST: //home//lispm//' + os.path.splitext(name)[0], False
        return '%s: //home//lispm//%s' % (self.login_host, os.path.splitext(name)[0]), False

    def ozd_roots(self):
        return ['--root', '%s/no-files,ro' % self.run_dir]

    def machine_flags(self):
        return super().machine_flags() + ['--file-root', self.root]


class ProbeFileServer(DeviceFileServer):
    """Only for --file-server auto's probe: the copy served both ways at once,
    on the device and as ozd's roots, so that a band boots to its prompt
    whichever host its SYS: is on and can be asked which that is.  A band
    boots only with its SYS: host served: one on OZ served by the device alone,
    or a band whose SYS: is on the file device's host (HOST or FILES)
    served by ozd alone, waits at boot with no TELNET server.  Nothing is
    checked in a probe's boot."""
    mode = 'probe'

    def ozd_roots(self):
        return ['--root', 'sys=%s/sys' % self.root, '--root', 'site=%s/site' % self.root,
                '--root', 'lispm=%s/home/lispm' % self.root]


FILE_SERVERS = {c.mode: c for c in (OzdFileServer, DeviceFileServer)}


# --------------------------------------------------------------------------
# The machine: MACHINE's executable, cold with --checkpoint or resumed from one.

class Machine:
    def __init__(self, exe, band, run_dir, rfb_port, server, engine):
        self.exe, self.band, self.run_dir = exe, band, run_dir
        self.rfb, self.server, self.proc = rfb_port, server, None
        self.engine = engine

    def start(self, checkpoint_out=None, resume=None):
        # The engine is --engine's, micro or rtl: it was always --micro, so a
        # check never ran on rtl.
        cmd = [self.exe, '-c', '/dev/null', '--' + self.engine]
        if MACHINE == 'quux':
            # muir-sim's --video-size, --mono-tv-size until contract Q13
            # renamed MONO TV the video controller; quux refuses the old flag.
            cmd += ['--video-size', TV_SIZE]
        else:
            # cadr has no video controller and refuses --video-size, as it
            # refuses --mono-tv-size, which this tool gave it; and on rtl it
            # listens for a debugger's cable on a TCP port (7661, or the next
            # free one), which a check never wants.
            cmd += ['--no-debug-cable-listen']
        cmd += ['--disk-pack', self.band + ',ro', '--terminal', '127.0.0.1:%d' % self.rfb]
        cmd += self.server.machine_flags()
        if checkpoint_out:
            cmd += ['--checkpoint', checkpoint_out]
        if resume:
            cmd += ['--resume', resume]
        self.logfile = open(os.path.join(self.run_dir, MACHINE + '.log'), 'wb')
        # The command line heads the log, so a kept run shows which engine
        # and flags the machine ran with.
        self.logfile.write(('# %s\n' % ' '.join(cmd)).encode())
        self.logfile.flush()
        self.proc = subprocess.Popen(cmd, cwd=self.run_dir, stdin=subprocess.PIPE,
                                     stdout=self.logfile, stderr=self.logfile,
                                     start_new_session=True)

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def stop(self, wait=10):
        stop_process(self.proc, b'quit\n', wait)


# --------------------------------------------------------------------------
# The session: forms over TELNET, each wrapped to print its value between
# markers, and an error answered No so the listener goes back to top level.

# The function every case is run through, defined and compiled into the
# checkpoint at setup.  SETUP_VERSION is part of the checkpoint's key: change it
# whenever this or the setup's forms change.
# A question the form asks through FQUERY (Y-OR-N-P, YES-OR-NO-P, FQUERY
# itself) signals the condition FQUERY first (sys/io1/fquery.lisp); the
# clause for it ends the form there and prints the question between ? markers,
# so the case fails at once rather than waiting out --timeout for an answer
# nobody types.  YES-OR-NO-P prints no prompt over TELNET at all, so only this
# sees it.  Clauses are tried in order; FQUERY is not an error.
CASE_FORM = ('(condition-case (e) (format t "~%%{~D{~S}~D}~%%" %(k)s %(form)s %(k)s)'
             ' (fquery (format t "~%%{~D?~A?~D}~%%" %(k)s (send e \':report-string) %(k)s))'
             ' (error (format t "~%%{~D!~A!~D}~%%" %(k)s (send e \':report-string) %(k)s)))')
HELPER = '(defun lispm-check-case (k form) %s)' % (CASE_FORM % {'k': 'k', 'form': '(eval form)'})
# 2: the FQUERY clause
SETUP_VERSION = '2'
# 3: revision 16's setup gives the machine its tap's addresses, and over TCP
# closes cleanly (the contract, amendment 2, 5.1); revision 15's key keeps 2
# 4: over TCP the machine has no --chaos-address (the contract's section 8,
# R3), and a run over Chaos on revision 16 has its own key, -chaos
#SETUP_VERSION_TAP = '3'
SETUP_VERSION_TAP = '4'

ERROR_RE = re.compile(r'(?:^|[\r\n])(>>(?:ERROR|TRAP)[^\r\n]*)')
# The second line of defence, for a question the FQUERY clause does not see
# (one asked without FQUERY, or in the setup's forms): the last line of what a
# case printed ends with the prompt of
# Y-OR-N-P or YES-OR-NO-P (sys/io1/fquery.lisp) and nothing follows it.
# YES-OR-NO-P prints its prompt only through a rubout handler, which the TELNET
# stream lacks, so over TELNET only Y-OR-N-P's is ever seen.
# Without this a case that asks one (GC-ON's "Try garbage collecting after
# all? (Y or N)") waited out --timeout, since the case's condition-case answers
# only errors.
# Line ends may follow the prompt too: the echo of the form's own RETURN can
# come after what the form printed.
QUESTION_RE = re.compile(r'([^\r\n]*\((Y or N|Yes or No)\))[ \x07\r\n]*$')
# How long the output must stay quiet after such a prompt before it counts as a
# question: a form may print the words itself and go on printing.
QUESTION_QUIET = 0.5
# The answer No to each: one character for Y-OR-N-P, a line for YES-OR-NO-P.
QUESTION_NO = {'Y or N': b'N', 'Yes or No': b'No\r\n'}


class Session:
    def __init__(self, sock, log, helper):
        self.s, self.log, self.helper = sock, log, helper
        self.buf = ''
        self.tag = random.randrange(100000, 900000)
        # the tag of a case answered No to a question and still running: its
        # answer comes before the next case's (see _settle)
        self.pending = None
        self.last_data = now()

    def _read(self):
        try:
            d = self.s.recv(4096)
        except socket.timeout:
            return
        if not d:
            raise RunFailed('the TELNET connection closed')
        t = d.decode('latin-1')
        self.buf += t
        self.log.write(t)
        self.last_data = now()

    def _question(self, after):
        """The bare question at the end of AFTER, the text after the case's
        echo, once the output has been quiet for QUESTION_QUIET; else None.
        Not while the case's own answer is being printed: a value holding the
        words is inside the markers, which the case's answer opens."""
        m = QUESTION_RE.search(after)
        if not m or now() - self.last_data < QUESTION_QUIET:
            return None
        return m

    def run(self, form, timeout, progress=None):
        """Evaluate form; return ('value', printed value, output before it),
        ('error', message, output before it), ('asked', the question, output
        before it), a question asked through FQUERY, which ended the form, or
        ('question', the question, output before it), a bare "(Y or N)" or
        "(Yes or No)" seen in the output and answered No.
        The form runs inside a condition-case, so an error prints its
        message rather than asking whether to enter the debugger; in a
        checkpointed world through
        HELPER, compiled at setup, since the listener takes 0.3 s more to
        evaluate a condition-case form than to call a compiled function.  The
        markers are printed with ~D from numbers, so the echo of the form
        never holds them.  With PROGRESS (the setup's forms), its check()
        ends the wait rather than TIMEOUT, and the time taken is logged."""
        deadline = progress.end if progress else now() + timeout
        if self.pending is not None:
            self._settle(deadline, form)
        self.tag += 1
        k = self.tag
        self.buf = ''
        self.log.write('\n=== %.2f %s\n' % (now(), form))
        if self.helper:
            sent = "(lispm-check-case %d '%s)" % (k, form)
        else:
            sent = CASE_FORM % {'k': k, 'form': form}
        self.s.sendall((sent + '\r\n').encode('latin-1'))
        echo_end = sent[-24:]
        answer = re.compile(r'\{%d([{!?])(.*?)[}!?]%d\}' % (k, k), re.S)
        opened = re.compile(r'\{%d[{!?]' % k)
        while True:
            m = answer.search(self.buf)
            if m:
                # what the form printed: after the echoed line, before the answer
                out = self.buf[:m.start()].split(echo_end, 1)[-1]
                if progress:
                    self.log.write('\n=== %.2f answered in %.1f s, %.1f s of the machine\'s CPU time\n'
                                   % ((now(),) + progress.used()))
                return {'{': 'value', '!': 'error', '?': 'asked'}[m.group(1)], m.group(2), out
            m = ERROR_RE.search(self.buf)
            if m and ('(Y or N)' in self.buf[m.start():] or '\n->' in self.buf[m.start():]):
                # An error the condition-case did not catch: leave it for top level.
                msg = self.buf[m.start():].split('\r\n\r\n', 1)[0]
                out = self.buf[:m.start()].split(echo_end, 1)[-1]
                self._abort(deadline)
                return 'error', msg, out
            if echo_end in self.buf and not m and not opened.search(self.buf):
                # A bare question, with no error before it: the case fails,
                # naming it, and is answered No so that the form goes on.  It
                # ends later; the next case waits for that (_settle).
                out = self.buf.split(echo_end, 1)[1]
                q = self._question(out)
                if q:
                    self.s.sendall(QUESTION_NO[q.group(2)])
                    self.pending = k
                    self.buf = ''
                    return 'question', q.group(1).strip(), out[:q.start()]
            if progress:
                progress.check()
            elif now() > deadline:
                raise RunFailed('no answer in %g s to %s' % (timeout, oneline(form)))
            self._read()

    def _settle(self, deadline, form):
        """Wait for the case answered No to a question to end: its answer,
        an error (left for top level as in run), or another question, answered
        No too, before the next case, FORM, is sent."""
        k, self.pending = self.pending, None
        answer = re.compile(r'\{%d[{!?].*?[}!?]%d\}' % (k, k), re.S)
        opened = re.compile(r'\{%d[{!?]' % k)
        while not answer.search(self.buf):
            m = ERROR_RE.search(self.buf)
            if m and ('(Y or N)' in self.buf[m.start():] or '\n->' in self.buf[m.start():]):
                self._abort(deadline)
                return
            q = None if m or opened.search(self.buf) else self._question(self.buf)
            if q:
                self.s.sendall(QUESTION_NO[q.group(2)])
                self.buf = ''
            if now() > deadline:
                raise RunFailed('no answer in time to a question\'s case, before %s' % oneline(form))
            self._read()

    def _abort(self, deadline):
        """Answer the debugger's question No, or leave the debugger with
        control-Z, and wait for the listener's top level."""
        self.s.sendall(b'N' if '(Y or N)' in self.buf else b'\x1a')
        self.buf = ''
        while 'Back to top level' not in self.buf:
            if now() > deadline:
                raise RunFailed('the listener did not come back to top level')
            self._read()


def oneline(form):
    return ' '.join(form.split())


def normal(text):
    return ' '.join(text.replace('\r', ' ').split())


# --------------------------------------------------------------------------
# The cases file.

def parse_cases(path):
    """Cases as (form, kind, text): kind None (no error), '=>' or '=>!'."""
    text = open(path, encoding='latin-1').read()
    cases, i, n = [], 0, len(text)
    while i < n:
        c = text[i]
        if c in ' \t\r\n':
            i += 1
            continue
        if c == ';':
            i = text.find('\n', i)
            i = n if i < 0 else i
            continue
        start, depth, instr, inbar = i, 0, False, False
        while i < n:
            c = text[i]
            if c == '/':
                i += 2
                continue
            if instr:
                instr = c != '"'
            elif inbar:
                inbar = c != '|'
            elif c == '"':
                instr = True
            elif c == '|':
                inbar = True
            elif c == '(':
                depth += 1
            elif c == ')':
                depth -= 1
                if depth == 0:
                    i += 1
                    break
            elif depth == 0 and c in ' \t\r\n':
                break
            elif depth > 0 and c == ';':
                i = text.find('\n', i)
                i = n if i < 0 else i
                continue
            i += 1
            if depth == 0 and not instr and not inbar and c == '"' and i > start + 1:
                break
        form = text[start:i]
        if depth != 0 or instr or inbar:
            raise RunFailed('%s: unbalanced form: %s' % (path, oneline(form)[:80]))
        end = text.find('\n', i)
        end = n if end < 0 else end
        rest = text[i:end].strip()
        i = end
        if rest.startswith('=>!'):
            cases.append((form, '=>!', rest[3:].strip()))
        elif rest.startswith('=>'):
            cases.append((form, '=>', rest[2:].strip()))
        elif rest == '' or rest.startswith(';'):
            cases.append((form, None, ''))
        else:
            raise RunFailed('%s: after %s: expected => or =>!, found %s'
                            % (path, oneline(form)[:60], rest[:40]))
    return cases


# --------------------------------------------------------------------------
# Setup: the checkpoint of the band at its prompt.

def run_dir_new(kind):
    d = os.path.join(cache_dir(), 'runs', '%s-%s-%d-%04x' % (
        kind, time.strftime('%Y%m%d-%H%M%S'), os.getpid(), random.randrange(65536)))
    os.makedirs(d)
    return d


def checkpoint_path(key):
    return os.path.join(cache_dir(), 'checkpoints', key + '.chk')


def ensure_checkpoint(a, key, link=None):
    chk = checkpoint_path(key)
    if os.path.exists(chk):
        return chk, None
    os.makedirs(os.path.dirname(chk), exist_ok=True)
    lock = Lock('setup-' + key)
    try:
        if os.path.exists(chk):
            return chk, None
        if not os.path.isfile(os.path.join(a.ubin, 'ucadr.tbl')):
            raise RunFailed('no ucadr.tbl in %s (--ubin): the cold boot reads it' % a.ubin)
        t0 = now()
        print('lispm-check: setting up a checkpoint for this band and %s, files served by %s,'
              ' engine %s%s (cold boot)' % (MACHINE, a.file_server, a.engine,
                                         ', tap index %d, over %s' % (link.index, a.network) if link else ''),
              flush=True)
        run_dir = run_dir_new('setup')
        end = now() + a.setup_limit
        ports_lock, ports = take_ports()
        log = open(os.path.join(run_dir, 'telnet.log'), 'w', buffering=1)
        server = FILE_SERVERS[a.file_server](a.ozd, run_dir, ports, log, a.ozd_flags, a.network, link)
        machine = Machine(a.exe, a.band, run_dir, ports[3], server, a.engine)
        tmp = chk + '.%d.tmp' % os.getpid()
        try:
            server.lay_out(a.tree, a.ubin)
            server.start()
            machine.start(checkpoint_out=tmp)
            try:
                sock, _ = server.connect_listener(
                    machine.alive, None, Progress(machine, 'the boot (the TELNET banner)', end))
            except RunFailed as e:
                if getattr(e, 'stopped', False):
                    raise
                # A band whose SYS: is on the file device's host (HOST or
                # FILES) waits at boot, with no TELNET server, when its files
                # are not on quux's file device.
                # Or the band is not one this machine runs: a System 1002 band
                # for QUUX (microcode 1000) waits for ever at DISK-AWAIT-READY
                # on quux revision 11 and later, which moved block-disk off
                # 17377774, and so gives no sign but this.
                # Over TCP a band without the network, or one whose
                # address is not its tap's, gives the same sign.
                raise type(e)('%s: the band did not reach its TELNET prompt with its files served'
                              ' by %s; is its SYS: on %s? (--file-server) Is it a band %s runs?%s%s'
                              % (e, a.file_server, ' or '.join(server.hosts), MACHINE,
                                 ' (a System 1002 band does not run on quux revision 11 and later)'
                                 if MACHINE == 'quux' else '',
                                 ' Over TCP: does the band start its network, and answer at %s, port %d,'
                                 ' behind %s? (--network chaos needs no network)'
                                 % (link.quux, TELNET_PORT, link.tap) if a.network == 'tcp' else ''))
            sock.settimeout(0.2)
            sess = Session(sock, log, helper=False)
            # The server must be the one the band reads SYS: from: a band
            # whose SYS: is on OZ boots with the tree on the file device too,
            # but would then load every SYS: file from nowhere.
            r = sess.run(SYS_HOST, None, Progress(machine, oneline(SYS_HOST), end))
            if r[0] != 'value':
                raise RunFailed('setup: %s: %s' % (SYS_HOST, r[1]))
            sys_host = r[1].strip('"')
            # A host the server serves, which the login and the served files
            # then name: the device's either name, HOST or FILES, as the band
            # answers.  The check compared it with the server's one constant
            # host, which refused a band whose SYS: is on FILES:
            #   if sys_host != server.login_host:
            #       raise RunFailed("the band's SYS: is on %s, but --file-server %s serves %s"
            #                       % (sys_host, a.file_server, server.login_host))
            server.learn_host(sys_host)
            # Log in, define and compile the helper, then close the band's file connection, so the first file
            # access after a resume opens a new one rather than using a
            # connection whose ozd has gone (which closed the TELNET session).
            for form in (server.login(), HELPER, "(compile 'lispm-check-case)", '(fs:reset-file-access)'):
                r = sess.run(form, None, Progress(machine, oneline(form), end))
                if r[0] != 'value':
                    raise RunFailed('setup: %s: %s' % (form, r[1]))
            # over TCP a clean close, so that the checkpoint holds no
            # connection (the contract, sections 2.9 and 7)
            server.close_session(sock, True, Progress(machine, 'the clean close', end))
            machine.stop(wait=120)
            if machine.proc.returncode != 0 or not os.path.exists(tmp):
                raise RunFailed('%s wrote no checkpoint (see %s/%s.log)' % (MACHINE, run_dir, MACHINE))
            os.replace(tmp, chk)
            with open(chk[:-4] + '.json', 'w') as f:
                made = {'band': os.path.abspath(a.band), 'band_sha256': a.band_sha,
                        MACHINE: a.exe, MACHINE + '_sha256': a.exe_sha,
                        MACHINE + '_version': a.exe_version, 'file_server': a.file_server,
                        'engine': a.engine,
                        'sys_host': sys_host, 'made': time.strftime('%Y-%m-%d %H:%M:%S')}
                if link:
                    # the tap it was made on and both addresses (the
                    # contract, amendment 2, 5.1), and the network that
                    # carried the setup's session; either resumes it
                    made.update(revision=a.revision, tap=link.tap, tap_index=link.index,
                                ip_address='%s/%s' % (link.quux, link.prefix), ip_gateway=link.gateway,
                                network=a.network)
                json.dump(made, f, indent=1)
        finally:
            machine.stop(wait=5)
            server.stop()
            ports_lock.release()
            if os.path.exists(tmp):
                os.unlink(tmp)
            if not os.path.exists(chk):
                print('lispm-check: setup files kept in %s' % run_dir, file=sys.stderr)
        if a.keep:
            print('lispm-check: setup files kept in %s' % run_dir, file=sys.stderr)
        else:
            shutil.rmtree(run_dir, ignore_errors=True)
        return chk, now() - t0
    finally:
        lock.release()


# --------------------------------------------------------------------------
# A check.

def checkpoint_host(chk):
    """The host the band's SYS: is on, as the setup of the checkpoint CHK
    asked it (its JSON's sys_host): the host a check names served files on.
    tools/tcp-check/run takes it for its server too."""
    try:
        with open(chk[:-4] + '.json') as f:
            host = json.load(f).get('sys_host')
    except (OSError, ValueError) as e:
        raise RunFailed('%s: no record of the band\'s SYS: host (%s)' % (chk, e))
    if not host:
        raise RunFailed('%s: no record of the band\'s SYS: host' % chk)
    return host


def check(a, chk, cases, link=None):
    # the host the setup's band answered, which the served files are named on
    # (the device's HOST or FILES); the server was made knowing only its own:
    #   server = FILE_SERVERS[a.file_server](a.ozd, run_dir, ports, log, a.ozd_flags, a.network, link)
    host = checkpoint_host(chk)
    run_dir = run_dir_new('check')
    ports_lock, ports = take_ports()
    log = open(os.path.join(run_dir, 'telnet.log'), 'w', buffering=1)
    server = FILE_SERVERS[a.file_server](a.ozd, run_dir, ports, log, a.ozd_flags, a.network, link,
                                         host=host)
    machine = Machine(a.exe, a.band, run_dir, ports[3], server, a.engine)
    results, t0 = [], now()
    ok_run = False
    try:
        server.lay_out(a.tree)
        loads = [server.place(f, a.tree) for f in a.files]
        server.start()
        machine.start(resume=chk)
        sock, _ = server.connect_listener(machine.alive, now() + 60)
        sock.settimeout(0.2)
        sess = Session(sock, log, helper=True)
        t_banner = now() - t0
        for (name, logical), path in zip(loads, a.files):
            t1 = now()
            if a.compile:
                steps = ['(qc-file "%s LISP")' % name if logical else '(qc-file "%s.lisp")' % name,
                         '(let ((si:inhibit-fdefine-warnings t)) (load "%s QFASL"))' % name if logical
                         else '(let ((si:inhibit-fdefine-warnings t)) (load "%s.qfasl"))' % name]
            else:
                steps = ['(let ((si:inhibit-fdefine-warnings t)) (load "%s LISP"))' % name if logical
                         else '(let ((si:inhibit-fdefine-warnings t)) (load "%s.lisp"))' % name]
            for step in steps:
                r = sess.run(step, a.file_timeout)
                if r[0] != 'value':
                    raise RunFailed('%s: %s: %s' % (path, step, normal(r[1])))
                # What the step printed besides ;Loading lines: the compiler's
                # diagnostics, headed "<< While compiling F >>".  qc-file
                # reports a reader error as "<< Error in reading >>" and still
                # writes a QFASL, so such a heading fails the run.
                said = [l.strip() for l in r[2].replace('\r', '\n').split('\n')
                        if l.strip() and not l.strip().startswith((';', 'Loading '))]
                for w in said:
                    print('WARN  %s: %s' % (os.path.basename(path), w))
                if any(re.match(r'<< *Error', w) for w in said):
                    raise RunFailed('%s: %s: the compiler reported an error' % (path, step))
            shown = os.path.relpath(path, a.tree)
            shown = path if shown.startswith('..') else shown
            print('FILE  %s  %s in %.2f s' % (shown, 'compiled and loaded' if a.compile else 'loaded',
                                             now() - t1), flush=True)
        for form, kind, text in cases:
            r = sess.run(form, a.timeout)
            shown = oneline(form)
            if r[0] == 'asked':
                # whatever the case expected: it asked through FQUERY, and the
                # helper ended the form there
                verdict, why = 'FAIL', 'asked %s, the form ended there' % normal(r[1])
            elif r[0] == 'question':
                # a prompt seen in the output, which the FQUERY clause did not
                # catch: answered No, the form went on
                verdict, why = 'FAIL', 'asked %s, answered No' % normal(r[1])
            elif r[0] == 'value':
                val = normal(r[1])
                if kind == '=>!':
                    verdict, why = 'FAIL', '%s, expected an error' % val
                elif kind == '=>' and val != normal(text):
                    verdict, why = 'FAIL', '%s, expected %s' % (val, normal(text))
                else:
                    verdict, why = 'PASS', val
            else:
                msg = normal(r[1])
                if kind == '=>!' and normal(text) in msg:
                    verdict, why = 'PASS', msg
                elif kind == '=>!':
                    verdict, why = 'FAIL', '%s, expected an error with %s' % (msg, normal(text))
                else:
                    verdict, why = 'ERROR', msg
            results.append(verdict)
            print('%s  %s  -> %s' % (verdict, shown, why), flush=True)
        # over TCP the clean close here too, not checked: nothing is saved
        server.close_session(sock, False)
        ok_run = True
    finally:
        log.write('\n=== %.2f stop\n' % now())
        machine.stop()
        log.write('\n=== %.2f %s stopped (rc %s)\n' % (now(), MACHINE, machine.proc and machine.proc.returncode))
        server.stop()
        log.write('\n=== %.2f ozd stopped\n' % now())
        ports_lock.release()
        if ok_run and not a.keep:
            shutil.rmtree(run_dir, ignore_errors=True)
        else:
            # the relay's report and log join the run's files when the run
            # ends (main stops the relay after the machine)
            a.kept_run_dir = run_dir
            print('lispm-check: run files kept in %s' % run_dir, file=sys.stderr)
    return results, t_banner, now() - t0


def has_file_device(exe):
    # quux's file device; cadr has none
    return '--file-root' in subprocess.run([exe, '--help'], capture_output=True, text=True).stdout


def probe_sys_host(a):
    """Boot the band cold with the tree served both ways and ask it which
    host its SYS: is on (about 15 s)."""
    run_dir = run_dir_new('probe')
    end = now() + a.setup_limit
    ports_lock, ports = take_ports()
    log = open(os.path.join(run_dir, 'telnet.log'), 'w', buffering=1)
    server = ProbeFileServer(a.ozd, run_dir, ports, log, a.ozd_flags)
    machine = Machine(a.exe, a.band, run_dir, ports[3], server, a.engine)
    ok = False
    try:
        server.lay_out(a.tree, a.ubin)
        server.start()
        machine.start()
        sock, _ = server.connect_listener(
            machine.alive, None, Progress(machine, 'the boot (the TELNET banner)', end))
        sock.settimeout(0.2)
        r = Session(sock, log, helper=False).run(
            SYS_HOST, None, Progress(machine, oneline(SYS_HOST), end))
        sock.close()
        if r[0] != 'value':
            raise RunFailed('probe: %s: %s' % (SYS_HOST, r[1]))
        ok = True
        return r[1].strip('"')
    finally:
        machine.stop(wait=5)
        server.stop()
        ports_lock.release()
        if ok:
            shutil.rmtree(run_dir, ignore_errors=True)
        else:
            print('lispm-check: probe files kept in %s' % run_dir, file=sys.stderr)


def choose_file_server(a):
    """--file-server auto: device when the band's SYS: is on the file
    device's host, HOST or FILES, ozd when it is on OZ, and ozd with a
    machine that has no file device (cadr).  The band's answer
    is taken from a checkpoint of this band and machine already made (its setup
    asked the band), else from the answers remembered under the cache, else
    from a probe: a cold boot that asks the band, once for each band and machine.
    Every run says which server it chose and why."""
    has_device = has_file_device(a.exe)
    if a.file_server == 'device' and not has_device:
        raise RunFailed('--file-server device: %s has no file device (no --file-root)' % a.exe)
    if a.file_server != 'auto':
        return a.file_server
    if not has_device:
        print('lispm-check: files served by ozd: %s has no file device (auto)' % MACHINE)
        return 'ozd'
    if a.network == 'tcp':
        # ozd serves its files over Chaos, which a TCP session does without;
        # a band whose SYS: is on OZ is refused by the setup's check
        print('lispm-check: files served by device: the session is over TCP (auto)')
        return 'device'
    pair = '%s-%s' % (a.band_sha[:16], a.exe_sha[:16])
    sys_host, source = None, None
    for chk_json in sorted(glob.glob(os.path.join(cache_dir(), 'checkpoints', pair + '-*.json'))):
        try:
            with open(chk_json) as f:
                sys_host, source = json.load(f).get('sys_host'), 'its checkpoint'
        except (OSError, ValueError):
            continue
        if sys_host:
            break
    db = os.path.join(cache_dir(), 'sys-hosts.json')
    if not sys_host:
        lock = Lock('probe-' + pair)
        try:
            try:
                with open(db) as f:
                    known = json.load(f)
            except (OSError, ValueError):
                known = {}
            sys_host, source = known.get(pair, {}).get('sys_host'), 'the probe remembered'
            if not sys_host:
                print("lispm-check: asking the band where its SYS: is (auto; a cold boot, once)", flush=True)
                t0 = now()
                sys_host, source = probe_sys_host(a), 'the probe, %.1f s' % (now() - t0)
                known[pair] = {'band': os.path.abspath(a.band), MACHINE: a.exe,
                               'sys_host': sys_host, 'asked': time.strftime('%Y-%m-%d %H:%M:%S')}
                tmp = '%s.%d' % (db, os.getpid())
                with open(tmp, 'w') as f:
                    json.dump(known, f, indent=1)
                os.replace(tmp, db)
        finally:
            lock.release()
    # each server's hosts (FILE_SERVERS), so a band whose SYS: is on FILES
    # means device as one on HOST does; the map named HOST alone:
    #   mode = {'HOST': 'device', 'OZ': 'ozd'}.get(sys_host)
    mode = {h: m for m, c in FILE_SERVERS.items() for h in c.hosts}.get(sys_host)
    if mode is None:
        raise RunFailed("auto: the band's SYS: is on %s, which neither server serves" % sys_host)
    print("lispm-check: files served by %s: the band's SYS: is on %s (auto, from %s)"
          % (mode, sys_host, source))
    return mode


def options(argv=None):
    """The command line (ARGV, or the process's), parsed, with every default
    resolved and every path made absolute.  tools/tcp-check/run takes this
    tool's flags through it."""
    tree_default = os.environ.get('LISPM_CHECK_TREE') or os.path.dirname(TOOL_DIR)
    p = argparse.ArgumentParser(description='Check a Lisp change on a band.',
                                epilog='See the header of this file for the CASES syntax.')
    p.add_argument('cases')
    p.add_argument('--tree', default=tree_default)
    p.add_argument('--band', default=os.environ.get('LISPM_CHECK_BAND'))
    p.add_argument('--ubin', default=os.environ.get('LISPM_CHECK_UBIN'))
    # --quux on main, --cadr on the cadr line; there --quux is taken as well,
    # as the same flag, so that a command line written for main still runs
    names = ['--' + MACHINE] + (['--quux'] if MACHINE != 'quux' else [])
    p.add_argument(*names, dest='exe', metavar='PATH',
                   default=os.environ.get('LISPM_CHECK_' + MACHINE.upper()),
                   help="the simulator's %s executable" % MACHINE)
    p.add_argument('--ozd', default=os.environ.get('LISPM_CHECK_OZD'))
    p.add_argument('--files', default='')
    p.add_argument('--file-server', choices=('auto', 'device', 'ozd'),
                   default=os.environ.get('LISPM_CHECK_FILE_SERVER', 'auto'),
                   help="how the tree is served: quux's file device, ozd, or auto")
    # Checked below rather than by choices=, since argparse does not check a
    # default, and the default may come from LISPM_CHECK_ENGINE.
    p.add_argument('--engine', metavar='{micro,rtl}',
                   default=os.environ.get('LISPM_CHECK_ENGINE') or 'micro',
                   help="the machine's engine, micro (the default) or rtl, passed as --micro or --rtl")
    p.add_argument('--compile', action='store_true')
    p.add_argument('--timeout', type=float, default=120, help='seconds a case may take')
    p.add_argument('--file-timeout', type=float, default=900,
                   help='seconds a file may take to compile or load')
    p.add_argument('--keep', action='store_true', help='keep the run directory')
    p.add_argument('--setup-limit', type=float,
                   default=float(os.environ.get('LISPM_CHECK_SETUP_LIMIT') or SETUP_LIMIT),
                   help="the hard limit in wall seconds on the setup's and the probe's cold"
                        " boot; within it they wait as long as the machine runs (exit 3 past it)")
    p.add_argument('--ozd-file-dates', choices=('mit', 'utc'),
                   default=os.environ.get('LISPM_CHECK_OZD_FILE_DATES') or None,
                   help="ozd's --file-dates: FILE's dates in UTC (ozd's default), or at"
                        " --ozd-timezone as Systems 100 to 1001 read them (mit)")
    # Which network carries the TELNET session (the contract, section 8 R1):
    # checked below rather than by choices=, as --engine is.  None, when
    # neither the flag nor the variable names one, is resolved by the
    # machine's revision in prepare (QUUX's Ethernet contract, section 8
    # R2): tcp on 16, chaos below and on the CADR.  It was chaos for every
    # run before the switch:
    #   default=os.environ.get('LISPM_CHECK_NETWORK') or 'chaos',
    p.add_argument('--network', metavar='{%s}' % ','.join(NETWORKS),
                   default=os.environ.get('LISPM_CHECK_NETWORK') or None,
                   help="what carries the TELNET session: chaos, through ozd, or tcp, the build"
                        " host's TCP to the band behind its tap; by default tcp on revision 16"
                        " and chaos on revisions 13-15 and the CADR")
    p.add_argument('--ozd-timezone', type=int,
                   default=os.environ.get('LISPM_CHECK_OZD_TIMEZONE') or None,
                   help="ozd's --timezone under --ozd-file-dates mit: the band's site zone,"
                        " hours west of Greenwich")
    a = p.parse_args(argv)
    if a.engine not in ('micro', 'rtl'):
        p.error("--engine (or LISPM_CHECK_ENGINE): %r is neither micro nor rtl" % a.engine)
    if a.network is not None and a.network not in NETWORKS:
        p.error("--network (or LISPM_CHECK_NETWORK): %r is not one of %s" % (a.network, ', '.join(NETWORKS)))
    a.tree = os.path.abspath(a.tree)
    up = os.path.dirname(a.tree)
    a.band = a.band or os.path.join(a.tree, 'run', 'check', 'band.img')
    a.ubin = a.ubin or os.path.join(os.path.dirname(a.band), 'ubin')
    a.exe = a.exe or os.path.join(up, 'muir-sim', 'target', 'release', MACHINE)
    a.ozd = a.ozd or os.path.join(up, 'ozd', 'target', 'release', 'ozd')
    # the machine and ozd run in the run directory, so every path is made absolute
    a.band, a.ubin, a.exe, a.ozd = (os.path.abspath(x) for x in (a.band, a.ubin, a.exe, a.ozd))
    a.files = [os.path.abspath(f) for f in a.files.split(',') if f]
    a.ozd_flags = []
    if a.ozd_file_dates:
        a.ozd_flags += ['--file-dates', a.ozd_file_dates]
    if a.ozd_timezone is not None:
        a.ozd_flags += ['--timezone', str(a.ozd_timezone)]
    return a


def prepare(a):
    """Everything before the check itself: the paths checked, the machine's
    revision asked, the file server chosen, on revision 16 a tap taken, and
    the checkpoint for this key made when there is none.  Returns (the tap's
    TapLink or None, the checkpoint, the setup's time or None); the caller
    stops the link after its machine.  RunFailed or RunHung otherwise, with
    the link stopped."""
    link = None
    try:
        # ozd's path is checked once the network is known, below: the
        # default network depends on the revision, asked of the machine
        for what, path in (('band', a.band), (MACHINE, a.exe)):
            if not os.path.isfile(path):
                raise RunFailed('no %s at %s' % (what, path))
        for f in a.files:
            if not os.path.isfile(f):
                raise RunFailed('no file %s' % f)
        # ozd refuses a zone under utc, its default; said here rather than
        # left to ozd's log
        if a.ozd_timezone is not None and a.ozd_file_dates != 'mit':
            raise RunFailed('--ozd-timezone needs --ozd-file-dates mit: ozd refuses a zone'
                            ' under utc, its default')
        a.band_sha = sha256_cached(a.band)
        a.exe_sha = sha256_cached(a.exe)
        a.exe_version = subprocess.run([a.exe, '-V'], capture_output=True, text=True).stdout.strip()
        # revision 16 has the Ethernet device, and every run on it takes a tap
        a.revision = machine_revision(a, a.exe_sha)
        # the network named, or the default for the revision (section 8 R2)
        a.network_named = a.network is not None
        a.network = resolve_network(a.network, a.revision)
        # started only over Chaos or for an OZ band, which TCP refuses
        if a.network != 'tcp' and not os.path.isfile(a.ozd):
            raise RunFailed('no ozd at %s' % a.ozd)
        a.file_server = choose_file_server(a)
        if a.network == 'tcp' and a.file_server != 'device':
            raise RunFailed('--network tcp%s: ozd serves the files over Chaos; a band whose SYS: is on OZ'
                            ' wants --network chaos'
                            % ('' if a.network_named else ', the default on revision 16'))
        # The key names the file server, since the setup logs in to that
        # server's host.  The device's folders are not in it: a checkpoint
        # carries none, quux mounting each check's own copy from its flags.
        # ozd's has no server suffix, as before there was a choice.  The
        # engine is in it too, since the machine resumes a checkpoint only on the
        # engine that wrote it: one made on micro must not be taken for a
        # check on rtl (so the checkpoints made before it are made again).
        tapped = a.revision is not None and a.revision >= 16
        key = '%s-%s-%s-%s' % (a.band_sha[:16], a.exe_sha[:16], SETUP_VERSION_TAP if tapped else SETUP_VERSION,
                               a.engine)
        key = key if a.file_server == 'ozd' else key + '-' + a.file_server
        # revision 16's two networks give the machine different Chaos
        # switches since R3 (machine_flags), so each has its own checkpoint
        if tapped and a.network == 'chaos':
            key += '-chaos'
        if tapped:
            # A checkpoint for each tap index, keyed by QUUX's address behind
            # it (the contract, amendment 2, 5.1); the taps tried are those
            # whose index has one for this key, lowest first, then the rest,
            # so that a key's runs keep to as few indexes as run at once.
            taps = tap_range()
            taps = ([t for t in taps if os.path.exists(checkpoint_path(key + '-' + t[2]))]
                    + [t for t in taps if not os.path.exists(checkpoint_path(key + '-' + t[2]))])
            link = TapLink(taps, now() + a.setup_limit)
            key += '-' + link.quux
            print('lispm-check: tap %s, QUUX at %s, TELNET over %s%s'
                  % (link.tap, link.quux, a.network,
                     '' if a.network_named else ' (the default on revision 16)'))
        chk, t_setup = ensure_checkpoint(a, key, link)
        return link, chk, t_setup
    except BaseException:
        if link:
            link.stop()
        raise


def main():
    a = options()

    def on_signal(sig, frame):
        raise SystemExit(128 + sig)
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, on_signal)

    link = None
    try:
        if not os.path.isfile(a.cases):
            raise RunFailed('no cases at %s' % a.cases)
        cases = parse_cases(a.cases)
        link, chk, t_setup = prepare(a)
        if t_setup is not None:
            print('lispm-check: checkpoint made in %.1f s' % t_setup)
        results, t_banner, t_all = check(a, chk, cases, link)
    except RunHung as e:
        print('lispm-check: HANG: %s' % e, file=sys.stderr)
        return 3
    except RunFailed as e:
        print('lispm-check: %s' % e, file=sys.stderr)
        return 2
    finally:
        # the relay last, after every machine it served has stopped
        if link:
            link.stop(getattr(a, 'kept_run_dir', None))
    passed = results.count('PASS')
    print('lispm-check: %d passed, %d failed, %d errors, of %d (banner %.2f s, all %.2f s)'
          % (passed, results.count('FAIL'), results.count('ERROR'), len(results), t_banner, t_all))
    return 0 if passed == len(results) else 1


if __name__ == '__main__':
    sys.exit(main())
