#!/usr/bin/env python3
"""The fault relay: a pooled tap at one end, muir's --ethernet-socket at the
other, with counts and its own check of every Ethernet frame the band sends
(QUUX's Ethernet contract, sections 3 and 9).

usage:
  relay [--tap NAME[,NAME...]] [--report FILE] [FAULTS] PATH
  relay --help

It is the Ethernet frame mover (muir-sim's tools/ethernet-frame-mover) with
the fault relay's additions, and takes a tap the same way, so that a caller
treats the two alike:

  --tap NAME[,NAME...]  the taps to try, in order.  A tap another program
                        holds is passed for the next; a named tap that is
                        missing, not a tap, not the user's or not host-only
                        is refused with that reason.  [default: the pool
                        from quux0 up, as far as it goes]
  --report FILE         where the counts and the check's findings are
                        written, as JSON: when the relay ends (SIGTERM, ^C)
                        and on SIGUSR1.  [default: none]

It listens at PATH, a UNIX stream socket muir's --ethernet-socket connects
to in its plain mode (each Ethernet frame a 32-bit big-endian length and its
bytes), and once it holds a tap prints one line on stdout, the mover's:

  quux1 --ip-address 169.254.101.2/30 --ip-gateway 169.254.101.1

the tap, and the two flags quux wants behind it, read from the kernel: the
tap's own address and prefix are the host side and the band's gateway, and
the band's address is the /30's other host address.  It takes host-only taps
only, each with a /30 of its own (the contract's section 3, amendment 3): a
LAN tap, which has no address of its own, is refused.

One machine is connected at a time.  A machine that closes leaves the relay
holding its tap for the next, so that one run of lispm-check, its setup's
machine and then its check's, holds one tap throughout.  While none is
connected, what the tap gives is dropped and counted.

**The counts:** Ethernet frames and bytes each way, by Ethernet type, and
those dropped with no machine connected.  **The check** (section 9, T4: "the
fault relay checks, with its own code, every Ethernet frame the band sends"):
an ARP frame is 42 bytes; an IPv4 one is version 4 with IHL 5 or more, its
length 14 + TL, its header checksum good, and a TCP, UDP or ICMP payload's
checksum good (RFC 791, 768, 792, 9293, the sum of RFC 1071, written out
here); any other type is bad.  A bad frame is moved all the same: the
relay reports, it does not filter, and Linux behind the tap checks again.

**The faults** (section 9, T4), seeded, on the directions --direction
names (to-band, from-band, both):

  --seed N        the random generator's seed [default: 1]
  --loss P        a frame lost, P percent of the time
  --duplicate P   a frame sent twice, the copy 1 ms after
  --reorder P     a frame held 20 ms, so that the frames after it overtake it
  --corrupt P     toward the band only: one byte inside the IPv4 datagram
                  changed, counted
  --jitter MS     each frame delayed by a uniform 0 to MS ms, a direction's
                  order kept
  --inject N      N frames of 0x86DD, 0x0804 and 0x8100 in turn toward the
                  band, one after each frame the band sends
  --arm-on-signal none of them until SIGUSR2

The report's "faults" says what each did, and each direction's "resent" the
TCP segments resent on it (the band's from it, Linux's toward it).

Exit status: 0 at the end, 2 for a usage error, 75 when every tap tried was
taken (sysexits.h's EX_TEMPFAIL, the mover's), so that a caller may wait and
try again, and 1 otherwise.  Python's standard library only.
"""

import errno
import fcntl
import heapq
import json
import os
import random
import select
import signal
import socket
import stat
import struct
import sys
import time

PROGRAM = 'relay'

# <linux/if_tun.h>: TUNSETIFF is _IOW('T', 202, int).
TUNSETIFF = 0x400454CA
IFF_TAP = 0x0002
IFF_NO_PI = 0x1000
# <linux/sockios.h>
SIOCGIFADDR = 0x8915
SIOCGIFNETMASK = 0x891B
IFNAMSIZ = 16

POOL, POOL_MAX = 'quux', 64     # quux-taps makes quux0 to quux<N-1>, N at most 64
TAKEN = 75                      # every tap tried was taken

ETH_IPV4, ETH_ARP = 0x0800, 0x0806
PROTO_ICMP, PROTO_TCP, PROTO_UDP = 1, 6, 17
# How many bad frames the report describes one by one; the rest are counted.
BAD_SHOWN = 50


class Refused(Exception):
    def __init__(self, message, status=1):
        Exception.__init__(self, message)
        self.status = status


def dotted(a):
    return socket.inet_ntoa(struct.pack('!I', a))


def ifreq(name, rest=b''):
    return struct.pack('%ds' % IFNAMSIZ, name.encode()) + rest.ljust(24, b'\0')


def host_only_addresses(name):
    """The tap's own IPv4 address and the band's, (host, quux), from the
    kernel; a tap with no /30 of its own (a LAN tap, or none) is refused."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        got = []
        for request in (SIOCGIFADDR, SIOCGIFNETMASK):
            try:
                r = fcntl.ioctl(s.fileno(), request, ifreq(name))
            except OSError as e:
                if e.errno == errno.EADDRNOTAVAIL:
                    raise Refused('%s: no IPv4 address of its own, so not a host-only tap' % name)
                raise Refused('%s: its IPv4 address cannot be read: %s' % (name, e.strerror))
            got.append(struct.unpack('!I', r[20:24])[0])
    finally:
        s.close()
    host, mask = got
    if mask != 0xFFFFFFFC:
        raise Refused('%s: %s is not on a /30, so not a host-only tap' % (name, dotted(host)))
    net = host & mask
    if host == net + 1:
        return host, net + 2
    if host == net + 2:
        return host, net + 1
    raise Refused('%s: %s is not one of its /30\'s two host addresses' % (name, dotted(host)))


def open_tap(name):
    """A descriptor for the tap's Ethernet frames, or OSError (EBUSY: held)."""
    fd = os.open('/dev/net/tun', os.O_RDWR | os.O_CLOEXEC)
    try:
        fcntl.ioctl(fd, TUNSETIFF, ifreq(name, struct.pack('H', IFF_TAP | IFF_NO_PI)))
    except OSError:
        os.close(fd)
        raise
    return fd


def take(names, named):
    """The first of NAMES that can be taken: (name, fd, host, quux)."""
    why = []
    for name in names:
        if not name or '/' in name or len(name.encode()) >= IFNAMSIZ:
            why.append('%s: not a network interface\'s name' % name)
            continue
        if not os.path.exists('/sys/class/net/%s' % name):
            why.append('%s: no such tap' % name)
            continue
        if not os.path.exists('/sys/class/net/%s/tun_flags' % name):
            why.append('%s: not a tap' % name)
            continue
        try:
            host, quux = host_only_addresses(name)
        except Refused as e:
            why.append(str(e))
            continue
        try:
            return name, open_tap(name), host, quux
        except OSError as e:
            if e.errno == errno.EBUSY:
                why.append('%s: taken: another program holds it' % name)
            elif e.errno == errno.EPERM:
                why.append('%s: not this user\'s: quux-taps --user names the taps\' owner' % name)
            else:
                why.append('%s: %s' % (name, e.strerror))
    every_taken = bool(why) and all(': taken: ' in w for w in why)
    raise Refused('no tap of %s could be taken: %s' % ('the taps named' if named else 'the pool',
                                                       '; '.join(why)), TAKEN if every_taken else 1)


def pool():
    names = []
    for k in range(POOL_MAX):
        if not os.path.exists('/sys/class/net/%s%d' % (POOL, k)):
            break
        names.append('%s%d' % (POOL, k))
    if not names:
        raise Refused('no tap %s0: the pool is not installed (muir-sim\'s tools/quux-taps)' % POOL)
    return names


# --------------------------------------------------------------------------
# The check: the relay's own code, from the RFCs.

def ones_sum(data):
    """RFC 1071's one's-complement sum of DATA as 16-bit words, an odd last
    byte padded with a zero byte on its right."""
    if len(data) % 2:
        data = data + b'\0'
    total = sum(struct.unpack('!%dH' % (len(data) // 2), data))
    while total >> 16:
        total = (total & 0xFFFF) + (total >> 16)
    return total


def check_frame(f):
    """None when the Ethernet frame F the band sent is well formed with
    every checksum good, else what is wrong."""
    if len(f) < 14:
        return 'a frame of %d bytes, shorter than an Ethernet header' % len(f)
    t = struct.unpack('!H', f[12:14])[0]
    if t == ETH_ARP:
        if len(f) != 42:
            return 'ARP in %d bytes, not 42' % len(f)
        if f[14:22] != b'\x00\x01\x08\x00\x06\x04\x00\x01' and f[14:22] != b'\x00\x01\x08\x00\x06\x04\x00\x02':
            return 'ARP not for Ethernet and IPv4, or neither a request nor a reply'
        return None
    if t != ETH_IPV4:
        return 'Ethernet type 0x%04x, neither IPv4 nor ARP' % t
    if len(f) < 34:
        return 'IPv4 in %d bytes, shorter than its header' % len(f)
    if f[14] >> 4 != 4:
        return 'IPv4 version %d' % (f[14] >> 4)
    ihl = (f[14] & 15) * 4
    tl = struct.unpack('!H', f[16:18])[0]
    if ihl < 20:
        return 'IHL %d' % (ihl // 4)
    if 14 + tl != len(f):
        return 'a frame of %d bytes for TL %d: not 14 + TL' % (len(f), tl)
    if tl < ihl:
        return 'TL %d below the header\'s %d bytes' % (tl, ihl)
    if ones_sum(f[14:14 + ihl]) != 0xFFFF:
        return 'a bad IPv4 header checksum'
    frag = struct.unpack('!H', f[20:22])[0]
    if frag & 0x3FFF:
        return 'a fragment (MF or an offset)'
    proto, src, dst = f[23], f[26:30], f[30:34]
    p = f[14 + ihl:14 + tl]
    if proto == PROTO_TCP:
        if len(p) < 20 or (p[12] >> 4) * 4 < 20 or (p[12] >> 4) * 4 > len(p):
            return 'TCP in %d bytes, or a bad data offset' % len(p)
        if ones_sum(src + dst + struct.pack('!BBH', 0, PROTO_TCP, len(p)) + p) != 0xFFFF:
            return 'a bad TCP checksum'
    elif proto == PROTO_UDP:
        if len(p) < 8 or struct.unpack('!H', p[4:6])[0] != len(p):
            return 'UDP whose length is not its own'
        if p[6:8] != b'\0\0' and ones_sum(src + dst + struct.pack('!BBH', 0, PROTO_UDP, len(p)) + p) != 0xFFFF:
            return 'a bad UDP checksum'
    elif proto == PROTO_ICMP:
        if len(p) < 8:
            return 'ICMP in %d bytes' % len(p)
        if ones_sum(p) != 0xFFFF:
            return 'a bad ICMP checksum'
    return None


def sender(f):
    """The IPv4 sender an ARP or IPv4 frame names, or None."""
    if len(f) < 14:
        return None
    t = struct.unpack('!H', f[12:14])[0]
    if t == ETH_ARP and len(f) >= 42:
        return struct.unpack('!I', f[28:32])[0]
    if t == ETH_IPV4 and len(f) >= 34 and f[14] >> 4 == 4:
        return struct.unpack('!I', f[26:30])[0]
    return None


# --------------------------------------------------------------------------
# The faults (section 9, T4), seeded.

WAYS = ('to_band', 'from_band')
INJECT_TYPES = (0x86DD, 0x0804, 0x8100)
HOST_MAC = bytes.fromhex('020000000002')    # every tap's host side (section 3)
REORDER_HOLD = 0.020                         # seconds a reordered frame is held


class Faults:
    """What happens to each Ethernet frame on its way, in DIRECTION (to-band,
    from-band or both): lost with LOSS percent, sent twice with DUPLICATE,
    held REORDER_HOLD s so that the frames after it overtake it with
    REORDER, one byte inside its IPv4 datagram changed with CORRUPT (toward
    the band only, as section 9 has it), and delayed by a uniform 0 to
    JITTER ms, the frames of a direction kept in their order by it; and,
    with INJECT, that many Ethernet frames of other types (0x86DD, 0x0804,
    0x8100 in turn) sent toward the band, one after each frame the band
    sends.  One random generator, seeded, draws every choice in the order
    the frames come."""

    def __init__(self, seed=1, loss=0.0, duplicate=0.0, reorder=0.0, corrupt=0.0, jitter=0.0,
                 direction='both', inject=0, arm_on_signal=False):
        # ARM_ON_SIGNAL: no fault until SIGUSR2 arms them, so that a caller
        # reads the band's totals first, and a setup's cold boot runs clean
        self.armed = not arm_on_signal
        self.rng = random.Random(seed)
        self.loss, self.duplicate, self.reorder = loss / 100, duplicate / 100, reorder / 100
        self.corrupt, self.jitter, self.inject = corrupt / 100, jitter / 1000, inject
        self.direction = direction
        self.counts = {w: {'lost': 0, 'duplicated': 0, 'reordered': 0, 'corrupted': 0, 'delayed': 0}
                       for w in WAYS}
        self.counts['injected'] = 0
        self.counts['settings'] = {'seed': seed, 'loss': loss, 'duplicate': duplicate, 'reorder': reorder,
                                   'corrupt': corrupt, 'jitter_ms': jitter, 'direction': direction,
                                   'inject': inject}
        self.last_due = {w: 0.0 for w in WAYS}

    def none(self):
        return not (self.loss or self.duplicate or self.reorder or self.corrupt or self.jitter or self.inject)

    def active(self, way):
        return self.armed and (self.direction == 'both' or self.direction.replace('-', '_') == way)

    def plan(self, way, f, now):
        """[(when, frame)] for F, arriving at NOW on WAY."""
        if not self.active(way):
            return [(now, f)]
        c, rng = self.counts[way], self.rng
        if self.loss and rng.random() < self.loss:
            c['lost'] += 1
            return []
        if way == 'to_band' and self.corrupt and rng.random() < self.corrupt:
            f = self.changed(f, c)
        when = now
        if self.jitter:
            d = rng.uniform(0, self.jitter)
            if d:
                c['delayed'] += 1
            when = max(now + d, self.last_due[way])
        self.last_due[way] = when
        if self.reorder and rng.random() < self.reorder:
            c['reordered'] += 1
            when += REORDER_HOLD
        out = [(when, f)]
        if self.duplicate and rng.random() < self.duplicate:
            c['duplicated'] += 1
            out.append((when + 0.001, f))
        return out

    def changed(self, f, c):
        """F with one byte inside its IPv4 datagram changed, counted; any
        other frame as it is."""
        if len(f) < 34 or struct.unpack('!H', f[12:14])[0] != ETH_IPV4:
            return f
        tl = struct.unpack('!H', f[16:18])[0]
        end = min(len(f), 14 + tl) if tl >= 20 else len(f)
        i = self.rng.randrange(14, end)
        c['corrupted'] += 1
        return f[:i] + bytes([f[i] ^ self.rng.randrange(1, 256)]) + f[i + 1:]

    def injected(self, f):
        """The frame to inject toward the band after F, a frame the band
        sent, or None."""
        if not self.armed or self.counts['injected'] >= self.inject or len(f) < 14:
            return None
        t = INJECT_TYPES[self.counts['injected'] % len(INJECT_TYPES)]
        self.counts['injected'] += 1
        return f[6:12] + HOST_MAC + struct.pack('!H', t) + bytes(46)


# --------------------------------------------------------------------------
# The relay.

class Relay:
    def __init__(self, tap_fd, name, host, quux, report=None, err=sys.stderr, faults=None):
        self.tap_fd, self.name, self.host, self.quux = tap_fd, name, host, quux
        self.report, self.err = report, err
        self.faults = faults or Faults()
        self.due = []           # (when, n, way, frame): the frames the faults hold
        self.n = 0
        self.furthest = {}      # (way, source, destination, ports): the furthest sequence end seen
        self.line = '%s --ip-address %s/30 --ip-gateway %s' % (name, dotted(quux), dotted(host))
        self.counts = {'connections': 0,
                       'to_band': {'frames': 0, 'bytes': 0, 'types': {}, 'resent': 0},
                       'from_band': {'frames': 0, 'bytes': 0, 'types': {}, 'resent': 0},
                       'dropped_unconnected': 0, 'tap_write_failed': 0,
                       'bad_from_band': 0, 'bad': []}

    def say(self, what):
        print('%s: %s' % (PROGRAM, what), file=self.err, flush=True)

    def count(self, way, f):
        c = self.counts[way]
        c['frames'] += 1
        c['bytes'] += len(f)
        t = '0x%04x' % struct.unpack('!H', f[12:14])[0] if len(f) >= 14 else 'short'
        c['types'][t] = c['types'].get(t, 0) + 1
        # resends (section 9, T4: "resend counts are reported"): a TCP
        # segment with data, or a SYN or FIN, that ends at or before the
        # furthest sequence number already seen on its connection that way
        if t == '0x0800' and len(f) >= 34 and f[23] == PROTO_TCP:
            ihl = (f[14] & 15) * 4
            tl = struct.unpack('!H', f[16:18])[0]
            p = f[14 + ihl:14 + tl]
            if len(p) >= 20:
                seq = struct.unpack('!I', p[4:8])[0]
                flags = p[13]
                n = len(p) - (p[12] >> 4) * 4 + (1 if flags & 0x02 else 0) + (1 if flags & 0x01 else 0)
                if n > 0 and not flags & 0x04:
                    key = (way, f[26:30], f[30:34], p[0:4])
                    end = (seq + n) & 0xFFFFFFFF
                    far = self.furthest.get(key)
                    if far is not None and ((far - end) & 0xFFFFFFFF) < 0x80000000:
                        c['resent'] = c.get('resent', 0) + 1
                    else:
                        self.furthest[key] = end

    def write_report(self):
        if not self.report:
            return
        out = dict(self.counts, tap=self.name, line=self.line, faults=self.faults.counts)
        tmp = '%s.%d.tmp' % (self.report, os.getpid())
        with open(tmp, 'w') as f:
            json.dump(out, f, indent=1, sort_keys=True)
        os.replace(tmp, self.report)

    def hold(self, way, f):
        """F, arrived on WAY, through the faults: sent now or held."""
        for when, g in self.faults.plan(way, f, time.monotonic()):
            self.n += 1
            heapq.heappush(self.due, (when, self.n, way, g))

    def send_due(self, conn):
        """Every held frame whose time has come; the seconds to the next."""
        now = time.monotonic()
        while self.due and self.due[0][0] <= now:
            _, _, way, f = heapq.heappop(self.due)
            if way == 'to_band':
                conn.sendall(struct.pack('!I', len(f)) + f)
            else:
                self.write_tap(f)
        return max(0.0, self.due[0][0] - now) if self.due else None

    def to_band(self, conn, f):
        """An Ethernet frame from the tap, to the machine, through the faults."""
        self.count('to_band', f)
        self.hold('to_band', f)
        self.send_due(conn)

    def write_tap(self, f):
        try:
            os.write(self.tap_fd, f)
        except OSError as e:
            self.counts['tap_write_failed'] += 1
            self.say('%s: an Ethernet frame of %d bytes not taken: %s' % (self.name, len(f), e.strerror))

    def to_tap(self, f, warned):
        """An Ethernet frame the machine sent: checked, counted and written to
        the tap (T4's faults go here).  Returns whether the warning about the
        band's address has been given on this connection."""
        self.count('from_band', f)
        bad = check_frame(f)
        if bad:
            self.counts['bad_from_band'] += 1
            if len(self.counts['bad']) < BAD_SHOWN:
                self.counts['bad'].append({'n': self.counts['from_band']['frames'], 'why': bad,
                                           'frame': f[:64].hex()})
        s = sender(f)
        if not warned and s not in (None, 0, self.quux):
            self.say('warning: the band sends from %s, and %s\'s QUUX address is %s: run quux with %s;'
                     ' its Ethernet frames are moved all the same'
                     % (dotted(s), self.name, dotted(self.quux), self.line.split(' ', 1)[1]))
            warned = True
        self.hold('from_band', f)
        g = self.faults.injected(f)
        if g is not None:
            # injected after the faults, so that each is counted and none is lost
            self.n += 1
            heapq.heappush(self.due, (time.monotonic(), self.n, 'to_band', g))
        return warned

    def pump(self, conn):
        held, warned = b'', False
        self.due = []
        while True:
            ready, _, _ = select.select([self.tap_fd, conn], [], [], self.send_due(conn))
            if self.tap_fd in ready:
                self.to_band(conn, os.read(self.tap_fd, 65536))
            if conn in ready:
                got = conn.recv(65536)
                if not got:
                    return
                held += got
                while len(held) >= 4:
                    n = struct.unpack('!I', held[:4])[0]
                    if len(held) < 4 + n:
                        break
                    f, held = held[4:4 + n], held[4 + n:]
                    if n:
                        warned = self.to_tap(f, warned)
            self.send_due(conn)

    def serve(self, listener):
        while True:
            ready, _, _ = select.select([self.tap_fd, listener], [], [])
            if self.tap_fd in ready:
                os.read(self.tap_fd, 65536)
                self.counts['dropped_unconnected'] += 1
            if listener in ready:
                conn, _ = listener.accept()
                self.counts['connections'] += 1
                self.say('%s: a machine connected' % self.name)
                try:
                    self.pump(conn)
                except OSError as e:
                    self.say('%s: the connection failed: %s' % (self.name, e.strerror))
                finally:
                    conn.close()
                self.say('%s: the machine closed; waiting for the next' % self.name)
                self.write_report()


def listen(path):
    """A UNIX stream socket at PATH; a stale socket file is replaced."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        st = None
    if st is not None:
        if not stat.S_ISSOCK(st.st_mode):
            raise Refused('%s: exists and is not a socket' % path)
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            probe.connect(path)
        except ConnectionRefusedError:
            os.unlink(path)
        except OSError as e:
            raise Refused('%s: %s' % (path, e.strerror))
        else:
            raise Refused('%s: another program listens there' % path)
        finally:
            probe.close()
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.bind(path)
    except OSError as e:
        s.close()
        raise Refused('%s: %s' % (path, e.strerror))
    s.listen(1)
    return s


def usage(message=None):
    if message:
        print('%s: %s' % (PROGRAM, message), file=sys.stderr)
    print('usage: relay [--tap NAME[,NAME...]] [--report FILE] [--seed N] [--loss P] [--duplicate P]'
          ' [--reorder P] [--corrupt P] [--jitter MS] [--direction to-band|from-band|both] [--inject N]'
          ' [--arm-on-signal] PATH',
          file=sys.stderr)
    sys.exit(2)


FAULT_FLAGS = {'--seed': ('seed', int), '--loss': ('loss', float), '--duplicate': ('duplicate', float),
               '--reorder': ('reorder', float), '--corrupt': ('corrupt', float), '--jitter': ('jitter', float),
               '--direction': ('direction', str), '--inject': ('inject', int)}
FAULT_SWITCHES = {'--arm-on-signal': 'arm_on_signal'}


def parse(argv):
    names, report, path = None, None, None
    faults = {}
    args = list(argv)
    while args:
        a = args.pop(0)
        if a in ('-h', '--help'):
            print(__doc__.strip())
            sys.exit(0)
        elif a in FAULT_SWITCHES:
            faults[FAULT_SWITCHES[a]] = True
        elif a in FAULT_FLAGS:
            if not args:
                usage('%s wants a value' % a)
            key, kind = FAULT_FLAGS[a]
            try:
                faults[key] = kind(args.pop(0))
            except ValueError:
                usage('%s wants a number' % a)
            if key == 'direction' and faults[key] not in ('to-band', 'from-band', 'both'):
                usage('--direction is to-band, from-band or both')
            if key in ('loss', 'duplicate', 'reorder', 'corrupt') and not 0 <= faults[key] <= 100:
                usage('%s is a percentage, 0 to 100' % a)
            if key in ('jitter', 'inject') and faults[key] < 0:
                usage('%s is 0 or more' % a)
        elif a in ('--tap', '--report'):
            if not args or not args[0] or args[0].startswith('-'):
                usage('%s wants a value' % a)
            v = args.pop(0)
            if a == '--tap':
                names = v.split(',')
                if not all(names):
                    usage('--tap wants NAME[,NAME...]')
            else:
                report = v
        elif a.startswith('-'):
            usage('%s is not a flag of %s' % (a, PROGRAM))
        elif path is None:
            path = a
        else:
            usage('%s: one PATH only' % a)
    if path is None:
        usage('PATH wanted: the socket muir\'s --ethernet-socket names')
    return names, report, path, faults


def main(argv):
    names, report, path, faults = parse(argv)
    listener, relay = None, None

    def end(*_):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, end)
    try:
        name, fd, host, quux = take(names if names is not None else pool(), names is not None)
        relay = Relay(fd, name, host, quux, report, faults=Faults(**faults))
        signal.signal(signal.SIGUSR1, lambda *_: relay.write_report())
        signal.signal(signal.SIGUSR2, lambda *_: setattr(relay.faults, 'armed', True))
        listener = listen(path)
        print(relay.line, flush=True)
        relay.serve(listener)
    except Refused as e:
        print('%s: %s' % (PROGRAM, e), file=sys.stderr)
        return e.status
    except (KeyboardInterrupt, SystemExit):
        return 0
    finally:
        if relay is not None:
            relay.write_report()
        if listener is not None:
            listener.close()
            try:
                os.unlink(path)
            except OSError:
                pass
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
